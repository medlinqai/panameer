// Prisma schema for Panameer Digital Services
// Prisma 7 + @prisma/adapter-pg (driver adapter) — matches Medlinq.
//
// Supabase gives you two connection strings:
//   - DATABASE_URL : pooled connection (port 6543, ?pgbouncer=true) — runtime (via PrismaPg adapter)
//   - DIRECT_URL   : direct connection (port 5432) — migrations (see prisma.config.ts)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: connection URLs live in prisma.config.ts (migrations) and the
  // PrismaClient adapter (runtime). No `url`/`directUrl` here.
}

/// The lean system principal for auth. NextAuth's credentials provider
/// authenticates against this row (bcrypt password hash + account lockout).
/// Identity/profile data lives on the linked Person (1:1, optional) — this row
/// stays focused on authentication.
model User {
  id                    String    @id @default(uuid()) @db.Uuid
  /// ALWAYS stored normalized (trim + lowercase) via `normalizeEmail`. Backed
  /// by an additional UNIQUE INDEX on `lower(email)` that Prisma cannot express
  /// (functional index) — it is created by `npm run db:email-guard`, and
  /// `prisma db push` DROPS it, so re-run that script after every push.
  /// See brief_O / decisions-01.md.
  email                 String    @unique
  /// NULL for accounts created purely through OAuth (brief_Q) — they have no
  /// password and authenticate via the provider. `authorize` already refuses to
  /// compare against a null hash, so such an account cannot be password-guessed.
  password_hash         String?
  first_name            String?
  last_name             String?
  /// Profile picture URL supplied by an OAuth provider (brief_Q). Held on the
  /// User because it arrives at sign-in, before the Person backbone exists;
  /// it is copied onto `Person.photo_url` when that Person is created.
  image                 String?
  /// Which OAuth providers this account has signed in with (e.g. ["google"]).
  /// Record-keeping so support can see how an account authenticates; linking is
  /// keyed on the normalized email, not on this list.
  oauth_providers       String[]  @default([])
  role                  Role      @default(MEMBER)
  is_active             Boolean   @default(true)
  is_system_admin       Boolean   @default(false)
  locked                Boolean   @default(false)
  failed_login_attempts Int       @default(0)
  /// WHEN THE LOCK LIFTS BY ITSELF (`P1-J1.1-E252a`).
  ///
  /// `locked` alone was a ONE-WAY DOOR: `auth.ts` set it at
  /// `MAX_FAILED_LOGINS` and refused the account before comparing the
  /// password, and there is no reset, unlock or forgot-password route
  /// anywhere in `src/app`. Scott locked himself out of `admin@panameer.com`
  /// on 2026-08-30 and the only way back in was a hand-written script.
  ///
  /// Set alongside `locked` to now + the cooling-off window. `authorize`
  /// clears both once it has passed, so the account heals itself.
  /// ⚠ NULL WHILE `locked` IS TRUE MEANS AN INDEFINITE, ADMIN-ONLY LOCK —
  /// that is deliberate, so an admin can still hard-lock an account.
  locked_until          DateTime?
  /// When the user's email was verified (null = unverified). Set by the
  /// tokenized verify link during onboarding (brief_E).
  email_verified        DateTime?
  /// When the user accepted the Terms of Service (buyer signup, brief_G).
  tos_accepted_at       DateTime?
  /// WHICH user terms they accepted (brief_company_model WS6). We recorded the
  /// timestamp and not the version, so "did this person agree to the current
  /// terms?" was unanswerable — which is the whole question a ToS record has to
  /// answer when the document changes.
  tos_version           String?
  last_login            DateTime?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  /// The person this login belongs to (nullable: a User need not have a Person
  /// yet, e.g. the system admin before onboarding). The FK lives on Person.
  assessments        Assessment[]
  person             Person?
  verificationTokens VerificationToken[]

  /// Learn (brief_learn_v1 WS0). Keyed to the USER, not a profile: every role
  /// learns, and enrolment is the convert-to-account trigger (WS4).
  learnEnrollments  LearnEnrollment[]
  lessonProgress    LessonProgress[]
  learnTestAttempts LearnTestAttempt[]

  /// J2.4 WS-H (E018) — two-step verification, keyed to the LOGIN rather than
  /// to a profile: it protects the account, and one login can hold several
  /// memberships.
  twoFactor      TwoFactorSetting?
  /**
   * ⚠ THE CREDENTIALS THIS PERSON OWNS (`P1-J3-E019`). Not the seller profile's —
   * a learner with no `ProviderProfile` has these too, which is the whole point
   * of the column.
   */
  certifications Certification[]

  @@map("users")
  /// `P1-ALL-E372` — both directions, because a colleague request has a sender
  /// and a recipient and both need to see it.
  connectionsSent     Connection[] @relation("ConnectionsSent")
  connectionsReceived Connection[] @relation("ConnectionsReceived")
  /// ⚠ `P1-ALL-E379`. Named relations because two fields point at the same
  /// model — Prisma cannot disambiguate them otherwise.
  messagesSent     Message[] @relation("MessagesSent")
  messagesReceived Message[] @relation("MessagesReceived")
}

enum Role {
  ADMIN
  MEMBER
}

/// A single-use, expiring verification token (email verification for now; the
/// type enum leaves room for phone/password-reset later). We store only the
/// SHA-256 hash of the token — the raw token lives only in the emailed link.
/// Minimal by design (brief_E allowed addition).
model VerificationToken {
  id          String                @id @default(uuid()) @db.Uuid
  user_id     String                @db.Uuid
  token_hash  String                @unique
  type        VerificationTokenType @default(EMAIL)
  expires_at  DateTime
  consumed_at DateTime?
  created_at  DateTime              @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("verification_tokens")
}

enum VerificationTokenType {
  EMAIL
  /// A single-use, short-lived token that establishes a SESSION (brief_S /
  /// E022). Minted only after an email-verification token has been validated,
  /// so clicking the link in the email signs the provider in and drops them
  /// straight into onboarding instead of a login screen.
  SIGNIN
}

// ---------------------------------------------------------------------------
// Org & identity backbone (Phase 1)
//
//   PAccount → Company → Site → Address           (org hierarchy)
//                     ↘ Person → User             (people; login is optional)
//
// PAccount is the tenancy fence: private business queries filter by
// p_account_id (see src/lib/access.ts `scopedToPAccount`). Published profiles
// and posted work requests are shared marketplace surfaces and are explicitly
// NOT scoped — that boundary is drawn in access.ts, not here.
// ---------------------------------------------------------------------------

/// The tenant. A buyer org, a provider entity, or both. Subscription/billing
/// will hang off this row later.
model PAccount {
  id         String         @id @default(uuid()) @db.Uuid
  kind       PAccountKind
  name       String
  status     PAccountStatus @default(ACTIVE)
  created_at DateTime       @default(now())
  updated_at DateTime       @updatedAt

  companies    Company[]
  workRequests WorkRequest[]

  @@map("p_accounts")
}

enum PAccountKind {
  BUYER
  PROVIDER
  BOTH
}

enum PAccountStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

/// A company within a P-Account. Carries name, vertical, and branding.
/// Legal form of the entity (brief_company_model WS1).
///
/// LOAD-BEARING, not descriptive: it decides the TIN format collected at the
/// payout gate (SSN/ITIN for a sole proprietor, EIN for everyone else) and
/// whether Panameer must 1099-report the payments — sole prop, partnership and
/// LLC are reportable; C-Corp and S-Corp generally are not. Neither the TIN nor
/// the tax form is collected here: both belong to the money gate.
enum TaxType {
  C_CORP
  S_CORP
  LLC
  PARTNERSHIP
  /// A sole proprietor is a COMPANY OF ONE, not a separate kind of user. There
  /// is deliberately no "individual" path anywhere in the product.
  SOLE_PROP_INDIVIDUAL
  NONPROFIT
}

/// Company Admin is the DEFINER — the person who created the company and the
/// only one who approves joiners at v1. Additive: the same person can be admin
/// of one company and a plain member of another.
enum MembershipRole {
  MEMBER
  ADMIN
}

enum MembershipStatus {
  PENDING
  APPROVED
  REJECTED
}

model Company {
  id           String   @id @default(uuid()) @db.Uuid
  p_account_id String   @db.Uuid
  /// Display name. At v1 this and `legal_name` are the same string — the define
  /// step writes both — but they are kept apart because they diverge the moment
  /// a company trades under a name that isn't on its tax filing, and the
  /// contract has to carry the legal one.
  name         String
  legal_name   String?
  tax_type     TaxType?
  /// Tax registration id (EIN · VAT/company number · SSN/ITIN). DEFERRED to the
  /// money gate on purpose — it lives on the W-9/W-8 and is only needed when
  /// funds move, so asking for it at signup buys nothing but drop-off. The
  /// trade-off is that dedup leans on name + domain + admin approval rather
  /// than a hard tax key (the Upwork pattern).
  tin          String?
  /// Bare domain ("acme.com"), set from the definer's work email. A joiner
  /// whose own email domain matches it is auto-approved (v1 = exact,
  /// case-insensitive string match; free-mail domains never match).
  email_domain String?

  /// ── STATE OF FILING (`P1-J1.1-E282`) ──────────────────────────────────────
  ///
  /// SCOTT, 2026-08-31: *"Every state has a Secretary of State website. They list
  /// their corporations under a corporate search."* The user gives the company
  /// name and the state it was filed in; Panameer looks the rest up.
  ///
  /// ⚠ THE FULL STATE NAME, NOT A TWO-LETTER CODE — matching `country`, which
  /// stores `"United States"` and not `"US"` (`E260`).
  /// ⚠⚠ AND THAT DISAGREES WITH `Address.state`, WHICH HOLDS CODES. Measured on
  /// the live rows: 41 of 44 non-null `Address.state` values are two-letter codes
  /// (`FL`, `IL`, `TX`, `CA`, `MO`, `NY`), plus two outliers (`CABA`,
  /// `new york`). REPORTED AT `E282` rather than silently reconciled.
  /// ⚠ THEY DO NOT NEED TO AGREE: this is the JURISDICTION A COMPANY WAS FILED
  /// IN, which is not the state of a mailing address — `Pfizer Inc.` is filed in
  /// Delaware and has a New York process address. Nothing joins the two.
  ///
  /// ⚠ US ONLY, nullable, and it back-fills nothing — existing companies predate
  /// it. A failed or absent lookup NEVER blocks onboarding (decision 5).
  state_of_filing String?
  vertical     String?
  website      String?
  /// JURISDICTION — Scott, 2026-08-30: *"Jurisdiction is just country. do
  /// this."* (`P1-J1.1-E260`). Captured on the requester wizard's company
  /// step and stored as the FULL COUNTRY NAME from `COUNTRIES` in
  /// `lib/countries.ts` ("United States"), which is the shape every other
  /// address field on this site already stores — NOT an ISO alpha-2 code.
  /// ⚠ NULLABLE: 3 companies predate this column and cannot be back-filled
  /// without asking somebody. It is not a gate on anything today.
  country      String?
  logo_url     String?

  /// TENANT THEME (E204) — a brand HUE and a recipe id, never a set of hexes.
  ///
  /// Storing the recipe rather than the resolved colours is what keeps the
  /// quality bar in code: every surface is derived from these two values by
  /// `resolveTheme`, so a design change to a recipe reaches every tenant that
  /// picked it, and no tenant can persist a combination that fails contrast.
  /// Null on both = the Panameer default; un-themed companies are unchanged.
  brand_hue    String?
  theme_recipe String?

  /// COMPANY ToS — the entity's agreement to do business with Panameer,
  /// accepted by its admin on the company's behalf. Distinct from the User ToS
  /// each person accepts at signup, and it gates the company's ability to
  /// transact. Re-accepted when the version bumps.
  company_tos_accepted_by String?   @db.Uuid
  company_tos_accepted_at DateTime?
  company_tos_version     String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  pAccount    PAccount            @relation(fields: [p_account_id], references: [id], onDelete: Cascade)
  sites       Site[]
  people      Person[]
  memberships CompanyMembership[]
  /// Assessments ATTRIBUTED to this company (brief_assessment_instance_model).
  /// Nullable on the other side and it stays that way — an assessment filled in
  /// before any account exists has no company, and that is the top of the funnel.
  assessments Assessment[]

  @@index([p_account_id])
  @@index([email_domain])
  @@map("companies")
}

/// A person's binding to a company — THE IDENTITY PRIMITIVE.
///
/// `Person.company_id` says where a person currently sits; this says whether
/// that binding is APPROVED and what it lets them do. No approved membership on
/// a company with an accepted company ToS → the person cannot transact
/// (Panameer staff excepted). One row per person per company, so re-requesting
/// updates the existing decision rather than stacking requests.
model CompanyMembership {
  id                      String           @id @default(uuid()) @db.Uuid
  person_id               String           @db.Uuid
  company_id              String           @db.Uuid
  role                    MembershipRole   @default(MEMBER)
  status                  MembershipStatus @default(PENDING)
  /// "I am authorized to represent this entity." Recorded per membership
  /// because it is a statement by the PERSON about a specific company.
  attestation_accepted_at DateTime?
  /// Set when an admin approves or rejects; null while pending.
  decided_at              DateTime?
  decided_by_person_id    String?          @db.Uuid
  /// How the approval happened — an audited domain auto-approval reads very
  /// differently from a human decision when someone asks later.
  auto_approved           Boolean          @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  person  Person  @relation(fields: [person_id], references: [id], onDelete: Cascade)
  company Company @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@unique([person_id, company_id])
  @@index([company_id, status])
  @@map("company_memberships")
}

/// A physical/operational location of a Company.
model Site {
  id                String   @id @default(uuid()) @db.Uuid
  company_id        String   @db.Uuid
  name              String
  open_for_business Boolean  @default(true)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  company            Company            @relation(fields: [company_id], references: [id], onDelete: Cascade)
  addresses          Address[]
  people             Person[]
  /// Requesters whose engagement DELIVER-TO is this site (brief_requester_onboarding).
  requesterWorkSites RequesterProfile[] @relation("RequesterWorkSite")

  @@index([company_id])
  @@map("sites")
}

/// A postal address belonging to a Site.
model Address {
  id          String   @id @default(uuid()) @db.Uuid
  site_id     String   @db.Uuid
  line1       String
  line2       String?
  city        String?
  state       String?
  postal_code String?
  country     String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  site Site @relation(fields: [site_id], references: [id], onDelete: Cascade)

  @@index([site_id])
  @@map("addresses")
}

/// A human within a Company (optionally pinned to a Site), optionally linked
/// 1:1 to a User login. The actor-role flags describe what this person DOES in
/// the marketplace (distinct from the skill role-types in Brief B).
model Person {
  id                String       @id @default(uuid()) @db.Uuid
  company_id        String       @db.Uuid
  site_id           String?      @db.Uuid
  user_id           String?      @unique @db.Uuid
  first_name        String
  last_name         String
  title             String?
  phone             String?
  /// When the phone number above passed SMS verification (brief_P / E019).
  /// Cleared whenever `phone` changes, so it always describes the CURRENT number.
  phone_verified_at DateTime?
  /// J2.4 WS-H (E014) — the person's own IANA zone, for the Location section
  /// and for scheduling later. Null means "use the browser's", which is what
  /// every surface did before there was anywhere to record a preference.
  time_zone         String?
  photo_url         String?
  status            PersonStatus @default(ACTIVE)

  // Actor-role flags — what this person does (a person can wear several hats).
  // "Service Buyer" is the actor who creates work requests (the ERP Requester)
  // and is deliberately NOT named `is_buyer`: "Buyer" is an operational SKILL in
  // the taxonomy (an ERP procurement role), never an actor. The is_service_*
  // prefix keeps the two from ever being conflated.
  is_service_buyer       Boolean @default(false)
  is_service_provider    Boolean @default(false)
  is_service_coordinator Boolean @default(false)
  is_support             Boolean @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  company             Company             @relation(fields: [company_id], references: [id], onDelete: Cascade)
  site                Site?               @relation(fields: [site_id], references: [id], onDelete: SetNull)
  user                User?               @relation(fields: [user_id], references: [id], onDelete: SetNull)
  // The provider profile this Person OWNS (1:1).
  providerProfile     ProviderProfile?    @relation("ProfileOwner")
  buyerProfile        BuyerProfile?
  requesterProfile    RequesterProfile?
  companyMemberships  CompanyMembership[]
  // As a COORDINATOR: the provider profiles this Person represents, and the
  // invites they've sent (brief_I).
  repProviderProfiles ProviderProfile[]   @relation("CoordinatorProviders")
  coordinatorInvites  CoordinatorInvite[] @relation("CoordinatorInvitesSent")
  // As a BUYER: the work requests this Person created (brief_L).
  workRequests        WorkRequest[]
  // SMS verification challenges for this person's phone (brief_P).
  phoneVerifications  PhoneVerification[]

  /// Learn (brief_learn_v1 WS0) — an expert fronts paths and lessons. A Person,
  /// not a ProviderProfile, so an instructor needn't be a marketplace provider.
  learnPaths   LearningPath[] @relation("LearnExpertPaths")
  learnLessons Lesson[]       @relation("LearnExpertLessons")

  // J2.4 WS-H — the payee-side records. On Person, not ProviderProfile: one
  // login can hold several memberships, and a bank account or a tax form
  // belongs to the human being paid, not to one of the hats they wear.
  billingMethods           BillingMethod[]
  payoutMethods            PayoutMethod[]
  // WS2-C — forum authorship. On Person, like every other social surface here.
  forumThreads             ForumThread[]            @relation("ForumThreadAuthor")
  forumPosts               ForumPost[]              @relation("ForumPostAuthor")
  forumPostsMarkedHelpful  ForumPost[]              @relation("ForumPostHelpfulMarker")
  /// Assessments this person REVIEWED and published — see LearnAssessment.status.
  learnAssessmentsReviewed LearnAssessment[]        @relation("LearnAssessmentReviewer")
  taxProfile               TaxProfile?
  identityVerification     IdentityVerification?
  notificationPrefs        NotificationPreference[]
  notifications            Notification[]

  @@index([company_id])
  @@index([site_id])
  @@map("people")
}

enum PersonStatus {
  ACTIVE
  INACTIVE
}

// ---------------------------------------------------------------------------
// Service-catalog taxonomy (Phase 1, brief_B)
//
//   ServiceCatalog (ERP, …future ERPs)
//     └─ Pillar (ERP/SCM/HCM/CX/EPM/NA)
//          └─ Offering
//               └─ Application (+ app_group)
//
//   RoleType (global) ─┬─ Skill (normalized Panameer skill)
//                      └─ SkillTag (incoming job-req term → normalized skill)
//
//   Region · EngagementType · NonOracleApplication  (flat lookups)
//
// This is REFERENCE / LOOKUP data — global shared marketplace vocabulary, NOT
// PAccount-scoped. Providers tag Skills, work requests target the catalog, and
// matching runs over this vocabulary (later briefs). Seeded from
// prisma/seed-data/erp-catalog.json (parsed from Scott's Work Data File).
// ---------------------------------------------------------------------------

/// A service catalog. ERP is the first; the model is built Oracle-based but
/// meant to hold future catalogs for other ERPs.
model ServiceCatalog {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  pillars         Pillar[]
  skills          Skill[]
  tags            SkillTag[]
  specializations Specialization[]

  @@map("service_catalogs")
}

/// Global classification of what a person DOES on an engagement (Functional /
/// Technical / Techno-Functional / Project / Operational). Not catalog-scoped —
/// role types are shared across every catalog.
model RoleType {
  id         String   @id @default(uuid()) @db.Uuid
  code       String   @unique
  name       String
  display    String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  /// Display order for the Role → Domain picker (brief_R). Lower sorts first,
  /// keeping the ERP-heavy Application-Specific role at the top (E013).
  sort_order Int @default(100)

  /// Projects classified with this role type (brief_project_model_v2).
  projects     Project[]
  /// Jobs whose DERIVED role is this one (WS-1) — distinct from `projects`,
  /// which is a provider's classification of a single engagement.
  employerJobs Employer[] @relation("EmployerJobRole")

  skills           Skill[]
  tags             SkillTag[]
  workRequests     WorkRequest[]
  providerProfiles ProviderProfile[]
  /// WS2 — providers who work in this role, including as a secondary one.
  profileRoles     ProviderProfileRole[]
  packages         Package[]

  @@map("role_types")
}

/// A top-level product pillar within a catalog (ERP, SCM, HCM, CX, EPM, NA).
model Pillar {
  id         String   @id @default(uuid()) @db.Uuid
  catalog_id String   @db.Uuid
  code       String
  name       String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  /// Display order for the category picker (brief_P / E013). Lower sorts first,
  /// so ERP is pinned above AI and everything else. Ties break on name.
  sort_order Int @default(100)

  catalog          ServiceCatalog    @relation(fields: [catalog_id], references: [id], onDelete: Cascade)
  offerings        Offering[]
  skills           Skill[]
  tags             SkillTag[]
  providerProfiles ProviderProfile[]
  workRequests     WorkRequest[]

  @@unique([catalog_id, code])
  @@map("pillars")
}

/// An offering within a pillar (e.g. ERP → Procurement).
model Offering {
  id         String   @id @default(uuid()) @db.Uuid
  pillar_id  String   @db.Uuid
  name       String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  pillar       Pillar        @relation(fields: [pillar_id], references: [id], onDelete: Cascade)
  applications Application[]

  @@unique([pillar_id, name])
  @@index([pillar_id])
  @@map("offerings")
}

/// An application within an offering (e.g. Procurement → Requisitions). Carries
/// its App Group as a field (the source data pairs one app group per app).
model Application {
  id          String   @id @default(uuid()) @db.Uuid
  /// Null for a PROVIDER-ADDED tool (brief_project_model_v2): a custom entry
  /// belongs to no ERP offering, and leaving it out of the tree is what keeps
  /// it from polluting the Role → Domain → Skill pickers, which walk
  /// offerings. Baseline catalog rows always carry one.
  offering_id String?  @db.Uuid
  name        String
  app_group   String?
  /// Added on the fly by a provider, and therefore FLAGGED FOR ADMIN REVIEW so
  /// recurring entries can be promoted to baseline later (the same contract as
  /// `Specialization.is_custom`). Never retired by the seed.
  is_custom   Boolean  @default(false)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  offering Offering?            @relation(fields: [offering_id], references: [id], onDelete: Cascade)
  skills   Skill[]
  projects ProjectApplication[]

  @@unique([offering_id, name])
  @@index([offering_id])
  @@index([is_custom])
  @@map("applications")
}

/// A normalized Panameer skill — the matchable vocabulary providers tag and
/// work requests target. Sourced from the application hierarchy (functional
/// skills, which set pillar + application), the per-role-type skill lists, and
/// the freelancer mapping's normalized `panameerSkill` names. Deduped by
/// (catalog, name); functional (APPLICATION) sources win the role type.
model Skill {
  id             String   @id @default(uuid()) @db.Uuid
  catalog_id     String   @db.Uuid
  role_type_id   String   @db.Uuid
  pillar_id      String?  @db.Uuid
  application_id String?  @db.Uuid
  name           String
  image_url      String?
  /// Added by a provider on the fly (brief_S / E031) rather than coming from
  /// the authoritative Service Catalog. The seed's retirement pass SKIPS these
  /// — otherwise re-seeding would silently delete skills providers had entered
  /// and selected.
  is_custom      Boolean  @default(false)
  /// THE PARSER'S CONTROLLED VOCABULARY for this skill (v5 catalog): legacy
  /// names, acronyms and product renames — "GL", "iProcurement (POR)", "Fixed
  /// Assets". A résumé says "AP", the catalog says "Payables"; this is the join.
  ///
  /// VENDOR ROLES ONLY, and that is load-bearing rather than an oversight.
  /// Operations/Project skills are capability domains — analytical vocabulary
  /// nobody writes on a CV — so they carry none, which is exactly what keeps
  /// role derivation deterministic in the six places where an App module and an
  /// Ops capability share a name ("Project Costing", "Grants Management").
  aliases        String[]
  /// Tech Category for Technology-Specific tools ("Development & Extensibility",
  /// "Integration & APIs"). Null for application modules and agnostic roles.
  category       String?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  catalog           ServiceCatalog           @relation(fields: [catalog_id], references: [id], onDelete: Cascade)
  roleType          RoleType                 @relation(fields: [role_type_id], references: [id])
  pillar            Pillar?                  @relation(fields: [pillar_id], references: [id], onDelete: SetNull)
  application       Application?             @relation(fields: [application_id], references: [id], onDelete: SetNull)
  providerSkills    ProviderSkill[]
  workRequestSkills WorkRequestSkill[]
  packageSkills     PackageSkill[]
  bridges           CapabilityModuleBridge[]
  jobSkills         JobSkill[]

  /// A Skill belongs to a (Role, Domain) PAIR — brief_R, from the authoritative
  /// Service Catalog. The old `(catalog_id, name)` key was wrong for that shape:
  /// "Project Manager" legitimately exists under BOTH Project-Specific/Project
  /// Execution and Operations-Specific/Project Portfolio Management, and a
  /// name-only key silently collapsed them into one row.
  @@unique([catalog_id, role_type_id, pillar_id, name])
  @@index([role_type_id])
  @@index([pillar_id])
  @@map("skills")
}

/// WHICH SOFTWARE SUITE a job was worked on (brief_per_job_skill_model WS-1).
///
/// An enum rather than a free string because it is the axis attribution turns
/// on: "Oracle Cloud", "Oracle Fusion", "Fusion" and "OCloud" typed into a text
/// box are four suites to a database and one to a human, and a weighted rollup
/// grouped by that column would be quietly wrong.
///
/// The values mirror the v5 catalog's vendor Pillar names one-for-one —
/// `src/lib/suite.ts` holds the single mapping between the two and the labels
/// the UI shows. Adding a suite means: a value here, a row in that map, and a
/// column in the catalog spreadsheet.
///
/// CROSS_VENDOR is the Technology-Specific "Cross-Vendor (Platform-Neutral)"
/// pillar — SQL, REST, Git: real skills that belong to no suite. It is NOT the
/// same as null, which means "we do not know yet" and is what drives the
/// needs-suite prompt.
enum SoftwareSuite {
  ORACLE_FUSION_CLOUD
  ORACLE_EBS
  PEOPLESOFT
  WORKDAY
  SALESFORCE
  CROSS_VENDOR
}

/// Where a row in the derived rollup came from (WS-2).
enum ProviderSkillSource {
  /// Computed from JobSkill rows. The default and the only trustworthy path.
  DERIVED
  /// The escape hatch: claimed on the profile with no job behind it. Carries a
  /// deliberately low weight and is flagged in the UI — a fresh consultant's
  /// honest claim and a padded profile look identical from here, so neither is
  /// allowed to read as depth.
  SELF_ADDED
}

/// A CAPABILITY DOMAIN — the buyer's vocabulary (brief_per_job_skill_model WS-0).
///
/// Nine business processes decompose into ~85 capability domains
/// ("Requisitioning & Demand Management"). This is what a buyer who does not
/// know or care which system they are on selects, and it is the vocabulary the
/// buyer assessment will speak later.
///
/// A LOOKUP TABLE, not part of the provider taxonomy. Deliberately NOT a Skill:
/// providers claim vendor modules, buyers ask for capabilities, and
/// `CapabilityModuleBridge` is the translation. Collapsing the two vocabularies
/// into one table is what forces a buyer to learn Oracle's product names.
model CapabilityDomain {
  id         String   @id @default(uuid()) @db.Uuid
  /// The business process this belongs to — "Procure-to-Pay", "Hire-to-Retire".
  process    String
  name       String
  /**
   * ⚠ THE STABLE JOIN KEY (E004). JOIN ON THIS, NEVER ON `name`.
   * Three files named the same domains three ways — the assessment bank
   * (`questions-p2p.ts`), the list advertised on `/` (`capability-domains.ts`) and this
   * table, seeded from `Service Catalog.xlsx`. Names differ BY DESIGN: the deck, the
   * marketing page and the catalog each phrase them for their own reader, and they changed
   * twice in one week. Joining on a display string is what produced that defect.
   * ⚠ THE BANK'S KEY WINS. `questions-p2p.ts` is what scores a respondent and stored
   * answers already reference it, so changing it would orphan real data; the other two cost
   * nothing to align.
   * ⚠ NULLABLE ON PURPOSE, and that is a statement not a gap. Only Procure-to-Pay has an
   * authored assessment bank, so only its ten rows have keys. Inventing keys for the other
   * ~75 domains would bake in names no bank scores — the next process's brief assigns its
   * own keys when its bank is written. Postgres allows many NULLs under a unique index, so
   * `@@unique([process, key])` still binds every key that exists.
   */
  key        String?
  sort_order Int      @default(100)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  bridges  CapabilityModuleBridge[]
  packages PackageCapabilityDomain[]

  @@unique([process, name])
  /// One key per process — the join the value model depends on.
  @@unique([process, key])
  @@index([process])
  @@index([key])
  @@map("capability_domains")
}

/// CAPABILITY <-> MODULE BRIDGE — "who delivers this capability on that suite".
///
/// One row per (capability, suite): Requisitioning is `Self-Service Procurement`
/// on Oracle Fusion, `iProcurement (POR)` on EBS, `eProcurement` on PeopleSoft.
///
/// This is what lets a capability-only Work Request match a provider who has
/// only ever listed vendor modules (WS-5). Without it the buyer side and the
/// provider side share no vocabulary at all and "Any suite" cannot be answered.
///
/// `skill_id` is resolved at seed time where the named module exists in the
/// catalog and left null where it does not — the bridge is a starter sheet and
/// names drift, and a dangling FK would fail the whole seed over one rename.
/// `module_name` always holds what the sheet said, so an unresolved row is
/// visible and fixable rather than silently absent.
model CapabilityModuleBridge {
  id            String   @id @default(uuid()) @db.Uuid
  capability_id String   @db.Uuid
  /// Suite as named in the catalog — matches `Pillar.name` for a vendor role.
  suite         String
  module_name   String
  skill_id      String?  @db.Uuid
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  capability CapabilityDomain @relation(fields: [capability_id], references: [id], onDelete: Cascade)
  skill      Skill?           @relation(fields: [skill_id], references: [id], onDelete: SetNull)

  @@unique([capability_id, suite, module_name])
  @@index([skill_id])
  @@index([suite])
  @@map("capability_module_bridge")
}

/// An incoming job-requisition skill term ("tag"), grouped by role type, that
/// resolves to a normalized Skill. This is the loadable home for the JSON's
/// `freelancerMapping`: `panameer_skill` is the normalized target name and
/// `selling_agent` is the RAW coordinator name from the Work Data File —
/// preserved as an annotation, deliberately NOT yet linked to a Person. The
/// coordinator-coverage join is wired in the profiles brief.
model SkillTag {
  id             String   @id @default(uuid()) @db.Uuid
  catalog_id     String   @db.Uuid
  role_type_id   String   @db.Uuid
  pillar_id      String?  @db.Uuid
  name           String
  panameer_skill String?
  selling_agent  String?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  catalog  ServiceCatalog @relation(fields: [catalog_id], references: [id], onDelete: Cascade)
  roleType RoleType       @relation(fields: [role_type_id], references: [id])
  pillar   Pillar?        @relation(fields: [pillar_id], references: [id], onDelete: SetNull)

  @@unique([catalog_id, role_type_id, name])
  @@index([role_type_id])
  @@map("skill_tags")
}

/// A world region for provider/buyer location + coverage.
model Region {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  providerProfiles ProviderProfile[]
  workRequests     WorkRequest[]

  @@map("regions")
}

/// How an engagement is structured (Contract/Corp-to-Corp, Fulltime, Temporary).
model EngagementType {
  id         String   @id @default(uuid()) @db.Uuid
  code       String   @unique
  name       String
  detail     String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("engagement_types")
}

/// A non-Oracle application a provider may have experience with (PeopleSoft,
/// SAP, Ariba, Coupa, …). Flat lookup for now.
model NonOracleApplication {
  id         String   @id @default(uuid()) @db.Uuid
  name       String   @unique
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("non_oracle_applications")
}

// ---------------------------------------------------------------------------
// Profiles (Phase 1, brief_C)
//
//   Person (is_service_provider) ──1:1── ProviderProfile
//                                          ├─ ProviderSkill → Skill (taxonomy)
//                                          ├─ WorkExperience → ExperienceProject
//                                          ├─ Education · Language · Certification
//                                          └─ Region (optional)
//   Person (is_service_buyer)    ──1:1── BuyerProfile
//
// A ProviderProfile is a PUBLIC marketplace surface when it is visible (see
// GET /api/providers/[id]) — not PAccount-scoped. Rates are stored in integer
// cents to avoid float drift; money is never a Float.
// ---------------------------------------------------------------------------

/// A provider's marketplace profile (1:1 with a Person that is a service
/// provider). Marketplace-visible ⇔ status = ACTIVE AND completeness >= 80 AND
/// paused_at IS NULL (brief_K). Validation is a separate merit track that does
/// NOT affect base visibility.
model ProviderProfile {
  id                      String             @id @default(uuid()) @db.Uuid
  person_id               String             @unique @db.Uuid
  region_id               String?            @db.Uuid
  headline                String
  overview                String?
  // PJv2 WS7 — `experience_level` and `goal` are GONE.
  //   experience_level: self-graded, and now DERIVED from work-history spans
  //                     (E068 / lib/experience.ts).
  //   goal:             asked, stored, and never used for anything. E067 wanted
  //                     it to gate visibility; the decision was the opposite —
  //                     visibility is completeness + identity, not intent.
  work_types              WorkType[]
  onsite_rate_cents       Int?
  remote_rate_cents       Int?
  /// The single hourly rate the client sees (brief_P / E018). Integer cents.
  /// `onsite_/remote_rate_cents` predate this (brief_E) and stay for Settings.
  ///
  /// SUPERSEDED for display by the RANGE below (PJv2 WS0 / E078c) but kept
  /// written and in sync (= `rate_min_cents`), because the publish gate and the
  /// completeness score both read it. Removing it is a separate migration, not
  /// something to smuggle into a layout brief.
  hourly_rate_cents       Int?
  /// The rate RANGE the provider advertises (PJv2 WS0 / E078c). A single number
  /// forced a consultant to pick one figure for work that genuinely varies by
  /// engagement; a range is what they actually quote. Integer cents, and the
  /// "You'll get" service-fee figure is computed on both ends.
  ///
  /// Migration set min = max = the old single rate, so nobody's published rate
  /// changed meaning on deploy.
  rate_min_cents          Int?
  rate_max_cents          Int?
  /// Platform service fee as BASIS POINTS (1000 = 10%). Integer so the fee and
  /// the "You'll get" figure are computed without ever touching a float.
  service_fee_bps         Int                @default(1000)
  currency                String             @default("USD")
  /// The field chosen at the catalog step: a (Role, Domain) PAIR, since the
  /// authoritative catalog is Role → Domain → Skill and the same domain name
  /// appears under more than one role (brief_R). `pillar_id` is the DOMAIN;
  /// `role_type_id` is the ROLE. Skills at the next step filter on both.
  pillar_id               String?            @db.Uuid
  role_type_id            String?            @db.Uuid
  /// How the provider sells; RECRUITER forks them to the Coordinator role
  /// (brief_P / E009).
  work_method             WorkMethod?
  /// Which profile-creation path was taken (brief_P / E012).
  profile_method          ProfileMethod?
  /// Collected on the finish page (brief_P / E019).
  date_of_birth           DateTime?
  /// When the provider pressed "Publish Profile" and finished onboarding
  /// (brief_P / E019). This is a COMPLETION marker, NOT a visibility flag —
  /// brief_K's derived completeness gate remains the only visibility rule.
  onboarding_completed_at DateTime?
  rating                  Decimal?           @db.Decimal(3, 2)
  id_badge                String?
  // Account lifecycle (brief_K): PENDING on sign-up → ACTIVE on email verify.
  status                  ProviderStatus     @default(PENDING)
  // Merit-based Validation track (brief_K) — separate from visibility. Provider
  // requests it; an admin grants on merit. Never purchasable.
  validation_status       ValidationStatus   @default(NOT_REQUESTED)
  validation_requested_at DateTime?
  validated_at            DateTime?
  // Visibility is COMPLETENESS-gated, not approval-gated (brief_K, supersedes
  // brief_E/H). Marketplace-visible ⇔ status=ACTIVE AND completeness>=80 AND
  // paused_at IS NULL. No publish flag/button — visibility is derived.
  completeness            Int                @default(0)
  paused_at               DateTime?
  // Minimal preferences store (brief_H). Notification opt-ins; expand later.
  notify_email            Boolean            @default(true)
  notify_product_updates  Boolean            @default(false)
  /// J2.4 WS-B (E008) — the persona menu's "Online for messages" toggle.
  ///
  /// A REAL COLUMN, not local state, because it is a claim made to other
  /// people: a buyer deciding whether to open a conversation is the audience,
  /// so it has to survive the tab that set it. Deliberately NOT `paused_at` —
  /// that is the marketplace-visibility pause and this brief must leave the
  /// completeness/visibility gate alone. Someone can be listed and not
  /// currently at their desk; conflating the two would hide a profile because
  /// its owner went to lunch.
  available_for_messages  Boolean            @default(true)
  /// ---- J2.4 WS-H Profile Settings (E015) ----------------------------------
  /// What KIND of work this provider wants. A preference shown to buyers and
  /// used for matching later; not a filter on what they may bid for.
  project_preference      ProjectPreference?
  /// Plus-gated: hide earned-amount history from buyers browsing the profile.
  /// Stored for everyone — a provider who lapses from Plus should not silently
  /// have their privacy choice discarded and their history re-exposed.
  earnings_private        Boolean            @default(false)
  /// Explicit OPT-IN (never a default) to Panameer using this profile's content
  /// to improve its models. Off unless the person turned it on.
  ai_training_opt_in      Boolean            @default(false)
  /// Linked developer accounts (E015). Usernames, not OAuth — these are shown
  /// on the profile as evidence, and asking for repo scopes to display a
  /// handle would be a wildly disproportionate permission grab.
  linked_github           String?
  linked_stackoverflow    String?
  /// brief_sp_dashboard WS-C — when this provider last opened their dashboard.
  ///
  /// Drives the "New Matches" freshness card: work posted after this timestamp
  /// is new to them. Stamped on dashboard render rather than on login, because
  /// the question the card answers is "what has appeared since I last LOOKED",
  /// and a login that lands somewhere else has not looked.
  ///
  /// Null means never visited, and everything posted counts as new — which is
  /// correct: it is all new to them.
  dashboard_seen_at       DateTime?
  // The coordinator Person who represents this provider (brief_I). Nullable —
  // most providers are independent. Set only via the provider's own authenticated
  // acceptance of a coordinator invite.
  coordinator_person_id   String?            @db.Uuid
  created_at              DateTime           @default(now())
  updated_at              DateTime           @updatedAt

  person            Person                          @relation("ProfileOwner", fields: [person_id], references: [id], onDelete: Cascade)
  coordinator       Person?                         @relation("CoordinatorProviders", fields: [coordinator_person_id], references: [id], onDelete: SetNull)
  region            Region?                         @relation(fields: [region_id], references: [id], onDelete: SetNull)
  pillar            Pillar?                         @relation(fields: [pillar_id], references: [id], onDelete: SetNull)
  roleType          RoleType?                       @relation(fields: [role_type_id], references: [id], onDelete: SetNull)
  skills            ProviderSkill[]
  /// The derived per-suite centre of gravity (WS-1). Written only by the
  /// rollup recompute, same as `skills`.
  suiteProfiles     ProviderSuiteProfile[]
  /// WS2 — the full role set. `role_type_id` above stays the primary.
  roles             ProviderProfileRole[]
  specializations   ProviderProfileSpecialization[]
  employers         Employer[]
  projects          Project[]
  packages          Package[]
  education         Education[]
  languages         Language[]
  certifications    Certification[]
  imports           ProfileImport[]
  resumeParseAudits ResumeParseAudit[]
  profileGapFlags   ProfileGapFlags?
  recommendations   RecommendationRequest[]

  @@index([region_id])
  @@index([coordinator_person_id])
  @@index([pillar_id])
  @@index([role_type_id])
  @@map("provider_profiles")
}

enum ExperienceLevel {
  BEGINNER
  MID_CAREER
  EXPERT
}

enum WorkType {
  HOURLY
  PACKAGES
  AGENCY
  CONTRACT_TO_HIRE
}

/// How the provider sells — the "How Do You Work?" step (brief_P / E009).
/// RECRUITER is the user-type fork: a recruiter sells the services of OTHERS
/// and is the app's Coordinator role (see User Hierarchy deck / brief_I).
enum WorkMethod {
  HOURLY
  PACKAGES
  RECRUITER
}

/// Which of the three profile-creation paths the provider used (brief_P / E012).
enum ProfileMethod {
  LINKEDIN
  RESUME
  MANUAL
}

/// Source document for an import attempt (brief_P / E012).
enum ProfileImportSource {
  RESUME
  LINKEDIN_PDF
}

enum ProfileImportStatus {
  PENDING
  PARSED
  FAILED
}

/// Language proficiency (brief_P / E016). Stored as an enum so the four
/// canonical levels can't drift into free text.
enum LanguageProficiency {
  BASIC
  CONVERSATIONAL
  FLUENT
  NATIVE_OR_BILINGUAL
}

/// Provider account lifecycle (brief_K).
enum ProviderStatus {
  PENDING
  ACTIVE
}

/// Merit-based validation track (brief_K). Provider requests; admin grants.
enum ValidationStatus {
  NOT_REQUESTED
  REQUESTED
  VALIDATED
  REJECTED
}

/// Join: a taxonomy Skill this provider offers.
/// Cross-cutting Specialization vocabulary (brief_R) — the 23 entries from the
/// authoritative Service Catalog: products (Oracle Cloud, SAP, Coupa…),
/// methodologies (Procure-to-Pay, Order-to-Cash…) and industries (Healthcare,
/// Federal Government…).
///
/// A separate axis from Role→Domain→Skill: a provider's specializations say
/// WHICH systems/processes/sectors they know, independent of the role they play.
/// Reference data — global, not PAccount-scoped.
///
/// The Domain Model shows BUYERS carrying specializations too; brief_R scopes
/// this to providers, so only the provider join exists for now.
model Specialization {
  id         String             @id @default(uuid()) @db.Uuid
  catalog_id String             @db.Uuid
  name       String
  kind       SpecializationKind @default(PRODUCT)
  /// Display order within a kind; ties break on name.
  sort_order Int                @default(100)
  /// Added by a provider on the fly (brief_S / E031). Never retired by the seed.
  is_custom  Boolean            @default(false)
  created_at DateTime           @default(now())
  updated_at DateTime           @updatedAt

  catalog           ServiceCatalog                  @relation(fields: [catalog_id], references: [id], onDelete: Cascade)
  /// Assessments that named this industry (INDUSTRY-kind rows only, in practice).
  assessments       Assessment[]
  providerProfiles  ProviderProfileSpecialization[]
  workRequests      WorkRequestSpecialization[]
  /// Projects delivered in this sector — only INDUSTRY-kind rows are ever
  /// linked (brief_project_model_v2).
  projectIndustries Project[]

  @@unique([catalog_id, name])
  @@map("specializations")
}

/// Grouping for the picker — the xlsx lists products, then methodologies, then
/// industries, and the step renders them in those groups.
enum SpecializationKind {
  PRODUCT
  METHODOLOGY
  INDUSTRY
}

/// Provider ↔ Specialization multi-select (brief_R).
/**
 * A Work Request's specializations (brief_cwr_specializations_and_import WS-A).
 * Mirrors `ProviderProfileSpecialization` exactly, and deliberately: the
 * requester is answering the same question from the other side ("which
 * products, processes and industries does this touch"), so matching the two is
 * a join on `specialization_id` rather than a translation between two shapes.
 */
model WorkRequestSpecialization {
  id                String   @id @default(uuid()) @db.Uuid
  work_request_id   String   @db.Uuid
  specialization_id String   @db.Uuid
  created_at        DateTime @default(now())

  workRequest    WorkRequest    @relation(fields: [work_request_id], references: [id], onDelete: Cascade)
  specialization Specialization @relation(fields: [specialization_id], references: [id], onDelete: Cascade)

  @@unique([work_request_id, specialization_id])
  @@index([specialization_id])
  @@map("work_request_specializations")
}

model ProviderProfileSpecialization {
  id                  String   @id @default(uuid()) @db.Uuid
  provider_profile_id String   @db.Uuid
  specialization_id   String   @db.Uuid
  created_at          DateTime @default(now())

  providerProfile ProviderProfile @relation(fields: [provider_profile_id], references: [id], onDelete: Cascade)
  specialization  Specialization  @relation(fields: [specialization_id], references: [id], onDelete: Cascade)

  @@unique([provider_profile_id, specialization_id])
  @@index([specialization_id])
  @@map("provider_profile_specializations")
}

// ---------------------------------------------------------------------------
// Provider portfolio entities (brief_S / E037, per "Service Provider
// Categorization"): Projects → Solutions, Certifications, Employers.
//
// These are the provider's PROOF OF WORK, distinct from the taxonomy axes:
//   Role → Domain → Skill  = what they can do
//   Specializations        = which systems/processes/sectors they know
//   Projects/Certs/Employers = what they have actually done
// ---------------------------------------------------------------------------

/// A company the provider has worked for. First-class (rather than the free
/// text on WorkExperience) because the categorization diagram links Employers
/// to Certifications and Projects, and buyers filter on them.
model Employer {
  id                  String    @id @default(uuid()) @db.Uuid
  provider_profile_id String    @db.Uuid
  name                String
  /// Job title held there.
  role_title          String?
  /// Free-text legacy location ("Chicago, IL"). Superseded by the structured
  /// city/state/country below (Walk6 WS3 / E111) and kept so pre-existing rows
  /// still render; new writes fill both.
  location            String?
  city                String?
  state               String?
  /// From the shared `COUNTRIES` list — a validated value, not free text.
  country             String?
  start_date          DateTime?
  end_date            DateTime?
  /// True while this is the provider's current employer.
  is_current          Boolean   @default(false)
  description         String?
  /// Company logo (brief_U / E043). Suggested from the company name via a logo
  /// API, then ACCEPTED by the provider — never auto-applied, because name →
  /// company matching is fuzzy and a wrong logo on a profile looks worse than
  /// none. Null when unset or declined.
  logo_url            String?
  /// Ordering on the profile / capture step; lower first.
  sort_order          Int       @default(100)
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  /// Someone at the employer who can vouch for the work (PJv2 WS0 / E078b).
  /// Powers the Work-History "Contact" link, which WS5 gates behind Plus.
  /// Projects carry their own `contact_email` + `client_domain` already; this is
  /// the employer-level equivalent.
  contact_email String?

  /// THE SUITE THIS JOB WAS WORKED ON (brief_per_job_skill_model WS-1).
  ///
  /// Derived by the parser from the job block's own unambiguous skills, then
  /// shown to the provider to confirm or fix. Null means genuinely unknown —
  /// the block listed shared modules with no anchor — and is what raises the
  /// "which system?" prompt on that one job. Null is not "agnostic";
  /// CROSS_VENDOR is.
  ///
  /// This is the column that makes "General Ledger" mean something. A skill
  /// name is ambiguous across vendors; the same name inside a job that carries
  /// its suite is not.
  software_suite   SoftwareSuite?
  /// The Role this job represents, derived from its skills (a Skill belongs to
  /// exactly one Role). Stored rather than recomputed on read because a
  /// provider may override it, and an override has to survive.
  job_role_type_id String?        @db.Uuid

  providerProfile ProviderProfile @relation(fields: [provider_profile_id], references: [id], onDelete: Cascade)
  jobRoleType     RoleType?       @relation("EmployerJobRole", fields: [job_role_type_id], references: [id], onDelete: SetNull)
  projects        Project[]
  artifacts       Artifact[]
  skills          JobSkill[]

  @@index([provider_profile_id])
  @@index([job_role_type_id])
  @@map("employers")
}

/// A SKILL USED ON ONE JOB — the source of truth for everything downstream
/// (brief_per_job_skill_model WS-1).
///
/// Attaches to an Employer or, more finely, to a Project under one. Exactly one
/// of the two is set; the check is in `access.ts` rather than the schema
/// because Prisma cannot express an XOR and a half-attached row is a bug worth
/// a readable error rather than a constraint violation.
///
/// THIS REPLACES PROFILE-LEVEL SKILL PICKING. The provider no longer says "I
/// know Payables"; a job of theirs says "Payables was used here, on this suite,
/// for these dates", and `ProviderSkill` is the arithmetic on top. Every claim
/// therefore arrives with an employer, a date range and a suite attached, which
/// is what makes it checkable and expensive to fake.
model JobSkill {
  id          String   @id @default(uuid()) @db.Uuid
  employer_id String?  @db.Uuid
  project_id  String?  @db.Uuid
  skill_id    String   @db.Uuid
  /// Led this workstream rather than contributed to it. Recorded now, unused
  /// in the v1 weighting — the seniority multiplier is explicitly deferred, and
  /// the flag is cheap to collect and impossible to backfill later.
  lead        Boolean?
  created_at  DateTime @default(now())

  employer Employer? @relation(fields: [employer_id], references: [id], onDelete: Cascade)
  project  Project?  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  skill    Skill     @relation(fields: [skill_id], references: [id], onDelete: Cascade)

  @@unique([employer_id, skill_id])
  @@unique([project_id, skill_id])
  @@index([skill_id])
  @@map("job_skills")
}

/// Proof of work attached to an Employer OR a Project (PJv2 WS0/WS4 / E078a).
///
/// Two shapes, one model: an UPLOAD (a file in the private `artifacts` bucket —
/// object path, never a public URL, same rule as certificates and project docs)
/// or a URL (a published case study, a repo, a talk). Exactly ONE owner FK is
/// set; that is enforced in the write path rather than by a DB constraint
/// Prisma can't express.
model Artifact {
  id          String       @id @default(uuid()) @db.Uuid
  employer_id String?      @db.Uuid
  project_id  String?      @db.Uuid
  kind        ArtifactKind
  /// Set when kind = UPLOAD. Object path in the PRIVATE `artifacts` bucket.
  file_path   String?
  /// Set when kind = URL.
  url         String?
  label       String
  sort_order  Int          @default(100)
  created_at  DateTime     @default(now())
  updated_at  DateTime     @updatedAt

  employer Employer? @relation(fields: [employer_id], references: [id], onDelete: Cascade)
  project  Project?  @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([employer_id])
  @@index([project_id])
  @@map("artifacts")
}

enum ArtifactKind {
  UPLOAD
  URL
}

/// A delivered piece of work, done AT an employer.
///
/// The `Solution` child this used to carry is gone (brief_V / E045): what it
/// was reaching for is a PACKAGE — a productized offering the provider SELLS —
/// and that is a standalone catalog entity, not a sub-part of past work.
///
/// `employer_id` is retained and is how the capture step nests projects under
/// the job they belong to (brief_U). It stays nullable so a project imported
/// or entered before its employer exists isn't rejected.
/// How much of the client's identity a viewer may see (brief_project_model_v2).
///
/// Stored NOW, enforced LATER: `PLUS_ONLY` is the membership-gated tier and
/// behaves exactly like `PUBLIC` until the Plus brief ships, so nothing is
/// silently hidden by a tier that doesn't exist yet. `CONFIDENTIAL` is the one
/// that bites today — the client name is replaced by the code name and the
/// industry everywhere it renders.
enum ClientVisibility {
  PUBLIC
  PLUS_ONLY
  CONFIDENTIAL
}

/// Per-project validation state (brief_project_model_v2). "Validated", never
/// "verified" — the locked terminology (decisions-01, 2026-07-29).
///
/// Groundwork only in this brief: the field exists and always reads `NONE`.
/// The workflow that moves it to PENDING (email sent to `contact_email`) and
/// VALIDATED (contact confirmed) is the NEXT brief.
enum ProjectValidationStatus {
  NONE
  PENDING
  VALIDATED
}

/// A delivered piece of work, done AT an employer.
///
/// The `Solution` child this used to carry is gone (brief_V / E045): what it
/// was reaching for is a PACKAGE — a productized offering the provider SELLS —
/// and that is a standalone catalog entity, not a sub-part of past work.
///
/// `employer_id` is retained and is how the capture step nests projects under
/// the job they belong to (brief_U). It stays nullable so a project imported
/// or entered before its employer exists isn't rejected.
///
/// V2 (brief_project_model_v2) turns this from a name+blurb into the reporting
/// grain of the whole product. The classification fields are CATALOG-LINKED
/// rather than free text — `role_type_id` and the `ProjectApplication` join —
/// because "show me every Technical project that used Oracle Fusion" has to be
/// a query, and free text can never be charted.
model Project {
  id                  String    @id @default(uuid()) @db.Uuid
  provider_profile_id String    @db.Uuid
  employer_id         String?   @db.Uuid
  name                String
  description         String?
  /// Public link (case study, repo, published site) when there is one.
  url                 String?
  /// Cover image in the portfolio grid.
  image_url           String?
  start_date          DateTime?
  end_date            DateTime?
  /// True while the provider is still on this project; `end_date` is then null
  /// by design and the card renders "– Present". Mirrors `Employer.is_current`.
  is_current          Boolean   @default(false)

  // --- Classification (catalog-linked, for reporting) ----------------------
  /// What the provider DID here (Application-Specific / Technical / …).
  ///
  /// NULLABLE = "unclassified", deliberately. Classification is the reporting
  /// grain, so it is REQUIRED in the Add/Edit-Project modal and in the write
  /// path behind it (`projectData`). But a résumé importer cannot know the
  /// role, and defaulting it would write a value the provider never chose —
  /// silently poisoning the very charts this field exists to feed. A null is
  /// honest and queryable ("show me unclassified projects"), and the review
  /// page nudges the provider to fix it. Same reasoning as `employer_id`.
  role_type_id               String?        @db.Uuid
  /// The sector this was delivered in. Reuses the INDUSTRY slice of the
  /// Specialization vocabulary rather than a free-text column, so a
  /// confidential project can still say "Oil & Gas" in a chartable way.
  industry_specialization_id String?        @db.Uuid
  /// The suite THIS engagement ran on, which may differ from the parent
  /// Employer's (WS-1) — a permanent Oracle shop with one PeopleSoft migration
  /// project is the ordinary case, not an edge one. Null INHERITS the
  /// employer's suite at rollup time; it does not mean "unknown" here, because
  /// a project without its own suite is the normal shape.
  software_suite             SoftwareSuite?

  // --- Client -------------------------------------------------------------
  /// REQUIRED. Held even when `client_visibility` hides it — the redaction is
  /// a RENDER decision, so the name stays available for the validation email
  /// and for Plus members once that ships.
  /// ── ⚠⚠ THE TWO FIELDS AN EMPLOYER HAS AND A PROJECT DID NOT (`P1-J1.4-E296`)
  ///
  /// SCOTT: *"this is the edit process. I would need to delete EVERY employer and
  /// then re-add them as a project. Maybe if there was a employer/project radio
  /// button?"* — and the rule behind it: *"what really determines the value of
  /// the AI is how easy the edit is… if the change of employer to project is
  /// easy, who cares. If not, they are mad."*
  ///
  /// Reclassifying an employer as a project maps every other field one-to-one.
  /// These two had NO HOME: `Employer.role_title` and `Employer.location`. Without
  /// them the conversion either DROPS "Lead Oracle Cloud Procurement Consultant"
  /// and "Houston, TX", or smuggles them into `description` as appended lines.
  ///
  /// ⚠⚠ THE APPENDED-LINE TRICK IS WHAT MAKES THE OPERATION IRREVERSIBLE — undoing
  /// it means parsing prose back out of a text field, and every round trip either
  /// duplicates the block or corrupts it. Two nullable columns make the conversion
  /// LOSSLESS IN BOTH DIRECTIONS, which is what lets Undo be a clean inverse
  /// instead of a snapshot table.
  ///
  /// ⚠ THEY STAND ON THEIR OWN MERITS TOO: a project has a role you played and a
  /// place it happened, and the résumé states both. ⚠ `role_type_id` is the
  /// catalog CLASSIFICATION, not the title — they are different fields.
  /// ⚠ NOTHING RENDERS THEM YET. Stored, mapped and round-tripped only; putting
  /// them on a card is a separate ask.
  role_title        String?
  location          String?

  client_name       String
  client_visibility ClientVisibility @default(PUBLIC)
  /// The project alias shown INSTEAD of the client when confidential.
  code_name         String?
  /// The client's own internet domain (brief_validation_domain_guard).
  ///
  /// This is what makes the Validated badge mean anything: a validation request
  /// may only be sent to an address AT this domain, so a provider cannot
  /// self-validate from a personal inbox. Suggested from `client_name` via the
  /// same brand API that suggests the logo (E043) and then CONFIRMED by the
  /// provider — never auto-applied, because name → domain is fuzzy.
  ///
  /// INTERNAL ONLY. Never rendered on a card or returned by a public read: a
  /// CONFIDENTIAL project hides its client, and leaking the domain would undo
  /// that. Nullable, and a project without one simply cannot be validated.
  client_domain     String?

  // --- Validation groundwork (workflow = next brief) ----------------------
  /// Who at the client can confirm this work happened.
  contact_email     String?
  validation_status ProjectValidationStatus @default(NONE)

  // --- What you did -------------------------------------------------------
  /// The bullets, as a real list — not one blob to be split on render.
  highlights String[]

  // --- Media --------------------------------------------------------------
  video_url     String?
  /// Supporting document in the PRIVATE `project-docs` bucket — an object
  /// path, not a URL, exactly like `Certification.attachment_path`. A statement
  /// of work carries client names and commercials; it is never public.
  document_path String?
  document_name String?
  /// Client/project logo, SUGGESTED from `client_name` and then accepted by the
  /// provider — never auto-applied (the E043 rule from Employer).
  logo_url      String?

  /// Ordering in the portfolio; lower first.
  sort_order Int      @default(100)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  providerProfile ProviderProfile      @relation(fields: [provider_profile_id], references: [id], onDelete: Cascade)
  employer        Employer?            @relation(fields: [employer_id], references: [id], onDelete: SetNull)
  roleType        RoleType?            @relation(fields: [role_type_id], references: [id], onDelete: SetNull)
  industry        Specialization?      @relation(fields: [industry_specialization_id], references: [id], onDelete: SetNull)
  applications    ProjectApplication[]
  outcomes        ProjectOutcome[]
  validations     ProjectValidation[]
  artifacts       Artifact[]
  skills          JobSkill[]

  @@index([provider_profile_id])
  @@index([employer_id])
  @@index([role_type_id])
  @@map("projects")
}

/// One validation REQUEST sent to a project's client contact
/// (brief_project_validation).
///
/// The trust loop: a provider names someone at the client who can confirm the
/// work, Panameer emails them a single-use link, and their answer flips the
/// project's badge. The contact never needs an account — the token IS the
/// authorization, which is why it is stored only as a SHA-256 HASH, expires,
/// and is consumed on first use (the same contract as the email-verify and
/// SIGNIN tokens; see decisions-01).
///
/// Kept as its own row rather than columns on Project because the ANSWER is
/// evidence: who confirmed, from where, and when. A resend supersedes the live
/// request instead of overwriting that history.
/// Q4's answer. ⚠ THREE OPTIONS, NOT FIVE STARS (`P1-J2.1-E024`) — the
/// client-ranking primitive, chosen so every option is one a real person can pick
/// honestly. A five-point scale makes the middle meaningless and the top
/// compulsory.
enum WouldWorkAgain {
  YES
  MAYBE
  NO
}

model ProjectValidation {
  id            String                         @id @default(uuid()) @db.Uuid
  project_id    String                         @db.Uuid
  /// The address the request was sent to, captured at send time — the project's
  /// `contact_email` can be edited afterwards, and this must record who was
  /// actually asked.
  contact_email String
  token_hash    String                         @unique
  status        ProjectValidationRequestStatus @default(SENT)
  expires_at    DateTime
  sent_at       DateTime                       @default(now())
  responded_at  DateTime?
  /// Light provenance on the response. Never shown to the provider — it exists
  /// so a disputed confirmation can be investigated.
  responder_ip  String?
  responder_ua  String?

  /// ── ⚠⚠ THE FIVE ANSWERS (`P1-J2.1-E024`, 2026-09-01) ──────────────────────
  ///
  /// Scott: *"the email validation should push you back to a listing of 5
  /// questions. when did you work with them. what skills… or something like
  /// this."*
  ///
  /// ⚠⚠ EVERY ONE IS NULLABLE, AND THAT IS THE WHOLE DESIGN. The confirmation is
  /// committed BEFORE these are shown and is NEVER conditional on them — a client
  /// who confirms and closes the tab has still validated the project. Making any
  /// of these required would turn a feature that adds evidence into one that
  /// LOSES validations, which is strictly worse than shipping nothing.
  ///
  /// ⚠ THEY LIVE HERE, WITH `responder_ip` / `responder_ua`, because they are the
  /// same kind of thing: evidence attached to one verified third-party response.
  /// A separate table would let an answer exist without the response it belongs to.

  /// Who answered — attribution, and only shown publicly if they tick the flag.
  responder_name  String?
  responder_title String?

  /// Q1 — corroborated dates. Pre-filled from the project; their CORRECTION is
  /// the evidence, which is why this is stored separately rather than overwriting
  /// the project's own dates.
  worked_from      DateTime?
  worked_to        DateTime?
  /// Q2 — "what did they do for you".
  role_note        String?
  /// ⚠ Q3 — FREE STRINGS, NOT `Skill` IDS. The client is naming what they
  /// remember, not picking from a taxonomy. Mapping their words onto catalog
  /// skills is a later decision and must not be made silently here.
  skills_noted     String[]
  /// ⚠ Q4 — THREE HONEST OPTIONS, DELIBERATELY NOT A STAR RATING. Nobody has to
  /// decide what four stars means, and three options are answerable truthfully.
  would_work_again WouldWorkAgain?
  /// Q5 — the testimonial, from someone whose email domain proves they were the
  /// client. The opposite of a solicited recommendation from a friend.
  testimonial      String?

  /// ── ⚠⚠ TWO CONSENT FLAGS, NOT ONE ─────────────────────────────────────────
  /// *"You may show what I wrote"* and *"You may use my name"* are DIFFERENT
  /// permissions, and a client may well give the first and withhold the second.
  /// ⚠ BOTH DEFAULT FALSE. Nothing is published without an explicit tick.
  /// ⚠ THEY GOVERN PUBLIC DISPLAY ONLY — the provider may always read what their
  /// own client said about them.
  testimonial_public Boolean @default(false)
  attribution_public Boolean @default(false)

  /// Set when any answer is saved. ⚠ NEVER changes `status` — the badge was
  /// already earned by the click that came before.
  answered_at DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([project_id])
  @@index([status])
  @@map("project_validations")
}

/// Lifecycle of one validation REQUEST. Deliberately a DIFFERENT enum from
/// `ProjectValidationStatus` on the project itself: this one tracks the letter
/// (was it sent, answered, ignored), that one tracks the badge.
enum ProjectValidationRequestStatus {
  SENT
  CONFIRMED
  DECLINED
  EXPIRED
}

/// Join: a tool / application / technology used on a project.
///
/// Many-to-many against the SAME `Application` catalog the skill taxonomy uses,
/// so "which projects used this app" and "which skills touch this app" answer
/// from one vocabulary. Provider-added entries are `Application.is_custom`.
model ProjectApplication {
  id             String   @id @default(uuid()) @db.Uuid
  project_id     String   @db.Uuid
  application_id String   @db.Uuid
  created_at     DateTime @default(now())

  project     Project     @relation(fields: [project_id], references: [id], onDelete: Cascade)
  application Application @relation(fields: [application_id], references: [id], onDelete: Cascade)

  @@unique([project_id, application_id])
  @@index([application_id])
  @@map("project_applications")
}

/// A quantified result of a project — label + value, e.g. "Savings" / "$10M+".
///
/// Deliberately a CHILD ROW rather than a JSON blob or a formatted sentence:
/// the numbers are the part of a profile a buyer actually reads, and they are
/// the first thing reporting will want to aggregate.
model ProjectOutcome {
  id         String   @id @default(uuid()) @db.Uuid
  project_id String   @db.Uuid
  label      String
  value      String
  sort_order Int      @default(100)
  created_at DateTime @default(now())

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([project_id])
  @@map("project_outcomes")
}

/// A productized, a-la-carte offering the provider SELLS (brief_V / E045).
///
/// Standalone on the provider — their sellable catalog — deliberately NOT tied
/// to a past Project. A Project is proof of work already delivered; a Package
/// is something a buyer can buy today. Example: "Install DocuSign for Oracle
/// Cloud" — 5 weeks, $40,000, 50% upfront / 50% on completion.
///
/// Optional throughout: packages never gate publishing and carry no
/// completeness weight (brief_R/U invariant untouched).
model Package {
  id                  String             @id @default(uuid()) @db.Uuid
  provider_profile_id String             @db.Uuid
  title               String
  /// The scope — what the buyer is actually getting.
  summary             String?
  /**
   * Timeline in weeks.
   * ⚠ A DELIVERY CONSTRUCT, AND MEANINGLESS ON A `DEPLOYABLE`. An agent has no
   * duration — it has coverage and setup. `kind = DEPLOYABLE` must leave this null,
   * and `check:solution-types` fails the build over a row that does not.
   * ⚠ NOT DELETED AND NOT REPURPOSED: `DELIVERABLE` still needs it.
   */
  duration_weeks      Int?
  /**
   * ⚠ NO LONGER "FIXED-PRICE ONLY" — the old comment here said *"V1 is FIXED-price
   * only; the enum leaves room for HOURLY/TM later"* and, as of 2026-08-21, that
   * contradicts both the enum and the product: a `DEPLOYABLE` bills `RECURRING` and
   * `HOURS` bills `HOURLY`. Corrected rather than left to mislead.
   * The kind constrains this — see `lib/catalog/solution-types.ts`, which is the one
   * place the rule is written down.
   */
  pricing_type        PackagePricingType @default(FIXED)
  /// Integer cents, like every other money value in the app.
  price_cents         Int?
  currency            String             @default("USD")
  /// Optional categorization for the catalog and future Work Request matching.
  role_type_id        String?            @db.Uuid
  cover_image_url     String?
  /**
   * ⚠ THE PERIOD `price_cents` CANNOT CARRY. Non-null EXACTLY WHEN
   * `pricing_type = RECURRING`, and null otherwise — asserted in
   * `check:solution-types`, in both directions. A `FIXED` package carrying a period
   * is as wrong as a `RECURRING` one without it.
   */
  billing_period      BillingPeriod?
  /**
   * ⚠ WHAT IS BEING BOUGHT. Defaults to `DELIVERABLE` so every row that existed
   * before 2026-08-21 keeps behaving exactly as it does today — they are all
   * fixed-price scoped packages.
   * ⚠ ONE OF THOSE ROWS IS MISDESCRIBED BY THE DEFAULT AND IT IS REPORTED, NOT
   * QUIETLY RETYPED: `Contract Price Alert Agent` is semantically a `DEPLOYABLE`.
   * Re-typing it is CONTENT — it needs Scott's merged agent list — and the brief that
   * added this column put seeding out of scope.
   * ⚠ AN AGENT HAS A `provider_profile_id` LIKE EVERY OTHER PACKAGE. Scott,
   * 2026-08-21, dissolving `P1-J2-E007`: *"AI Agents are service products created by
   * experts on the AIP. As with everything, we will start with me and with P2P."* So
   * there is NO first-party flag, NO nullable owner and NO `HouseProduct` model, and
   * `provider_profile_id` STAYS NOT NULL.
   */
  kind                PackageKind        @default(DELIVERABLE)
  status              PackageStatus      @default(DRAFT)
  sort_order          Int                @default(100)
  created_at          DateTime           @default(now())
  updated_at          DateTime           @updatedAt

  providerProfile   ProviderProfile           @relation(fields: [provider_profile_id], references: [id], onDelete: Cascade)
  roleType          RoleType?                 @relation(fields: [role_type_id], references: [id], onDelete: SetNull)
  deliverables      PackageDeliverable[]
  milestones        PackageMilestone[]
  skills            PackageSkill[]
  /// Which capability domains this product operates on — MANY, see the join model.
  capabilityDomains PackageCapabilityDomain[]
  /// How this product's value is estimated. MANY: a product can save contract value
  /// AND avoid a fixed risk, so these are rows, not columns.
  valueFactors      PackageValueFactor[]

  @@index([provider_profile_id])
  @@index([role_type_id])
  @@map("packages")
}

/// ⚠ WHAT YOU ARE BUYING — NOT HOW IT BILLS. That is `PackagePricingType`, and the
/// separation is the whole design (brief_solution_types).
///
/// Scott, 2026-08-21: *"i am thinking each service package has a 'type'. One being AI
/// Agent."* — then named six: AI Agents · Consultation · Monthly Retainer · Packaged
/// Deployment · Mentoring · Support.
///
/// ⚠ THREE OF THOSE SIX ARE ONE PRODUCT WEARING THREE LABELS. Consultation, Monthly
/// Retainer and Mentoring are all AN EXPERT'S TIME; they differ by billing and by
/// where they are sold. Modelled as six enum members, the first buyer who wants a
/// RETAINED MENTOR or a ONE-OFF SUPPORT CALL cannot express it, and you are back in a
/// schema change to add a label. So: THREE STORED KINDS, SIX DERIVED LABELS. The
/// labels are a display concern and are deliberately not in the database.
///
/// ⚠⚠ THESE NAMES ARE SCOTT'S, FROM `mockups/roadmap_request_pathways_2026-08-21.html`,
/// AND THEY REPLACED AN EARLIER CHAT TRIO OF `AGENT · ENGAGEMENT · DEPLOYMENT`.
///
/// ⚠ `DEPLOYMENT` IS BANNED AND MUST NOT BE REINTRODUCED. It is one letter from
/// `DEPLOYABLE` and means the OPPOSITE THING: a `DEPLOYABLE` is an agent that runs; a
/// "deployment" is a scoped package that ends. Anyone reading an older note and
/// "restoring" it would silently swap a subscription for a fixed-price project.
///
/// ⚠ `EXPERT` IS NOT A MEMBER AND MUST NOT BE ADDED. An expert is a PERSON with a
/// rate, not a `Package`. `GetTheTalentShot` shows three RECOMMENDATION SHAPES —
/// expert · package · agent — and only two of them are rows in this table. Adding
/// `EXPERT` here would permit a package with no human attached, which is the one thing
/// the `provider_profile_id NOT NULL` constraint exists to prevent.
enum PackageKind {
  /// An agent an expert publishes. Runs under a standing SOW until cancelled: no end
  /// date, no milestones, no duration. Bills `RECURRING`.
  DEPLOYABLE
  /// A named person's time, settled by timesheet. `HOURLY`, or `RECURRING` for a
  /// retainer.
  HOURS
  /// A defined scope, settled by payment request — lump sum or milestones. `FIXED`.
  DELIVERABLE
}

/// ⚠ `RECURRING` NEEDS A PERIOD AND `price_cents` ALONE CANNOT CARRY ONE. `$450` is
/// not `$450/mo`.
///
/// ⚠ SAME LESSON AS `P1-J0.4-E044`, WHICH LANDED THE SAME DAY: the AI-maturity deck
/// asks for "Estimated Number of Invoice Lines" and names no period anywhere, so
/// nothing downstream can normalise it into a rate. Not repeating that here.
enum BillingPeriod {
  MONTHLY
  ANNUAL
}

/// ⚠ HOW IT BILLS — the other half of `PackageKind`.
enum PackagePricingType {
  /// A lump sum or milestone total. The only shape shipped before 2026-08-21.
  FIXED
  /// A rate against a timesheet.
  HOURLY
  /// Time & materials.
  TM
  /// ⚠ ADDED 2026-08-21, AND IT SHIPPED WITH `PackageKind` RATHER THAN AFTER IT
  /// because `$450/mo` was not expressible at all: a `DEPLOYABLE` has no other shape.
  /// Requires `billing_period`; see the invariant on `Package.billing_period`.
  RECURRING
}

enum PackageStatus {
  DRAFT
  PUBLISHED
}

/// One line of "what you get". A child row rather than String[] so the order is
/// explicit and each line can grow (e.g. a note) without a migration.
///
/// ⚠ A DELIVERY CONSTRUCT. A `DEPLOYABLE` must have NONE — an agent does not deliver
/// a list of things once, it runs. `check:solution-types` refuses a row that does.
///
/// ⚠ WHETHER THIS CAN CARRY AN AGENT'S OWN THREE FACTS — `Runs · Setup · Covers`,
/// where a package draws `Scope · Duration · Delivered` — IS AN OPEN QUESTION AND IS
/// NOT ANSWERED HERE. See the report on brief_solution_types.
model PackageDeliverable {
  id         String   @id @default(uuid()) @db.Uuid
  package_id String   @db.Uuid
  text       String
  sequence   Int      @default(0)
  created_at DateTime @default(now())

  pkg Package @relation(fields: [package_id], references: [id], onDelete: Cascade)

  @@index([package_id])
  @@map("package_deliverables")
}

/// A payment term: "50% Upfront", "50% On completion".
///
/// ⚠ A DELIVERY CONSTRUCT, AND NONSENSE ON A `DEPLOYABLE`: a milestone on a thing that
/// never ends has nothing to be a percentage of the completion of. `check:solution-types`
/// refuses one rather than leaving it merely unused.
///
/// Percent OF THE TOTAL rather than an amount, so editing the price can never
/// leave the milestones summing to something other than the package price. The
/// writer validates the percents sum to exactly 100.
model PackageMilestone {
  id         String   @id @default(uuid()) @db.Uuid
  package_id String   @db.Uuid
  label      String
  percent    Int
  sequence   Int      @default(0)
  created_at DateTime @default(now())

  pkg Package @relation(fields: [package_id], references: [id], onDelete: Cascade)

  @@index([package_id])
  @@map("package_milestones")
}

/// Skill tags on a package — categorization for the catalog and future matching.
model PackageSkill {
  id         String   @id @default(uuid()) @db.Uuid
  package_id String   @db.Uuid
  skill_id   String   @db.Uuid
  created_at DateTime @default(now())

  pkg   Package @relation(fields: [package_id], references: [id], onDelete: Cascade)
  skill Skill   @relation(fields: [skill_id], references: [id], onDelete: Cascade)

  @@unique([package_id, skill_id])
  @@index([skill_id])
  @@map("package_skills")
}

/// A role this provider works in (brief_onboarding_slimdown WS2 / E172, E173).
///
/// SUPERSEDES the locked "one main RoleType" rule. A techno-functional
/// consultant is genuinely Application-Specific AND Technology-Specific, and
/// forcing one meant the skills step could only offer half their catalog.
///
/// `ProviderProfile.role_type_id` SURVIVES as the PRIMARY role — what the
/// profile leads with, what derivations read, and what a single-role provider
/// (most of them) has. This table is the full set including that primary, so a
/// reader never has to union two sources.
model ProviderProfileRole {
  id                  String   @id @default(uuid()) @db.Uuid
  provider_profile_id String   @db.Uuid
  role_type_id        String   @db.Uuid
  created_at          DateTime @default(now())

  providerProfile ProviderProfile @relation(fields: [provider_profile_id], references: [id], onDelete: Cascade)
  roleType        RoleType        @relation(fields: [role_type_id], references: [id], onDelete: Cascade)

  @@unique([provider_profile_id, role_type_id])
  @@index([role_type_id])
  @@map("provider_profile_roles")
}

/// Which optional sections a provider left empty at publish
/// (brief_onboarding_slimdown WS5).
///
/// RECORDED, NOT SENT. The re-engagement engine — "these specializations are
/// hot and yours are empty", "a client asked for a bio" — is its own feature
/// and explicitly out of scope here. This brief only makes sure the evidence
/// it will need exists from the first published profile, because a nudge
/// engine built later against no history has nothing to nudge about.
///
/// One row per profile, rewritten on each publish: the question is always
/// "what is missing NOW", never a history of what once was.
model ProfileGapFlags {
  id                  String   @id @default(uuid()) @db.Uuid
  provider_profile_id String   @unique @db.Uuid
  no_bio              Boolean  @default(false)
  no_education        Boolean  @default(false)
  no_specializations  Boolean  @default(false)
  no_languages        Boolean  @default(false)
  no_work_history     Boolean  @default(false)
  no_certifications   Boolean  @default(false)
  /// When the flags were last recomputed — the engine will want to know how
  /// stale a gap is before it emails anyone about it.
  computed_at         DateTime @default(now())

  providerProfile ProviderProfile @relation(fields: [provider_profile_id], references: [id], onDelete: Cascade)

  @@map("profile_gap_flags")
}

/// THE DERIVED SKILL ROLLUP — what search and matching actually query
/// (brief_per_job_skill_model WS-1/WS-2).
///
/// ⚠ THIS TABLE IS AN INDEX, NOT AN INPUT. It used to be the provider's own
/// checklist, written straight from a wizard step. It is now recomputed in full
/// from `JobSkill` whenever any job changes, and `recomputeProviderRollup()` in
/// `src/lib/provider-rollup.ts` is the ONLY thing that may write it. A feature
/// that writes a row here directly is a feature whose data the next job edit
/// silently deletes.
///
/// WHY MATERIALIZE IT AT ALL, given it is pure arithmetic over jobs: matching
/// ranks thousands of providers by weight per query, and recomputing a decayed
/// sum over every job of every candidate at request time is the difference
/// between an index scan and a table scan. It is a cache with exactly one
/// writer and a well-defined invalidation point.
model ProviderSkill {
  id                  String              @id @default(uuid()) @db.Uuid
  provider_profile_id String              @db.Uuid
  skill_id            String              @db.Uuid
  /// Σ over jobs listing this skill of months(job) × recency(end_date).
  /// Depth and currency in one number — see `src/lib/provider-rollup.ts` for
  /// the decay constant, which lives in exactly one place on purpose.
  weight              Float               @default(0)
  /// Cumulative months across those jobs, undecayed — the honest "how long",
  /// for display, where a decayed float would be unexplainable to a human.
  months_total        Int                 @default(0)
  first_used          DateTime?
  last_used           DateTime?
  /// The suite(s) this skill was used under; usually one. An array rather than
  /// a scalar because a genuine multi-suite consultant is exactly the provider
  /// this model exists to describe properly.
  suites              SoftwareSuite[]
  source              ProviderSkillSource @default(DERIVED)
  created_at          DateTime            @default(now())
  updated_at          DateTime            @default(now()) @updatedAt

  providerProfile ProviderProfile @relation(fields: [provider_profile_id], references: [id], onDelete: Cascade)
  skill           Skill           @relation(fields: [skill_id], references: [id], onDelete: Cascade)

  @@unique([provider_profile_id, skill_id])
  @@index([skill_id])
  /// Matching's hot path: "who has this skill, best first".
  @@index([skill_id, weight])
  @@map("provider_skills")
}

/// A PROVIDER'S CENTRE OF GRAVITY across suites (WS-1/WS-2).
///
/// The same weighted sum as `ProviderSkill`, grouped by suite and normalised to
/// a percentage: "Oracle Cloud 85%, PeopleSoft 15%". Derived and disposable,
/// same single writer.
///
/// Its job is tie-breaking and display, NOT filtering. A buyer naming a suite
/// gets providers of that suite boosted, never providers of other suites
/// excluded — a 15%-PeopleSoft consultant with deep recent PeopleSoft GL is
/// still the right answer to a PeopleSoft GL question.
model ProviderSuiteProfile {
  id                  String        @id @default(uuid()) @db.Uuid
  provider_profile_id String        @db.Uuid
  suite               SoftwareSuite
  /// 0–100, normalised across this provider's suites. Rounded for display but
  /// stored as a float so several small suites cannot round to zero and vanish.
  weight_pct          Float         @default(0)
  last_used           DateTime?
  updated_at          DateTime      @default(now()) @updatedAt

  providerProfile ProviderProfile @relation(fields: [provider_profile_id], references: [id], onDelete: Cascade)

  @@unique([provider_profile_id, suite])
  @@index([suite])
  @@map("provider_suite_profiles")
}

/// A past employment on a provider's profile, with its notable projects.
/// A notable project under a WorkExperience.
/// An education entry on a provider's profile.
model Education {
  id                  String   @id @default(uuid()) @db.Uuid
  provider_profile_id String   @db.Uuid
  institution         String
  degree              String?
  field               String?
  /// Legacy single year (brief_E). Superseded by start_year/end_year
  /// (brief_P / E015, "Dates Attended"); kept so existing rows still read.
  year                Int?
  start_year          Int?
  end_year            Int?
  description         String?
  created_at          DateTime @default(now())

  providerProfile ProviderProfile @relation(fields: [provider_profile_id], references: [id], onDelete: Cascade)

  @@index([provider_profile_id])
  @@map("education")
}

/// A language a provider speaks.
model Language {
  id                  String               @id @default(uuid()) @db.Uuid
  provider_profile_id String               @db.Uuid
  name                String
  /// Free-text legacy column (brief_E). `level` is the canonical value now
  /// (brief_P / E016); this stays readable for rows written before the enum.
  proficiency         String?
  level               LanguageProficiency?
  created_at          DateTime             @default(now())

  providerProfile ProviderProfile @relation(fields: [provider_profile_id], references: [id], onDelete: Cascade)

  @@index([provider_profile_id])
  @@map("languages")
}

/// A professional certification on a provider's profile.
/// A credential the provider holds. Pre-dates brief_S; E037 promotes it to a
/// displayed portfolio entity and links it to the Employer it was earned at
/// (the categorization diagram's Employer → Certification edge).
/// A credential the provider holds.
///
/// STANDALONE (brief_U / E044, correcting brief_S): a certification belongs to
/// the CERTIFYING AGENCY that issued it, not to an employer the provider
/// happened to work for when they earned it. The employer link and the
/// carry-it-forward-by-name logic that came with it are gone.
/// ── ⚠ A CREDENTIAL BELONGS TO THE PERSON, NOT TO THEIR SELLER PROFILE ───────
///
/// `P1-J3-E019`. Scott, 2026-08-21: *"it will be mostly providers...but we should
/// make certification.user_id."*
///
/// ⚠ TWO CONSEQUENCES OF THE OLD SHAPE, AND THE SECOND IS THE ONE THAT DECIDED IT:
///
///   1. A LEARNER WHO IS NOT A SELLER EARNED NOTHING. `provider_profile_id` was
///      required, so the issuer's `if (!profile) return null` meant a learner with
///      no `ProviderProfile` passed the test and got no row, no credential, no
///      verify page and no error. The public Learn page invites exactly that
///      person.
///   2. ⚠⚠ `onDelete: Cascade` FROM `ProviderProfile` MEANT DELETING A PROVIDER
///      PROFILE DELETED THEIR CERTIFICATIONS — INCLUDING `LEARN` ROWS PANAMEER
///      ISSUED AND VOUCHES FOR. Someone who stopped selling lost a credential we
///      certified and published a verify URL for.
///
/// ⚠ NOT A FORK. The model's own note below still holds: a Learn certificate IS a
/// certification, `issued_from` is what tells the two apart, and a parallel model
/// would give a provider two identical-looking sections that behaved differently.
model Certification {
  id                  String    @id @default(uuid()) @db.Uuid
  /**
   * ⚠ THE OWNER, AND IT IS REQUIRED. Every credential has one; this is the column
   * that makes a non-seller learner possible at all.
   * ⚠ IT WAS ADDED NULLABLE, BACKFILLED, VERIFIED AT ZERO NULLS, AND ONLY THEN
   * ENFORCED — four steps, three pushes and a data step between them. Enforcing
   * first would either have failed on the seven existing rows or, worse, succeeded
   * by inventing a default owner for a credential.
   */
  user_id             String    @db.Uuid
  /**
   * ⚠ NULLABLE NOW. A learner with no seller profile has no value for it, and a
   * seller who stops selling keeps their credentials with the link nulled rather
   * than the row deleted — see the relation's `onDelete` below.
   */
  provider_profile_id String?   @db.Uuid
  name                String
  /// The certifying agency / issuing body (e.g. "Oracle", "PMI").
  issuer              String?
  /// Legacy year-only field; superseded by `issued_on`, kept so pre-brief_U
  /// rows still read.
  year                Int?
  issued_on           DateTime?
  /// Credential number / badge id, and a public verification link.
  credential_id       String?
  url                 String?
  expires_on          DateTime?
  /// Scanned certificate in the private `certifications` bucket — an object
  /// path, not a URL, since the bucket is private (same rule as résumés).
  attachment_path     String?
  attachment_name     String?
  notes               String?
  created_at          DateTime  @default(now())

  /// LEARN CREDENTIALS (brief_learn_v1 WS0/WS5) — extension, not a fork. A
  /// certificate earned on Learn is a certification; giving it a parallel model
  /// would mean the provider's profile had two Certifications sections that
  /// looked identical and behaved differently.
  ///
  /// `issued_from` is what tells them apart: SELF_REPORTED is a claim the
  /// provider typed, LEARN is one Panameer issued and can therefore vouch for.
  /// Only the second gets a verify URL.
  issued_from           CredentialSource @default(SELF_REPORTED)
  /// The path this credential was earned against (LEARN rows only).
  learning_path_id      String?          @db.Uuid
  /// The hosted, publicly checkable credential page (`/verify/[id]`), separate
  /// from `url` above — that one is wherever the provider's own certificate
  /// lives, this one is ours and we are accountable for it.
  public_credential_url String?

  /**
   * ⚠ `onDelete: Cascade` ON THE **USER**, AND IT IS A DECISION, NOT A DEFAULT.
   * The credential belongs to the person. Deleting the person removes it — which
   * is the same property that makes cascading from the SELLER PROFILE wrong:
   * ceasing to sell is not ceasing to exist. It is also what an account-deletion
   * request requires; `Restrict` would make deleting a user fail until somebody
   * hand-removed their certificates, turning a right into a support ticket.
   * ⚠ THE VERIFY URL IS THE COUNTER-ARGUMENT AND IT LOSES ON PURPOSE. Panameer is
   * accountable for `/verify/{id}`, so a deleted user leaves a dead verify page.
   * That is correct: the page attests that a NAMED PERSON earned something, and
   * when that person is erased the attestation has no subject. A credential that
   * outlived its holder would be a public record of someone who asked to be
   * removed.
   */
  /**
   * /**
   * /**
   * /**
   * /**
   * ⚠⚠ REQUIRED, NOT `User?`, AND THE `?` WAS A REAL DEFECT (`P1-J3-E028`).
   * `user_id String @db.Uuid` above is NOT NULL and so is the FK. Prisma accepts an
   * optional relation field over a required scalar without complaint, and then
   * types it `user: Prisma.$UserPayload<ExtArgs> | null` — so the CLIENT said a
   * credential may have no owner while the COLUMN said it must have one.
   * ⚠ THAT PARTLY UNDID WHAT `c68fad4` BOUGHT. WS1 of that brief made
   * `Certification.user_id` the owner precisely to remove the ambiguity about who
   * holds a credential; an optional relation field put the ambiguity back one layer
   * up, in the only place a reader actually looks.
   * ⚠ IT HAD ALREADY PRODUCED A FALLBACK FOR AN IMPOSSIBLE CASE —
   * `app/verify/[credentialId]/page.tsx` read `cert.user?.person ?? null`, handling
   * a null the database cannot produce. Every future `include: { user: true }` would
   * have inherited the optional and the compiler would never have forced a reader to
   * deal with the owner.
   * ⚠ THE DATABASE DID NOT CHANGE. `prisma migrate diff` against the live schema
   * emitted an EMPTY migration — the column and the FK were always correct. This is
   * a client-typing fix only.
   * ⚠ DO NOT "FIX" IT BACK TO `User?`. If a compiler error says the owner might be
   * null, the reader is wrong, not this line.
   * ⚠ `providerProfile` BELOW STAYS OPTIONAL AND ITS GUARDS STAY — that link IS
   * genuinely nullable (`SetNull`), and a learner with no seller profile earning a
   * real credential is the whole point of `c68fad4`.
   */
  user            User             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  /**
   * ⚠ `SetNull`, NOT `Cascade` — THIS IS HOW THE PROVIDER CASCADE STOPS REACHING
   * `LEARN` ROWS. Deleting a provider profile now NULLS the link and keeps the
   * row, so a Panameer-issued credential survives its holder ceasing to sell.
   * ⚠ IT APPLIES TO `SELF_REPORTED` ROWS TOO, and that is coherent rather than
   * collateral: a self-reported certification is still the PERSON'S claim, and
   * `user_id` still holds it. Postgres cannot express "cascade only where
   * issued_from = SELF_REPORTED", and a partial rule would be a worse thing to
   * reason about than one that is the same for both.
   */
  providerProfile ProviderProfile? @relation(fields: [provider_profile_id], references: [id], onDelete: SetNull)
  learningPath    LearningPath?    @relation(fields: [learning_path_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([provider_profile_id])
  @@index([learning_path_id])
  @@map("certifications")
}

/// A buyer's marketplace profile (1:1 with a Person that is a service buyer).
/// Photo/location live on Person/Address; billing is stubbed (out of scope).
/// SMS phone-verification challenge (brief_P / E019). Mirrors the
/// VerificationToken pattern from brief_E: we store only a SHA-256 HASH of the
/// 6-digit code, never the code itself. Issuing a new code invalidates prior
/// unconsumed ones for the same Person.
model PhoneVerification {
  id          String    @id @default(uuid()) @db.Uuid
  person_id   String    @db.Uuid
  /// E.164 number the code was sent to. Kept so a code can't be replayed
  /// against a different number after the user edits the field.
  phone       String
  code_hash   String
  expires_at  DateTime
  consumed_at DateTime?
  /// Wrong-code submissions; the challenge dies at the cap (anti-brute-force).
  attempts    Int       @default(0)
  created_at  DateTime  @default(now())

  person Person @relation(fields: [person_id], references: [id], onDelete: Cascade)

  @@index([person_id])
  @@map("phone_verifications")
}

/// One résumé / LinkedIn-PDF import attempt (brief_P / E012).
///
/// `gaps` is what the review page surfaces (E019): fields we could not decipher
/// or had to strip. Keeping the attempt (and its extracted text) means a parse
/// can be re-run or audited without asking the user to upload again.
model ProfileImport {
  id                  String              @id @default(uuid()) @db.Uuid
  provider_profile_id String              @db.Uuid
  source              ProfileImportSource
  status              ProfileImportStatus @default(PENDING)
  file_name           String?
  mime_type           String?
  size_bytes          Int?
  /// Object path in the PRIVATE `resumes` bucket (brief_Q). Not a URL — the
  /// bucket is private because a résumé carries address/phone/employment data;
  /// reads go through a short-lived signed URL. Null when the upload failed,
  /// which never blocks an import whose parse succeeded.
  storage_path        String?
  /// Plain text extracted from the document, for re-parsing / debugging.
  raw_text            String?
  /// Structured result of the parse: what landed, and what didn't.
  parsed              Json?
  /// Human-readable list of import gaps shown on the review page.
  gaps                Json?
  /**
   * WS-G — WHAT PRODUCED THIS PARSE. Recorded at parse time because the audit is
   * written later, at review-save, and by then the call is long gone. Null for
   * heuristic parses, which cost nothing and have no model.
   */
  ai_model            String?
  ai_provider         String?
  ai_input_tokens     Int?
  ai_output_tokens    Int?
  ai_cost_usd         Decimal?            @db.Decimal(10, 6)
  ai_latency_ms       Int?
  error               String?
  created_at          DateTime            @default(now())
  updated_at          DateTime            @updatedAt

  providerProfile ProviderProfile @relation(fields: [provider_profile_id], references: [id], onDelete: Cascade)

  @@index([provider_profile_id])
  @@map("profile_imports")
}

/// The REQUESTER — the buyer-side actor who asks for work (P1-J1.2).
///
/// A sibling of BuyerProfile rather than columns on it: the two are different
/// jobs on the same side of the marketplace (Requester asks, Buyer supports the
/// buying), and the requester carries fields — employee id, the buyer they work
/// under, a named approver, a deliver-to — that mean nothing for the other.
///
/// The columns mirror the cXML PunchOutSetupRequest baseline (see
/// `requester_onboarding.md`): `employee_id` is the POSR `User`/`UserId`
/// extrinsic, the ERP-linkage key, and `work_site_id` is its ShipTo. Direct
/// (web) requesters key the same fields here that a punch would carry per
/// transaction, so one model serves both paths.
/// THE REQUESTER WIZARD'S RESUME POINTS, AS A CLOSED SET (`P1-J1.1-E271`).
///
/// This was a free `String`, so nothing stopped a typo from becoming a resume
/// point the wizard could never match, and the admin progression strip
/// (`E256`) cannot be trusted to count buckets that are not enumerable.
///
/// ⚠ `buyer_approver` IS GONE (`E263` removed the step). The values are the
/// four `REQUESTER_STEPS` in `lib/requester-steps.ts` and the two lists must
/// stay in step — that file is the client-safe mirror of this enum.
enum RequesterOnboardingStep {
  company
  requester_info
  work_location
  review
}

model RequesterProfile {
  id             String  @id @default(uuid()) @db.Uuid
  person_id      String  @unique @db.Uuid
  /// ERP user id — the POSR `User`/`UserId` extrinsic. Optional: a direct
  /// requester whose company hasn't connected an ERP has no such id yet.
  employee_id    String?
  /// The buyer this requester works under. A NAME + EMAIL at v1, not a
  /// relation: the buyer may not have a Panameer login yet, and a foreign key
  /// would make onboarding wait on somebody else signing up.
  buyer_name     String?
  buyer_email    String?
  /// The lightweight approval: ONE named approver, no chain (spec, v1).
  approver_name  String?
  approver_email String?
  /// Deliver-to for engagements. Defaults from the requester's own address and
  /// is editable, so it is its own Site rather than a reuse of Person.site.
  work_site_id   String? @db.Uuid

  /// Resume point for the wizard — same save-as-you-go contract the provider
  /// wizard uses, so a half-finished requester lands back where they stopped.
  onboarding_step RequesterOnboardingStep @default(company)
  /// Set when the wizard finishes — the "Ready to Post Work Request" state.
  completed_at    DateTime?

  /// ⚠⚠ A STATUS, AND DELIBERATELY NOT A MECHANISM (`P1-J1.1-E269`).
  ///
  /// Scott, 2026-08-30: *"IDK yet... it might annoy the people we are trying
  /// to get to pay us... so let's set it up as a status."* So the column
  /// exists and the admin board renders it, and NOTHING sets it — there is no
  /// buyer request route, no admin grant route and no email. The provider
  /// side's `validation_status` is a real track with
  /// `validation_requested_at` / `validated_at` behind it; this one is a
  /// placeholder his decision can land on later.
  /// ⚠ SUPERSEDED, quoted not deleted: this said *"IT HAS NO TIMESTAMP ON
  /// PURPOSE. Adding a `validated_at` here would invent the trend data `E257`
  /// explicitly forbids inventing."* That was right on 2026-08-30 morning —
  /// `E257` said STOP rather than invent a timestamp, and this column had none,
  /// so `Validated` was the one buyer status that could not be trended.
  /// Scott then ASKED for it: *"we will need more info from the buyers - TIN for
  /// example. So, yes, timestamp the validated, create the trending report."*
  /// The timestamps below are no longer invented; they are requested.
  validation_status ValidationStatus @default(NOT_REQUESTED)

  /// WHEN A BUYER ASKED TO BE VALIDATED (`P1-J1.1-E269b`).
  ///
  /// ⚠⚠ NOTHING IN THE APP SETS THIS. There is no buyer request flow and no
  /// buyer email — `E269b` is explicit that neither gets built here. It mirrors
  /// the seller's `ProviderProfile.validation_requested_at` so the two sides
  /// have the same shape when the buyer mechanism does arrive.
  validation_requested_at DateTime?

  /// WHEN AN ADMIN GRANTED IT (`P1-J1.1-E269b`).
  ///
  /// ⚠ THIS IS THE `Validated` TREND'S ONLY TIMESTAMP. Without it, three of the
  /// four buyer statuses could be trended and the fourth could not — which is
  /// exactly why `E257` stopped the first time.
  ///
  /// ⚠ WHY THE COLUMN EXISTS AHEAD OF THE FEATURE, in Scott's words:
  /// *"we will need more info from the buyers - TIN for example."* Buyer
  /// validation is heading toward a real verification step — tax id and whatever
  /// else the money path needs. ⚠ THAT STEP IS NOT BUILT AND IS NOT IN THIS
  /// BRIEF. Do not read this column as evidence that it is.
  validated_at DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  person   Person @relation(fields: [person_id], references: [id], onDelete: Cascade)
  workSite Site?  @relation("RequesterWorkSite", fields: [work_site_id], references: [id], onDelete: SetNull)

  @@index([work_site_id])
  @@map("requester_profiles")
}

/// What the parser produced vs what the person actually kept (brief_j14 WS-G).
///
/// One row per review-save. It exists to answer two questions with evidence:
/// how good is the parser, and what does a cheaper model cost us in accuracy —
/// which is otherwise a matter of opinion. The corrections are the signal; this
/// brief deliberately stops at CAPTURING them (no fine-tuning, no few-shot
/// injection, no online learning).
///
/// NO NEW PII. `parsed` and `final` hold the same résumé-derived fields already
/// stored on the profile, and the document itself is referenced by a hash, not
/// copied in again.
model ResumeParseAudit {
  id                  String   @id @default(uuid()) @db.Uuid
  provider_profile_id String   @db.Uuid
  /// SHA-256 of the extracted text — lets two runs over the same document be
  /// compared without storing the document twice.
  resume_hash         String
  model               String
  provider            String
  input_tokens        Int?
  output_tokens       Int?
  cost_usd            Decimal? @db.Decimal(10, 6)
  latency_ms          Int?
  /// The model's output, as the review step received it.
  parsed              Json
  /// What the person saved after editing it.
  final               Json
  /// Field-level tally: { employers: {kept, changed}, education: {...}, ... }
  changed             Json
  /// Share of compared fields kept exactly as parsed, 0–1. Denormalised so the
  /// health card doesn't recompute every row on every render.
  accuracy            Float?
  created_at          DateTime @default(now())

  providerProfile ProviderProfile @relation(fields: [provider_profile_id], references: [id], onDelete: Cascade)

  @@index([provider_profile_id])
  @@index([created_at])
  @@map("resume_parse_audits")
}

model BuyerProfile {
  id                String           @id @default(uuid()) @db.Uuid
  person_id         String           @unique @db.Uuid
  subscription_tier SubscriptionTier @default(BASIC)
  /// Set when the buyer starts a Business Plus trial (brief_G). No billing yet.
  trial_started_at  DateTime?
  created_at        DateTime         @default(now())
  updated_at        DateTime         @updatedAt

  person Person @relation(fields: [person_id], references: [id], onDelete: Cascade)

  @@map("buyer_profiles")
}

enum SubscriptionTier {
  BASIC
  BUSINESS_PLUS
}

// ---------------------------------------------------------------------------
// Coordinator → provider invites (brief_I)
//
// A Service Coordinator invites a provider by email; a tokenized link (stored
// HASH-ONLY, like VerificationToken) lets the invitee accept. On acceptance the
// provider's ProviderProfile.coordinator_person_id is set to the inviter. The
// coordinator↔provider relationship is a nullable FK (one coordinator per
// provider for V1, matching the singular selling_agent in the Work Data File).
// ---------------------------------------------------------------------------

model CoordinatorInvite {
  id                   String                  @id @default(uuid()) @db.Uuid
  inviter_person_id    String                  @db.Uuid
  invitee_email        String
  invitee_first_name   String?
  invitee_last_name    String?
  message              String?
  /// SHA-256 of the raw token; the raw token lives only in the emailed link.
  token_hash           String                  @unique
  status               CoordinatorInviteStatus @default(PENDING)
  expires_at           DateTime
  /// The ProviderProfile that accepted (record-keeping; not a FK relation).
  accepted_provider_id String?                 @db.Uuid
  created_at           DateTime                @default(now())
  updated_at           DateTime                @updatedAt

  inviter Person @relation("CoordinatorInvitesSent", fields: [inviter_person_id], references: [id], onDelete: Cascade)

  @@index([inviter_person_id])
  @@index([invitee_email])
  @@map("coordinator_invites")
}

enum CoordinatorInviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

// ---------------------------------------------------------------------------
// Work Requests (brief_L) — a Service Buyer's titled, scoped request for a
// service, targeting the catalog taxonomy (RoleType + Skills).
//
//   Buyer (Person is_service_buyer) → WorkRequest (DRAFT → POSTED) → skills
//
// DRAFT is private, fenced by p_account_id (scopedToPAccount). POSTED is the
// finish line for this brief — a marketplace surface with NO provider-facing UI
// yet (browse/apply is a later brief). Money is stored in integer cents.
//
// Step-collected fields (role_type_id, experience_level, budget_type, worksite,
// duration, …) are NULLABLE so a DRAFT can be built save-as-you-go; `title`
// defaults to "" for the same reason. Post enforces the required subset.
// ---------------------------------------------------------------------------

model WorkRequest {
  id                  String               @id @default(uuid()) @db.Uuid
  buyer_person_id     String               @db.Uuid
  p_account_id        String               @db.Uuid
  role_type_id        String?              @db.Uuid
  /// THE DOMAIN of the Role → Domain → Skill cascade
  /// (brief_create_work_request_v1 WS-A).
  ///
  /// Named `pillar_id`, not `domain_id`, deliberately: the catalog's Domain
  /// entity IS `Pillar` in this schema, and `Skill.pillar_id` already points at
  /// it. One relation under two names is how the next person writes a join
  /// against a column that does not exist.
  ///
  /// Persisted rather than inferred from the chosen skills. A request whose
  /// skills are later edited would otherwise silently change domain, and the
  /// requester's actual answer to "what service domain are you requesting" is
  /// worth keeping.
  pillar_id           String?              @db.Uuid
  region_id           String?              @db.Uuid
  title               String               @default("")
  description         String?
  experience_level    ExperienceLevel?
  budget_type         BudgetType?
  /// The single figure the first wizard wrote. Kept for back-compat; the range
  /// below is what the current flow writes.
  budget_amount_cents Int?
  /// BUDGET AS A RANGE (deck's From / To). Nullable on purpose — the budget
  /// step has a "not ready to set one" escape, and a request with no budget is
  /// a real state rather than an incomplete one.
  budget_min_cents    Int?
  budget_max_cents    Int?
  currency            String               @default("USD")
  worksite            WorksiteType?
  location_country    String?
  duration            WorkRequestDuration?
  /// When the work runs. `duration` (the coarse enum) stays: a requester who
  /// knows "3-6 months" but not the dates can still answer.
  start_date          DateTime?
  end_date            DateTime?
  /// RESERVED FOR THE ERP BRIDGE. UNSPSC is the classification punch-out and
  /// cXML carry, and it will be derived from the catalog selection rather than
  /// typed. Null for now — reserving the column keeps the web-created request
  /// shaped like the one an ERP will send.
  unspsc_code         String?
  status              WorkRequestStatus    @default(DRAFT)
  posted_at           DateTime?

  /// ── CONFIDENTIAL HIRING (`P1-J4-E025`) ────────────────────────────────────
  /// Some buyers cannot name the company while they are hiring. This is the
  /// SAME three-state pattern `Project.client_visibility` already runs, on the
  /// SAME `ClientVisibility` enum — deliberately not a second mechanism — and
  /// `lib/plus.ts:clientNameVisibility()` is reused verbatim to resolve it.
  /// ⚠⚠ IT GOVERNS THE COMPANY NAME AND NOTHING ELSE. It never hides the
  /// person, the standing counts, the industry, or the verification state. A
  /// request that hid all of those would be the scam this brief exists to stop.
  company_visibility  ClientVisibility     @default(PUBLIC)
  /// Shown INSTEAD of the company name when confidential — the buyer-side twin
  /// of `Project.code_name`. Null renders a neutral placeholder rather than a
  /// blank, so the row never reads as missing data.
  company_code_name   String?
  created_at          DateTime             @default(now())
  updated_at          DateTime             @updatedAt

  buyer           Person                      @relation(fields: [buyer_person_id], references: [id], onDelete: Cascade)
  pAccount        PAccount                    @relation(fields: [p_account_id], references: [id], onDelete: Cascade)
  roleType        RoleType?                   @relation(fields: [role_type_id], references: [id], onDelete: SetNull)
  pillar          Pillar?                     @relation(fields: [pillar_id], references: [id], onDelete: SetNull)
  region          Region?                     @relation(fields: [region_id], references: [id], onDelete: SetNull)
  skills          WorkRequestSkill[]
  specializations WorkRequestSpecialization[]

  @@index([p_account_id])
  @@index([buyer_person_id])
  @@index([status])
  @@map("work_requests")
}

/// Join: a taxonomy Skill targeted by a WorkRequest (mirrors ProviderSkill).
/// Skills must share the request's role_type_id (enforced on write).
model WorkRequestSkill {
  id              String   @id @default(uuid()) @db.Uuid
  work_request_id String   @db.Uuid
  skill_id        String   @db.Uuid
  created_at      DateTime @default(now())

  workRequest WorkRequest @relation(fields: [work_request_id], references: [id], onDelete: Cascade)
  skill       Skill       @relation(fields: [skill_id], references: [id], onDelete: Cascade)

  @@unique([work_request_id, skill_id])
  @@index([skill_id])
  @@map("work_request_skills")
}

enum BudgetType {
  FIXED
  HOURLY
}

enum WorksiteType {
  REMOTE
  ONSITE
  HYBRID
}

enum WorkRequestDuration {
  LT_1_MONTH
  ONE_TO_3_MONTHS
  THREE_TO_6_MONTHS
  GT_6_MONTHS
}

enum WorkRequestStatus {
  DRAFT
  POSTED
}

// ===========================================================================
// LEARN (P1-J3) — brief_learn_v1 WS0
//
// The certifiable spine is LearningPath → Course → Section → Lesson, ordered
// within each parent by `sort_order`. AUDIENCE, GROUP and STYLE are FACETS on
// that spine, not extra levels (design doc §3): making "Beginners" a container
// would force every path to belong to exactly one, and the catalog already has
// paths that read for two audiences.
//
// Videos stay on Vimeo. We store a reference and never the media itself.
// ===========================================================================

/// The catalog's "Course Type" / menu facet.
enum LearnAudience {
  BEGINNERS
  END_USER
  IMPLEMENTER
  CONTENT_CREATOR
}

/// Course shape, per the catalog's Style/Type column.
enum CourseStyle {
  FA_OVERVIEW
  HOW_TO_USE
  HOW_TO_DEPLOY
  DAILY_JOURNAL
  ASK_THE_EXPERT
  /// WS2.1 — the catalog's "Conceptual" style (Finance / EndUser SCE sheets use
  /// it for 15 courses). It was left NULL by the WS1 import because no enum
  /// member existed, so those courses carried no style at all rather than a
  /// wrong one; this is the member they were waiting for.
  CONCEPTUAL
}

/// The catalog's 0→7 production ladder, mirrored VERBATIM so the vocabulary in
/// the app matches the vocabulary in Scott's spreadsheet — a lesson at "3" means
/// the same thing in both places, and nobody has to translate.
///
/// NEEDS_REFRESH is the spreadsheet's "0b": produced once, now stale. It sorts
/// with the other pre-production states because that is what it behaves like.
///
/// PUBLISHABLE THRESHOLD: a lesson plays iff `production_status` is at least
/// URL_ADDED_TO_LESSON *and* `vimeo_ref` is set. Both halves are required —
/// the status says someone believes a URL was added, the column says one is
/// actually there, and the catalog has rows where those disagree.
enum LessonProductionStatus {
  IN_CONCEPT
  NEEDS_REFRESH
  DECK_READY
  RAW_SHOT
  PRODUCED
  LOADED_TO_STREAMING
  URL_ADDED_TO_LESSON
  BLOG_CREATED
  BLOG_RELEASED
}

/// Where a Certification row came from, so a Learn-issued credential is
/// distinguishable from one the provider typed in themselves.
enum CredentialSource {
  SELF_REPORTED
  LEARN
}

enum LearnPublishStatus {
  DRAFT
  PUBLISHED
}

/// The CERTIFIABLE unit. A learner enrols in a path and is certified against it.
model LearningPath {
  id               String             @id @default(uuid()) @db.Uuid
  title            String
  slug             String             @unique
  summary          String?
  /// Facets — see the block comment above.
  audience         LearnAudience
  /// ── ⚠ RESOLVED CROSS-BRANCH CARRY (`P1-ALL-E372`), KEPT AS A RECORD ───────
  ///
  /// ⚠ SUPERSEDED 2026-09-03, QUOTED NOT DELETED. `E372` reproduced the `pillar`
  /// field VERBATIM on its own branch because the two branches share one dev
  /// database and `E364` had already pushed the column with 16 non-null values —
  /// without the carry, `prisma db push` from `E372` tried to DROP it: *"You are
  /// about to drop the column `pillar` on the `learning_paths` table, which still
  /// contains 16 non-null values."* ⚠⚠ `--accept-data-loss` WAS NOT USED.
  /// ⚠ THAT CARRY IS NOW SPENT. `E364` merged FIRST (`2e6b643`) and this merge
  /// resolved to a comment-only conflict with the field itself identical on both
  /// sides — the no-op it was designed to be. The 16 values were re-counted after
  /// the merge and survived.
  /// ⚠ THE LESSON, WHICH IS WHY THIS STAYS: a brief's hold condition named
  /// `nav.ts`, but the real collision between two branches was THE SHARED SCHEMA.
  /// Two branches touching one dev database collide through Postgres, not through
  /// git — check the columns, not just the file list.
  /// ── ⚠ THE TOP OF THE TAXONOMY (`P1-J3-E364`) ──────────────────────────────
  ///
  /// Oracle's product families: `SCM`, `ERP`, `HCM`, plus `FOUNDATIONS` for the
  /// beginner paths — which is NOT a pillar and is deliberately in the same
  /// field anyway. Scott, 2026-09-02: *"yeah...i know this is not a pillar."* A
  /// learner picks from ONE list, not two.
  ///
  /// ⚠ `group` BELOW IS UNCHANGED and stays the functional area. `/learn`'s row
  /// toggles between the two slices; neither replaces the other.
  /// ⚠ NULLABLE, AND A NULL IS HONEST: a path whose group is not in `E364`'s
  /// mapping keeps `null` rather than being guessed into a family. Every one of
  /// them today has zero playable lessons, so `E362` already hides it from a
  /// learner — but the null is what makes that visible instead of invented.
  /// ⚠ EPM AND CX ARE REAL ORACLE PILLARS WITH NOTHING ON PANAMEER. They are not
  /// values here and not tiles on the page; the row carries one honest sentence
  /// instead. Same rule `E282` set with Delaware — say what you cannot do rather
  /// than hide it, without giving an empty thing equal weight to a full one.
  pillar           String?
  /// Free-string domain tag (Procurement, Supply Chain Execution, Core HR, …).
  /// Deliberately NOT an enum: the catalog adds groups faster than a migration
  /// can, and WS1 imports whatever the spreadsheet says.
  group            String?
  /// The instructor. A Person, so an expert can front paths without needing a
  /// provider profile.
  expert_person_id String?            @db.Uuid
  cover_image      String?
  /// Optional intro video for the path itself (same loose Vimeo reference the
  /// Lesson uses — see `vimeoEmbedUrl`). A path can front its curriculum with a
  /// "what you'll learn" clip without that clip being a lesson in the outline.
  intro_video_ref  String?
  status           LearnPublishStatus @default(DRAFT)
  sort_order       Int                @default(0)
  created_at       DateTime           @default(now())
  /// XLS-RE-RUN SHIELD (WS1). The catalog is seed-driven, but the admin console
  /// (brief_learn_admin_authoring) will edit the same rows. A re-import is
  /// authoritative only for rows it created: anything flagged `is_custom` was
  /// touched by a human and an XLS re-run leaves it alone. Same rule the service
  /// taxonomy uses.
  is_custom        Boolean            @default(false)

  expert      Person?           @relation("LearnExpertPaths", fields: [expert_person_id], references: [id], onDelete: SetNull)
  courses     Course[]
  enrollments LearnEnrollment[]
  credentials Certification[]
  assessment  LearnAssessment?

  @@index([audience, group])
  @@index([status])
  @@map("learning_paths")
  /// ⚠ `P1-J3-E383` — a path's forum. At most ONE; `check:forums` asserts it and
  /// mutation-tests the second, because two rooms for one conversation splits
  /// the people who found the first.
  forumBoards ForumBoard[]

}

/// A path may hold exactly ONE course — the catalog sometimes collapses
/// "Learning Path = Course", and forcing an artificial second level there would
/// invent structure the content doesn't have.
model Course {
  id               String  @id @default(uuid()) @db.Uuid
  learning_path_id String  @db.Uuid
  title            String
  slug             String
  summary          String?
  /// Card art for this course. Every level of the hierarchy carries its own
  /// image (brief_learn_admin_authoring, Core content model): an instructor
  /// photo, topic art, whatever the admin uploads. Null falls back to the
  /// level above at render time, so an unset thumbnail degrades to the path's
  /// cover rather than to a hole in the grid.
  thumbnail_url    String?
  /// Optional course intro video — same loose Vimeo reference as Lesson.
  intro_video_ref  String?

  /**
   * ⚠ ORACLE'S OWN DOCUMENTATION FOR THIS APPLICATION, as assessment source
   * material (brief_learn_assessments_generate WS1).
   * ── WHY IT IS NEEDED ────────────────────────────────────────────────────────
   * `buildAssessmentSource`'s own comment admits the problem: *"Lesson TITLES
   * carry most of the signal in this catalog — descriptions are sparse and many
   * are empty."* Measured: 290 of 522 lessons have NO description. So the model
   * is asked to write a graded assessment from strings like `"STEP 3 - How to
   * Create a Qualification Area"`. It will produce plausible questions that test
   * the TITLE rather than the lesson.
   * Oracle documents these applications precisely — the Qualification Areas
   * topic states the four statuses (Draft/Active/Inactive/Archived), that scored
   * question weights must add up to 100, and the knockout-score rule. Verified
   * against the live docs: 17,841 characters of exactly the right kind of
   * material. That is what these columns hold.
   * ── ⚠ PER COURSE, NOT PER LESSON ────────────────────────────────────────────
   * A course maps to one Oracle application. 522 lesson-level fetches would be
   * both wrong and rude to a server doing us a favour.
   * ── ⚠ COUNSEL GATE, UNRESOLVED ──────────────────────────────────────────────
   * Storing Oracle's documentation text in Panameer's database and generating
   * derived, GRADED assessment content from it is a LICENSING question and it is
   * not answered. The columns exist and the fetch path works; exactly ONE course
   * is populated as a demonstration, deliberately, and nothing is bulk-populated
   * until that question is cleared. `doc_source_url` sits beside the text so
   * provenance is never inferred.
   * ⚠ VERSION-PINNED ORACLE URLS ROT. Measured: `25a` for this same topic
   * 302-redirects to a "Get Started" landing page. The fetcher asserts the final
   * URL is still the requested topic and refuses to store a landing page.
   */
  doc_source_url  String?
  doc_source_text String?
  doc_fetched_at  DateTime?

  style      CourseStyle?
  sort_order Int          @default(0)
  created_at DateTime     @default(now())
  /// XLS-RE-RUN SHIELD (WS1). The catalog is seed-driven, but the admin console
  /// (brief_learn_admin_authoring) will edit the same rows. A re-import is
  /// authoritative only for rows it created: anything flagged `is_custom` was
  /// touched by a human and an XLS re-run leaves it alone. Same rule the service
  /// taxonomy uses.
  is_custom  Boolean      @default(false)

  learningPath LearningPath @relation(fields: [learning_path_id], references: [id], onDelete: Cascade)
  sections     Section[]

  @@unique([learning_path_id, slug])
  @@index([learning_path_id])
  @@map("learn_courses")
}

model Section {
  id            String   @id @default(uuid()) @db.Uuid
  course_id     String   @db.Uuid
  title         String
  /// Section-level copy. The XLS gives sections nothing but a title, so this is
  /// admin-authored only — it exists because the brief requires text at EVERY
  /// level, and a section is where "what this group of lessons is for" belongs.
  description   String?
  thumbnail_url String?
  sort_order    Int      @default(0)
  created_at    DateTime @default(now())
  /// XLS-RE-RUN SHIELD (WS1). The catalog is seed-driven, but the admin console
  /// (brief_learn_admin_authoring) will edit the same rows. A re-import is
  /// authoritative only for rows it created: anything flagged `is_custom` was
  /// touched by a human and an XLS re-run leaves it alone. Same rule the service
  /// taxonomy uses.
  is_custom     Boolean  @default(false)

  course  Course   @relation(fields: [course_id], references: [id], onDelete: Cascade)
  lessons Lesson[]

  /// The XLS carries no ids, so (course, title) IS a section's identity — it is
  /// what makes a re-import an UPDATE rather than a duplicate.
  @@unique([course_id, title])
  @@index([course_id])
  @@map("learn_sections")
}

model Lesson {
  id                String                 @id @default(uuid()) @db.Uuid
  section_id        String                 @db.Uuid
  title             String
  description       String?
  /// As written in the catalog ("12:34", "1h 05m") — free text on purpose: it is
  /// display copy from a spreadsheet, and parsing it to seconds would invent a
  /// precision the source doesn't have.
  run_time          String?

  /// ── ⚠⚠ A NUMERIC LENGTH, SO IT CAN BE SUMMED (`P1-J3-E361`) ──────────────
  ///
  /// SCOTT, 2026-09-02: *"people will ask it more than anything else."* No
  /// surface could say *"24 minutes left in this course"* because there was no
  /// number anywhere — only `run_time`, which is spreadsheet DISPLAY COPY and
  /// really does contain `Intro`, `NA`, `Done` and `Incomplete`.
  ///
  /// ⚠⚠ `run_time` ABOVE IS NOT TOUCHED, NOT DEPRECATED AND NOT DELETED. It
  /// keeps rendering verbatim wherever it renders today, and `check:learn`
  /// GUARD 1's ban on SUMMING it stays exactly as written — that ban is
  /// permanent and correct. This is a SEPARATE field, and
  /// `lib/lesson-duration.ts` is the only thing that turns one into the other.
  ///
  /// ⚠ THE STORED XLS VALUES ARE EXACTLY 60× TOO LARGE — Scott typed `2:13`
  /// into a cell formatted as hours-and-minutes. Measured against Vimeo's oEmbed
  /// endpoint: `2:13:00` -> 133 s and Vimeo says 133 s, to the second.
  /// ⚠ CAPPED AT TWO HOURS on write. A longer "lesson" is far likelier to be a
  /// bad cell than a real video.
  duration_seconds Int?
  /// Where the number came from — `"xls"` or `"vimeo"`. ⚠ NEVER GUESSED, and a
  /// duration without a source is a number nobody can defend; `check:duration`
  /// fails the build if one exists without the other.
  duration_source  String?
  /// Poster art for the lesson. NOT the Vimeo thumbnail: a lesson can need a
  /// card image long before it has a video, which is most of the catalog today.
  thumbnail_url     String?
  /// Vimeo video id or embed URL. Null until the video is wired.
  vimeo_ref         String?
  production_status LessonProductionStatus @default(IN_CONCEPT)
  expert_person_id  String?                @db.Uuid
  sort_order        Int                    @default(0)
  created_at        DateTime               @default(now())
  /// XLS-RE-RUN SHIELD (WS1). The catalog is seed-driven, but the admin console
  /// (brief_learn_admin_authoring) will edit the same rows. A re-import is
  /// authoritative only for rows it created: anything flagged `is_custom` was
  /// touched by a human and an XLS re-run leaves it alone. Same rule the service
  /// taxonomy uses.
  is_custom         Boolean                @default(false)

  section  Section          @relation(fields: [section_id], references: [id], onDelete: Cascade)
  expert   Person?          @relation("LearnExpertLessons", fields: [expert_person_id], references: [id], onDelete: SetNull)
  progress LessonProgress[]

  /// Same reasoning as Section: (section, title) is a lesson's natural key.
  @@unique([section_id, title])
  @@index([section_id])
  @@index([production_status])
  @@map("learn_lessons")
}

/// Free enrolment — a join row, not billing. Enrolment is what turns an
/// anonymous browser into an account (WS4), so it is keyed to the User rather
/// than to any one profile: a buyer, a provider and a recruiter all learn.
model LearnEnrollment {
  id               String   @id @default(uuid()) @db.Uuid
  user_id          String   @db.Uuid
  learning_path_id String   @db.Uuid
  created_at       DateTime @default(now())

  user         User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  learningPath LearningPath @relation(fields: [learning_path_id], references: [id], onDelete: Cascade)

  @@unique([user_id, learning_path_id])
  @@index([user_id])
  @@map("learn_enrollments")
}

/// One row per lesson a user has finished. Section / Course / LP percentages are
/// COMPUTED from these, never stored: a stored rollup goes stale the moment a
/// lesson is added to a path, and the catalog is still being written.
/// AI-GENERATED ASSESSMENT for a Learning Path (brief_learn_experience WS5).
///
/// The question set is CACHED, not generated per attempt. Three reasons, in
/// order of importance: every learner sitting the same test is the only way a
/// pass means the same thing twice; regenerating per attempt would let someone
/// reroll until they got an easy set; and a model call per attempt is a cost
/// and a latency for no gain. Regeneration is therefore an explicit admin act,
/// not a side effect of someone taking the test.
model LearnAssessment {
  id               String   @id @default(uuid()) @db.Uuid
  learning_path_id String   @unique @db.Uuid
  /// The generated questions. JSON rather than a Question table on purpose:
  /// a set is written once by the model, read whole, and replaced whole — it
  /// is never queried across rows, so relational shape would buy nothing and
  /// cost a migration every time the question format changes.
  questions        Json
  /// Which model wrote it and when, so a bad set can be traced and rebuilt.
  model            String?
  generated_at     DateTime @default(now())
  /// Percentage needed to pass, and how many tries before a learner is locked
  /// out. Per-path so a short path isn't held to a long one's bar.
  pass_threshold   Int      @default(70)
  max_attempts     Int      @default(3)

  /**
   * ⚠ A GENERATED TEST NOBODY HAS READ MUST NOT AWARD A CERTIFICATE
   * (brief_learn_assessments_generate WS4).
   * Scott's constraint stands — he will not hand-build question banks — and
   * REVIEW IS NOT AUTHORING. Reading twenty questions is minutes; writing them is
   * days. So generation stays automatic and PUBLISHING is the human act.
   * ⚠ DEFAULT DRAFT, AND THAT RE-GATES THE ONE EXISTING SET. The single
   * assessment in the database was model-written and never reviewed, so on this
   * push it becomes DRAFT and its test stops being sittable until somebody reads
   * it. That is the column doing its job rather than a side effect of it, and the
   * certificate already issued from it is untouched.
   */
  status      LearnPublishStatus @default(DRAFT)
  /**
   * ⚠ THE MISSING FIELD `P1-J2.4-E024` NEEDS. That walk error records the EXPERT
   * badge — "created assessment" — as unbuildable because this model recorded
   * only WHICH MODEL wrote the set, never which human stood behind it. This is
   * the column that makes the badge earnable. The badge itself is not built here.
   */
  reviewed_by String?            @db.Uuid
  reviewed_at DateTime?
  /**
   * Which documentation URLs, if any, informed this set. Provenance, not prose.
   */
  source_note String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  learningPath LearningPath       @relation(fields: [learning_path_id], references: [id], onDelete: Cascade)
  reviewer     Person?            @relation("LearnAssessmentReviewer", fields: [reviewed_by], references: [id], onDelete: SetNull)
  attempts     LearnTestAttempt[]

  @@index([status])
  @@map("learn_assessments")
}

/// One sitting of a path's test.
///
/// Answers are kept, not just the score. A learner who narrowly fails deserves
/// to be told WHICH questions they missed, and a question the whole cohort gets
/// wrong is a signal about the lesson, not the learner.
model LearnTestAttempt {
  id               String   @id @default(uuid()) @db.Uuid
  assessment_id    String   @db.Uuid
  user_id          String   @db.Uuid
  learning_path_id String   @db.Uuid
  /// 0-100.
  score            Int
  passed           Boolean
  /// [{ questionId, chosen, correct }] — enough to show a review screen.
  answers          Json
  created_at       DateTime @default(now())

  assessment LearnAssessment @relation(fields: [assessment_id], references: [id], onDelete: Cascade)
  user       User            @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, learning_path_id])
  @@index([assessment_id])
  @@map("learn_test_attempts")
}

model LessonProgress {
  id           String   @id @default(uuid()) @db.Uuid
  user_id      String   @db.Uuid
  lesson_id    String   @db.Uuid
  completed_at DateTime @default(now())

  user   User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lesson_id], references: [id], onDelete: Cascade)

  @@unique([user_id, lesson_id])
  @@index([user_id])
  @@map("lesson_progress")
}

/// J2.4 WS-F (E012) — a provider asking a contact for a recommendation.
///
/// SAME TOKEN CONTRACT AS PROJECT VALIDATION, deliberately: the recipient has
/// no account, so the emailed link is the entire authorization. 32 bytes of
/// randomness, stored only as a SHA-256 hash, with an expiry. A leaked database
/// yields hashes, not usable links.
///
/// The response lives on the SAME ROW as the request rather than in a separate
/// Testimonial table. A recommendation only exists because somebody was asked
/// for it, and splitting the two would mean a testimonial whose provenance —
/// who asked, when, at what address — sits somewhere else and can drift away
/// from it. The profile's Testimonials section is a query for the SUBMITTED
/// ones, not a different entity.
model RecommendationRequest {
  id                   String               @id @default(uuid()) @db.Uuid
  provider_profile_id  String               @db.Uuid
  /// Captured at send time. The person may later be invited properly, and this
  /// must record who was actually asked.
  contact_name         String
  contact_email        String
  /// Whether that address already belongs to a Panameer account, resolved when
  /// the request is sent. Drives the "create your own profile" invite — an
  /// existing member does not need recruiting.
  contact_off_platform Boolean              @default(true)
  /// The provider's covering note, template or edited.
  message              String
  token_hash           String               @unique
  status               RecommendationStatus @default(SENT)
  expires_at           DateTime
  sent_at              DateTime             @default(now())
  responded_at         DateTime?
  /// ---- the recommendation itself, once given ----
  body                 String?
  recommender_title    String?
  recommender_company  String?
  /// Light provenance on the response. Never shown to the provider — it exists
  /// so a disputed testimonial can be investigated.
  responder_ip         String?
  responder_ua         String?
  created_at           DateTime             @default(now())
  updated_at           DateTime             @updatedAt

  providerProfile ProviderProfile @relation(fields: [provider_profile_id], references: [id], onDelete: Cascade)

  @@index([provider_profile_id])
  @@index([status])
  @@map("recommendation_requests")
}

enum RecommendationStatus {
  SENT
  SUBMITTED
  DECLINED
  EXPIRED
}

enum ProjectPreference {
  ANY
  SHORT_TERM
  LONG_TERM
  CONTRACT_TO_HIRE
}

/// ---------------------------------------------------------------------------
/// J2.4 WS-H — the money and identity surfaces (E016–E019).
///
/// ALL FIVE MODELS HANG OFF `Person`, not off ProviderProfile, and that is the
/// "payee entity" decision made concrete. One login can hold several
/// memberships — provider today, recruiter tomorrow — and a bank account or a
/// tax form belongs to the human being paid, not to one of the hats they wear.
/// Attaching them to the profile would mean a recruiter who also sells their own
/// time filing two W-9s for one taxpayer.
///
/// (The brief notes the payee may be a recruiter's COMPANY. That case needs a
/// company-level payee record and is deliberately not modelled here — see the
/// report; what is here is correct for the individual, which is every provider
/// on the platform today.)
///
/// NO PROCESSOR INTEGRATION. Every one of these captures what the person told
/// us and nothing else: no card numbers, no account numbers, no live money. The
/// last four digits and a label are what a UI needs to say "this one"; storing
/// the rest without a PCI-compliant vault would be a liability, not a feature.
/// ---------------------------------------------------------------------------

model BillingMethod {
  id         String            @id @default(uuid()) @db.Uuid
  person_id  String            @db.Uuid
  kind       BillingMethodKind
  /// What the person calls it — "Amex, personal".
  label      String
  /// Display only. The full number never reaches Panameer.
  last4      String?
  exp_month  Int?
  exp_year   Int?
  is_default Boolean           @default(false)
  created_at DateTime          @default(now())
  updated_at DateTime          @updatedAt

  person Person @relation(fields: [person_id], references: [id], onDelete: Cascade)

  @@index([person_id])
  @@map("billing_methods")
}

enum BillingMethodKind {
  CARD
  PAYPAL
  BANK_DEBIT
}

model PayoutMethod {
  id         String           @id @default(uuid()) @db.Uuid
  person_id  String           @db.Uuid
  kind       PayoutMethodKind
  label      String
  /// Display only, as above.
  last4      String?
  /// Where the money lands — drives which tax form is required.
  country    String
  is_default Boolean          @default(false)
  created_at DateTime         @default(now())
  updated_at DateTime         @updatedAt

  person Person @relation(fields: [person_id], references: [id], onDelete: Cascade)

  @@index([person_id])
  @@map("payout_methods")
}

enum PayoutMethodKind {
  BANK_ACCOUNT
  PAYPAL
  WIRE
}

/// The seller money-gate (E017). A withdrawal method cannot be added until this
/// exists, because paying someone without a tax form on file is the one thing in
/// this area that creates a real obligation for Panameer.
model TaxProfile {
  id          String   @id @default(uuid()) @db.Uuid
  person_id   String   @unique @db.Uuid
  /// W-9 for a US person, W-8BEN / W-8BEN-E for everyone else. Which one is
  /// determined by `country`, not chosen freely — see lib/tax.ts.
  form        TaxForm
  legal_name  String
  country     String
  /// Display only. The TIN itself is not stored: we have no lawful need to hold
  /// it before there is a payment processor that requires it.
  tin_last4   String?
  /// The person's own attestation, with a timestamp. This is a signature.
  signed_name String
  signed_at   DateTime @default(now())
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  person Person @relation(fields: [person_id], references: [id], onDelete: Cascade)

  @@map("tax_profiles")
}

enum TaxForm {
  W9
  W8BEN
  W8BENE
}

/// Identity verification (E019) — the IDV badge, distinct from the "Validated"
/// merit badge. FREE: the Connects cost is stripped, and the KYC partner that
/// would make it cost anything is deferred.
model IdentityVerification {
  id           String    @id @default(uuid()) @db.Uuid
  person_id    String    @unique @db.Uuid
  status       IdvStatus @default(NOT_STARTED)
  /// What the person said they would present. No document is stored — that
  /// waits for a KYC partner with somewhere lawful to put it.
  document     String?
  submitted_at DateTime?
  reviewed_at  DateTime?
  /// Three years from approval, per the brief.
  expires_at   DateTime?
  /// Why a review failed, shown to the person so they can fix it.
  note         String?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  person Person @relation(fields: [person_id], references: [id], onDelete: Cascade)

  @@map("identity_verifications")
}

enum IdvStatus {
  NOT_STARTED
  SUBMITTED
  VERIFIED
  REJECTED
  EXPIRED
}

/// Per-category notification channels (E020).
///
/// A ROW PER (person, category) rather than a wall of booleans on Person: the
/// category list is Panameer's event model and it will grow, and every new
/// event would otherwise be a migration. Absent row = the category's documented
/// default, so a new category ships with sensible behaviour and no backfill.
/// AI AUTONOMY, DECLARED PER EVENT × RECIPIENT (`P1-ALL`, 2026-09-01).
///
/// ⚠⚠ MedLinq's six, adopted wholesale at Scott's prompt. For a product whose
/// pitch is "AI-native", THIS COLUMN IS THE GOVERNANCE MODEL — it is where
/// autonomy is granted or withheld, event by event, on the record.
///
/// ⚠ STORING IT DOES NOT EXECUTE IT. Nothing in this codebase reads `ai_mode` to
/// decide behaviour yet, and nothing in the brief that introduced it does either.
/// It is written so the decision is AUDITABLE the day something does act.
enum NotificationAiMode {
  /// Autonomous. 33 of MedLinq's 58 events are this.
  DO_IT
  REVIEW_IT
  /// AI drafts, a human approves. Used where a row names one person to another,
  /// or broadcasts to many — neither is a thing an AI should send unreviewed.
  SEND_FOR_APPROVAL
  PENDING_GROUP_APPROVAL
  DELEGATE_TO_HUMAN
  NONE
}

/// WHETHER A RECORDED EVENT IS ALSO DELIVERED.
///
/// ⚠⚠ THE EVENT IS RECORDED EVEN WHEN NOTHING IS DELIVERED. A decision NOT to
/// notify is a decision, and writing it down is what stops it being re-litigated
/// on every walk.
enum NotificationVisibility {
  /// Appears in the feed now and counts toward the bell badge.
  FEED
  /// Recorded; does NOT appear and does NOT count. `learn.lesson_completed` is
  /// this — 522 lessons exist and per-lesson delivery is the fastest way to get
  /// muted. ⚠ The digest SENDER is deliberately not built; rows accumulate.
  DIGEST
  /// Recorded, never delivered. `profile.published` is this — the user is looking
  /// at the screen that says it.
  SILENT
}

/// ONE DELIVERED (OR DELIBERATELY UNDELIVERED) EVENT, ADDRESSED TO ONE PERSON.
///
/// ⚠⚠ ONE TABLE, NOT TWO. Scott: *"much of Medlinq's notifications work like
/// Oracle cloud's notifications… or should i say worklist."* An Oracle worklist is
/// not a second inbox — it is the subset of your notifications WAITING ON YOU. So
/// the bell and the worklist are two VIEWS of this one list:
///   · bell     = everything delivered, newest first
///   · worklist = `requires_action && resolved_at IS NULL`
/// Two tables would mean two write paths, two unread counts, and two places for an
/// item to be missed.
///
/// ⚠ ONE ROW PER (EVENT × RECIPIENT), never one row addressed to two people.
/// `learn.course_completed` fires TWICE — to the learner and to the instructor —
/// with different text and different `ai_mode`.
///
/// ⚠ READING IS NOT RESOLVING. `read_at` says they saw it; `resolved_at` says the
/// thing it asked for is done. An actionable row stays on the worklist after it
/// has been read.
model Notification {
  id        String @id @default(uuid()) @db.Uuid
  /// THE RECIPIENT. Always exactly one person.
  person_id String @db.Uuid

  /// e.g. "learn.course_completed" — the key in `lib/notification-events.ts`.
  event_key String
  /// MUST match a key in `lib/notification-categories.ts`; `check:notifications`
  /// fails the build if it does not, because an unknown category would write rows
  /// no settings page can ever reach.
  category  String

  title String
  body  String?
  /// Where the action lives. Null for rows that are purely informational.
  href  String?

  entity_type String?
  entity_id   String? @db.Uuid

  ai_mode    NotificationAiMode     @default(DO_IT)
  visibility NotificationVisibility @default(FEED)

  /// True when this row belongs on the worklist rather than only the bell.
  requires_action Boolean @default(false)

  /// ⚠ IDEMPOTENCY IS A COLUMN, NOT A CONVENTION. Enrolling in a path twice must
  /// not produce two rows — this is also the duplicate-signup fix Scott asked for
  /// on the Learn walk. `notify()` upserts on it; events with no natural key pass
  /// null and always insert.
  dedupe_key String?

  /// Set when the row actually reached the in-app feed. Null means it did not, and
  /// `suppressed_reason` says why.
  delivered_in_app_at DateTime?
  /// ⚠⚠ A DROPPED DELIVERY WITH NO RECORD IS HOW "I NEVER GOT TOLD" BECOMES
  /// UNANSWERABLE. One of: "digest" · "silent" · "user_opted_out" ·
  /// "email_not_configured" · "sms_not_configured".
  suppressed_reason   String?

  read_at     DateTime?
  resolved_at DateTime?
  created_at  DateTime  @default(now())

  person Person @relation(fields: [person_id], references: [id], onDelete: Cascade)

  /// ⚠ NULL `dedupe_key` DOES NOT COLLIDE IN POSTGRES — several nulls are allowed
  /// under a unique index, which is exactly the "always insert" behaviour wanted.
  @@unique([person_id, dedupe_key])
  @@index([person_id, read_at])
  @@index([person_id, requires_action, resolved_at])
  @@map("notifications")
}

model NotificationPreference {
  id         String   @id @default(uuid()) @db.Uuid
  person_id  String   @db.Uuid
  /// Matches a key in lib/notification-categories.ts.
  category   String
  in_app     Boolean  @default(true)
  email      Boolean  @default(true)
  /// SMS is wired to the STUBBED Twilio path — the toggle is real, the send is
  /// not, and the UI says so.
  sms        Boolean  @default(false)
  updated_at DateTime @updatedAt
  created_at DateTime @default(now())

  person Person @relation(fields: [person_id], references: [id], onDelete: Cascade)

  @@unique([person_id, category])
  @@index([person_id])
  @@map("notification_preferences")
}

/// Two-step verification (E018).
///
/// REAL TOTP, not a placeholder: a 20-byte base32 secret, RFC-6238 codes
/// verified server-side with a one-step window. Half-built 2FA is worse than
/// none — it teaches people they are protected when they are not — so this is
/// either genuine or absent, and it is genuine.
///
/// Mobile-push 2FA is deferred with the mobile app that would receive it.
model TwoFactorSetting {
  id           String    @id @default(uuid()) @db.Uuid
  user_id      String    @unique @db.Uuid
  /// Base32. Present as soon as enrolment STARTS; `confirmed_at` is what makes
  /// it live, so an abandoned enrolment never locks anyone out.
  totp_secret  String?
  confirmed_at DateTime?
  /// The security question, with the answer hashed like a password — it is a
  /// credential, and storing it in the clear would make it a worse one.
  question     String?
  answer_hash  String?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("two_factor_settings")
}

/// ---------------------------------------------------------------------------
/// FORUMS (brief_MASTER_rails_and_community PHASE 2 / WS2-C).
///
/// Board → Thread → Post, all hanging off `Person` rather than `User`: a forum
/// post is made by a human being in the marketplace, and Person is the identity
/// every other social surface here (recommendations, coordinator rosters,
/// validations) already uses. Keying to the login would put forum authorship on
/// a different axis from everything it sits beside.
///
/// FORUM PARTICIPATION IS A CREDIT-EARNING EVENT. PHASE 3 posts a `FORUM_POST`
/// ledger entry when a post lands; the hook point is `awardForumPost` in
/// lib/forums.ts, called on every successful create and currently a documented
/// no-op. The models carry no credit columns of their own — the ledger is the
/// record, and a denormalised "credits earned" here would be a second truth to
/// reconcile.
/// ---------------------------------------------------------------------------

model ForumBoard {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  title       String
  description String?
  sort_order  Int      @default(0)
  /// Boards are seeded, not user-created — a forum whose sections anyone can
  /// add fragments before it has enough people to fill the first four.
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  /// ── ⚠⚠ A PATH'S FORUM (`P1-J3-E383`) ────────────────────────────────────
  ///
  /// SCOTT, 2026-09-04: *"every learning path should have a forum."*
  ///
  /// ⚠ NULL = one of the FOUR GENERAL BOARDS. Non-null = this path's board.
  /// `check:forums` asserts the four seed slugs are the only null-path boards,
  /// so a board is always exactly one of the two things — never both, never
  /// neither.
  ///
  /// ⚠⚠ A COLUMN RATHER THAN A `path-<slug>` SLUG CONVENTION. A string
  /// convention works until a path slug changes, and it makes every read a
  /// string parse. The column also gives the board its path's title and link
  /// without a second query.
  ///
  /// ⚠ PER PATH, NOT PER COURSE. 12 paths have playable content against 39
  /// courses, `LearnEnrollment` is already path-level so a path board has a
  /// membership list the schema can produce, and the interesting questions
  /// span courses anyway.
  ///
  /// ⚠⚠ `onDelete: Cascade` IS DELIBERATE, AND `deletePath()`'s EXISTING GUARD
  /// IS WHAT MAKES IT SAFE — it refuses on enrolments, on courses, and (as of
  /// `E383`) on threads. The FK was NOT switched to `Restrict`: the guard is
  /// the place that can explain WHY, and a database error cannot.
  learning_path_id String?       @db.Uuid
  learningPath     LearningPath? @relation(fields: [learning_path_id], references: [id], onDelete: Cascade)

  threads ForumThread[]

  @@index([learning_path_id])
  @@map("forum_boards")
}

model ForumThread {
  id           String   @id @default(uuid()) @db.Uuid
  board_id     String   @db.Uuid
  author_id    String   @db.Uuid
  title        String
  /// The opening post's text. Kept on the thread rather than as a first Post
  /// row so "a thread with no replies" is one row, not two, and so deleting a
  /// reply can never orphan the question.
  body         String
  /// Denormalised for the board list, which would otherwise N+1 across every
  /// thread to render a count and a date. Maintained by lib/forums.ts on reply.
  reply_count  Int      @default(0)
  last_post_at DateTime @default(now())
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  board  ForumBoard  @relation(fields: [board_id], references: [id], onDelete: Cascade)
  author Person      @relation("ForumThreadAuthor", fields: [author_id], references: [id], onDelete: Cascade)
  posts  ForumPost[]

  @@index([board_id, last_post_at])
  @@index([author_id])
  @@map("forum_threads")
}

model ForumPost {
  id         String   @id @default(uuid()) @db.Uuid
  thread_id  String   @db.Uuid
  author_id  String   @db.Uuid
  body       String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  /**
   * ⚠ DID THIS REPLY ACTUALLY HELP — the one field that turns a VOLUME signal
   * into an INVOLVEMENT signal (brief_community_signal).
   * Scott wants community involvement visible on a profile. A raw reply count
   * cannot carry that: twenty-five one-line replies out-rank three answers that
   * solved someone's problem, and the first person to notice the number is on
   * their public profile will optimise for it. A badge that rewards posting is a
   * badge that produces posting.
   * ── WHO MAY SET IT, AND WHY IT IS ONLY THEM ─────────────────────────────────
   * THE THREAD'S AUTHOR. Not a vote, not a reaction, not a moderator flag: the
   * person who asked is the only one who knows whether an answer answered. That
   * also makes it un-farmable in the ordinary way — you cannot mark your own
   * work, and nobody can brigade somebody else's thread.
   * ⚠ ENFORCED IN `lib/forums.ts`, NEVER IN A COMPONENT, and it REFUSES rather
   * than silently no-ops so the UI can explain why. `check:community` fails the
   * build if this column is written anywhere else.
   * ⚠ A NULLABLE TIMESTAMP RATHER THAN A BOOLEAN, so it is reversible: a thread
   * author who mis-clicks has to be able to undo, and "when" is worth keeping.
   * ⚠ THERE ARE NO UPVOTES, REACTIONS, POINTS OR LEADERBOARD, deliberately. One
   * signal, owned by the person who asked. Everything else is a product decision
   * that has not been made.
   */
  marked_helpful_at DateTime?
  /**
   * The thread author who marked it. `SetNull` on delete, which leaves
   * `marked_helpful_at` set with no marker — correct: the judgement was made and
   * still stands even if that account is later removed. Read it as "marked
   * helpful, by someone no longer here", never as "not marked".
   */
  marked_helpful_by String?   @db.Uuid

  thread        ForumThread @relation(fields: [thread_id], references: [id], onDelete: Cascade)
  author        Person      @relation("ForumPostAuthor", fields: [author_id], references: [id], onDelete: Cascade)
  helpfulMarker Person?     @relation("ForumPostHelpfulMarker", fields: [marked_helpful_by], references: [id], onDelete: SetNull)

  @@index([thread_id, created_at])
  @@index([author_id])
  /// The profile signal counts helpful answers per author, so it filters on this.
  @@index([marked_helpful_at])
  @@map("forum_posts")
}

// ---------------------------------------------------------------------------
// ASSESSMENT ENGINE — Phase 1, P2P (brief_assessment_p2p_phase1_2026-08-13)
//
// One assessment = one process, by design: the splitter asks people to answer
// for the area they actually own, and the other processes get forwarded to
// colleagues (AssessmentInvite) rather than guessed at by one person.
// ---------------------------------------------------------------------------

/// Which process an assessment covers. Only P2P has a question bank in Phase 1;
/// the other three are on the splitter as "send to a colleague".
enum AssessmentProcess {
  P2P
  O2C
  R2R
  H2R
}

model Assessment {
  id         String   @id @default(uuid()) @db.Uuid
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  /// G1 — the gate. Captured in-flow; the report is delivered here.
  email                      String
  company_name               String
  /**
   * ⚠ LEGACY FREE TEXT — RETAINED ON PURPOSE, NOT DEAD WEIGHT.
   * Industry was a free-text input until 2026-08-14 and rows captured before
   * then hold strings ("Den", "Dental services") with no Specialization to map
   * to. Dropping the column to tidy the model would throw away real
   * submissions, so it stays and is simply not written going forward —
   * `industry_specialization_id` below is the field the dropdown fills.
   * Backfilling these strings to ids is a separate decision, deliberately not
   * taken here. Do not read this column's emptiness on new rows as a bug.
   */
  industry                   String?
  /**
   * The catalog answer. Nullable because Industry is the one OPTIONAL field on
   * step 0 — a visitor who skips it must still get a report.
   */
  industry_specialization_id String?         @db.Uuid
  industrySpecialization     Specialization? @relation(fields: [industry_specialization_id], references: [id], onDelete: SetNull)
  /// State + entity together set the tax picture — see the copy prototype.
  state                      String?
  entity_type                String?
  revenue_band               String?
  /// Optional by design: a band is fine and skipping is allowed, so funding
  /// falls back to a revenue-derived estimate rather than blocking the flow.
  ebitda_band                String?
  /// QuickBooks/spreadsheets · legacy ERP · cloud ERP · not sure. "legacy"
  /// flags the leapfrog message.
  platform                   String?

  process AssessmentProcess @default(P2P)

  /**
   * Every answer, verbatim, as given.
   * JSON RATHER THAN COLUMNS, deliberately. The question bank is expected to
   * grow to ~60 capability domains across four processes, and a column per
   * question would be a migration per copy edit. Scores are computed from this
   * on the way in and STORED below, so a later change to the scoring code
   * cannot silently rewrite a report somebody has already been shown.
   */
  answers Json

  /// P2P maturity, normalized 0-100 for display. Computed at submit.
  score_pct Int @default(0)

  /**
   * The report/deck URL secret. This IS the access control for the report: it
   * is emailed to the person who filled the form and is what a share link
   * carries, so it is a uuid rather than anything guessable or sequential.
   */
  share_token String @unique @default(uuid()) @db.Uuid

  /// Set when the magic link is used to make an account (one-click).
  user_id String? @db.Uuid
  user    User?   @relation(fields: [user_id], references: [id], onDelete: SetNull)

  /**
   * ⚠ THE COMPANY THIS ASSESSMENT BELONGS TO — AND IT IS NULLABLE FOREVER.
   * Scott, 2026-08-19: *"assessments are done at the company level (conceivably
   * they could do more than one)"*. `company_name` above cannot answer that:
   * it is whatever the visitor typed, so "StratERP", "Strat ERP" and "straterp"
   * are three companies and *"this company's assessments"* is not a query you
   * can write. This column is.
   * ⚠ `company_name` IS NOT REPLACED BY IT. The assessment is filled in BEFORE
   * the account exists — `user_id` is null until the magic link is used — so a
   * visitor has no `Company` to point at. The typed string is what they told us
   * and it stays; this is added beside it and populated when the assessment is
   * CLAIMED by someone who already has a company binding.
   * ⚠ AND IT IS NEVER BACKFILLED BY MATCHING THE STRING. Fuzzy-matching a typed
   * name to a Company row would attribute a stranger's assessment to a real
   * customer. (Measured 2026-08-19: 0 of the 7 distinct strings in the table
   * match any of the 62 Company rows, so there was nothing to be tempted by.)
   * ⚠ RESOLVED THROUGH `getCompanyBinding`, NEVER `Person.company_id` — the
   * latter is the signup placeholder and treating it as a company is exactly
   * `P1-J1.2-E003`. `check:assessment-instance` fails the build on it.
   */
  company_id String?  @db.Uuid
  company    Company? @relation(fields: [company_id], references: [id], onDelete: SetNull)

  invites       AssessmentInvite[]
  domainResults AssessmentDomainResult[]

  @@index([email])
  @@index([user_id])
  @@index([company_id])
  @@index([industry_specialization_id])
  @@map("assessments")
}

/**
 * ONE ROW PER CAPABILITY DOMAIN PER ASSESSMENT — the per-domain result, frozen.
 * ── ⚠ WHY THIS HAS TO EXIST ──────────────────────────────────────────────────
 * `Assessment.score_pct`'s comment says the score is stored *"so that a later
 * change to the scoring code cannot silently rewrite a report somebody has
 * already been shown."* That protection covered ONE number. Every per-domain
 * rung, dollar figure and ranking on the report — the part a buyer actually
 * reads and the part a call is run off — was derived live from `answers` by
 * `scoreAssessment()`. Move a weight in `DOLLAR_WEIGHTS` and every historical
 * report changed. This table applies the existing rule to the rest of the model.
 * ── ⚠ `domain_key` IS THE DURABLE FIELD; THE FK IS A CONVENIENCE ──────────────
 * Keys are authored in the question bank. `CapabilityDomain.key` exists for all
 * ten P2P domains, but 77 of 87 catalog rows still have no key and the other
 * three processes have no bank at all — so the FK is nullable, resolved by key
 * at write time, and an UNRESOLVABLE KEY WRITES THE ROW WITH A NULL FK rather
 * than failing the submission. Losing a buyer's assessment because a taxonomy
 * row is missing is not an acceptable trade.
 * This is also the join that `"show me the products that address this company's
 * weakest domains"` needs — `Package` is already indexed by
 * `capability_domain_id`. ⚠ NOTHING USES THAT YET, deliberately: whether
 * `PackageValueFactor` replaces, feeds or reconciles against `DOLLAR_WEIGHTS` is
 * an open decision, and building the match first would bake in the answer.
 */
model AssessmentDomainResult {
  id            String @id @default(uuid()) @db.Uuid
  assessment_id String @db.Uuid

  /// The bank key as answered ("invoices", "sourcing") — the durable identifier.
  domain_key           String
  /// Resolved from `CapabilityDomain.key` at write time. Null when unresolvable.
  capability_domain_id String? @db.Uuid

  /// 10|23|37|50 (and the legacy 20|30|40), or NULL for "Not sure".
  /// ⚠ A NULL RUNG IS A ROW, NOT A MISSING ROW. The absence of an answer is
  /// information — the report counts it and names it back to them.
  rung Int?

  /**
   * ⚠ A RANGE, NOT A SCALAR, AND THAT IS A DEVIATION FROM THE BRIEF'S SCHEMA.
   * The brief specified a single `opportunity_cents`. Every dollar figure on the
   * report is a RANGE — `formatRange` prints "$90–140K" — because every input is
   * a band. One column cannot carry it, so the report would have had to
   * recompute the other end, which is the exact thing this table exists to stop.
   * Both ends are stored; flagged in the report rather than done quietly.
   * ⚠ BigInt, not Int. $2.59M is 259,000,000 cents and fits — but the $18.5M
   * revenue base does not survive a few multiplications inside Int, and a
   * silently truncated dollar figure on a buyer's report is not a bug you notice.
   */
  opportunity_low_cents  BigInt?
  opportunity_high_cents BigInt?

  /**
   * ⚠ STORED RATHER THAN RE-SORTED, so the order cannot drift.
   * Ranking sorts on the high end with no explicit tiebreak, which means the
   * order of ties comes from the question bank's array order. Re-deriving it
   * later would reproduce that only by accident.
   */
  rank Int?

  /// The dollar weight in force AT SUBMIT, in basis points. 0 for the two
  /// enabler domains, which recover $0 by design — see UNWEIGHTED_DOMAINS.
  weight_bps Int?

  /**
   * ⚠ THE DECK'S PER-DOMAIN EXTRA FIELDS, RESOLVED AT SUBMIT — slides 2–11 of
   * `AI Maturity Assessment.pptx`. An array of
   * `{ id, label, type, meaning, period, value }`, canonicalised: `count` in whole
   * units, `dollars` IN CENTS, `percent` as an integer 0–100, `boolean` as a bool.
   * `lib/assessment/domain-fields.ts` is the spec and the only writer.
   * ⚠ JSON WHERE ITS NEIGHBOURS ARE COLUMNS, AND THAT IS THE POINT. `rung`,
   * `rank` and `weight_bps` are uniform — exactly one number per domain, every
   * time. These are NOT: eight domains carry fields and two carry none, one
   * carries four, one carries three percentages and no volume, and the dollar
   * field means three different quantities across the eight. Expressing that in
   * columns takes nine mostly-null domain-specific columns on a generic table.
   * ⚠ THE LABEL AND THE MEANING ARE STORED WITH THE VALUE, not looked up at read
   * time. Sourcing asks dollars SAVED, contracts asks SPEND UNDER CONTRACT, the
   * rest ask GROSS DOLLARS — three incompatible quantities that a dashboard would
   * otherwise sum. Storing the meaning is what makes a stored report immune to a
   * later edit of the spec, the same principle `score_pct` already follows.
   * ⚠ NULL MEANS NOT ASKED, `[]` MEANS ASKED-AND-THE-SLIDE-HAS-NO-FIELDS, AND
   * NEITHER IS ZERO. The 13 assessments taken before this column existed are NOT
   * backfilled; their reports must render byte-identically.
   * ⚠ NOTHING COMPUTES A DOLLAR FROM THIS YET. Whether these figures replace, feed
   * or are reconciled against the top-down `DOLLAR_WEIGHTS` model is an open
   * decision and it decides what the headline figure on the dashboard actually is.
   * Storing the input is deliberately as far as this goes.
   * ⚠ AND THE DECK NAMES NO PERIOD — "Estimated Number of Invoice Lines" per month
   * or per year is not stated on any of the 15 slides. `period` is therefore null
   * on every field, recorded rather than invented. Nothing can normalise these into
   * a rate until Scott names one.
   */
  fields Json?

  /**
   * ⚠ TRUE MEANS RECONSTRUCTED, NOT MEASURED.
   * WS3 backfills historical assessments from their stored `answers` using
   * TODAY's weights, because the weights in force when those reports were shown
   * were never recorded. That is unavoidable and it must be visible: a row with
   * this set was rebuilt after the fact and may not match what the recipient saw.
   */
  backfilled Boolean @default(false)

  created_at DateTime @default(now())

  assessment Assessment @relation(fields: [assessment_id], references: [id], onDelete: Cascade)

  @@unique([assessment_id, domain_key])
  @@index([assessment_id])
  @@index([capability_domain_id])
  @@index([domain_key])
  @@map("assessment_domain_results")
}

/// "Send the other assessments to colleagues" — the referral engine (WS-E).
/// Each invite re-enters the flow at the questions step for that process.
model AssessmentInvite {
  id            String            @id @default(uuid()) @db.Uuid
  assessment_id String            @db.Uuid
  process       AssessmentProcess
  name          String
  email         String
  sent_at       DateTime          @default(now())

  assessment Assessment @relation(fields: [assessment_id], references: [id], onDelete: Cascade)

  @@unique([assessment_id, process, email])
  @@index([assessment_id])
  @@map("assessment_invites")
}

/**
 * The funding rate — Phase 1's ONLY tax logic (WS-C).
 * Funding = EBITDA x rate. One global default (18%) plus optional per-geography
 * overrides, both editable by a Panameer Admin from day one, because Scott
 * refines the rate and the geography table later and a hard-coded constant
 * would make that a code change.
 * Basis points, not a float: 18% is 1800, exact, and money math that starts
 * with 0.18 in binary floating point starts with a rounding error.
 */
model TaxRate {
  id         String   @id @default(uuid()) @db.Uuid
  /**
   * NULL = the global default. Otherwise a state/region code ("CA", "NY").
   * A single nullable column rather than a separate defaults table: there is
   * exactly one row that applies when no override matches, and modelling that
   * as "the row with no geography" keeps the lookup one query.
   */
  geography  String?  @unique
  rate_bps   Int
  note       String?
  updated_at DateTime @updatedAt
  updated_by String?  @db.Uuid

  @@map("tax_rates")
}

/// PRODUCT <-> CAPABILITY DOMAIN — "which domains does this product operate on" (E002).
///
/// ⚠ MANY-TO-MANY, DELIBERATELY, AND A SINGLE COLUMN WOULD HAVE BEEN WRONG. Scott,
/// 2026-08-19: "Might have to be a 'select all CDs' as opposed to choose which CD this
/// agent runs on." A P2P health check spans all ten domains; an agent that watches for
/// off-contract spend touches several. Retrofitting many-to-many after providers have
/// authored against a single FK is painful, so it is modelled that way from the start.
///
/// ⚠ PROCESS IS NOT STORED HERE. It is already reachable through
/// `CapabilityDomain.process`, and business-process -> capability-domain was ALREADY
/// modelled before this brief — roughly nine processes decomposing into ~85 domains, with
/// `@@unique([process, name])` on the domain. A `process` column on the package or on this
/// join would be a second source of truth that drifts. A query that needs process joins.
///
/// ⚠ `Package.role_type_id` IS UNAFFECTED. It answers a different question — what kind of
/// PRACTITIONER — and nothing here replaces it.
model PackageCapabilityDomain {
  id                   String   @id @default(uuid()) @db.Uuid
  package_id           String   @db.Uuid
  capability_domain_id String   @db.Uuid
  created_at           DateTime @default(now())

  package          Package          @relation(fields: [package_id], references: [id], onDelete: Cascade)
  capabilityDomain CapabilityDomain @relation(fields: [capability_domain_id], references: [id], onDelete: Cascade)

  /// One row per pair — selecting a domain twice is not a different fact.
  @@unique([package_id, capability_domain_id])
  /// Indexed BOTH ways: "which domains does this product cover" and "which products
  /// cover this domain" are both first-class queries.
  @@index([package_id])
  @@index([capability_domain_id])
  @@map("package_capability_domains")
}

/// WHICH ASSESSMENT VARIABLE A PRODUCT'S ESTIMATE MULTIPLIES.
///
/// ⚠ THE ENUM IS CLOSED, AND THAT CLOSURE IS THE WHOLE DESIGN (E003). Scott, 2026-08-19:
/// "I or the creator will need to estimate its value (saves a 50,000 lawsuit or saves 12%
/// on each contract)... that something has to be one of the things we are capturing in the
/// assessment." So a factor may ONLY reference a variable the assessment actually collects.
/// Anything else produces an estimate anchored to data nobody ever gathered.
///
/// `src/lib/catalog/value-factors.ts` maps each member to the wizard field it needs, and
/// `check:catalog-value` FAILS if any member names a field `AssessmentWizard` does not
/// collect. Adding a member without adding the question is a build error, on purpose.
enum ValueFactorBasis {
  /// `spendBand` — "how much did you spend with outside suppliers last year?"
  SUPPLIER_SPEND
  /// `spendBand` x `costLeverBand` — the share of spend on negotiated contracts.
  CONTRACT_SPEND
  /// `headcountBand` — people supporting purchasing end to end.
  PURCHASING_HEADCOUNT
  /// `revenueBand`
  REVENUE
  /// `ebitdaBand`
  EBITDA
  /// ⚠ A REAL CASE, NOT A FALLBACK. "Saves a $50,000 lawsuit" is risk avoidance: it does
  /// not scale with the buyer's size, so it must stay distinguishable from a proportional
  /// factor whose rate happens to be small. Its rate is CENTS, not basis points.
  FLAT
}

/// HOW ONE PRODUCT'S VALUE IS ESTIMATED — basis x rate, gated by a condition (E003).
///
/// ⚠ ITS OWN TABLE, NOT COLUMNS ON `Package`, because a product may carry MORE THAN ONE
/// factor: an agent can save a share of contract value AND avoid a fixed risk. Columns
/// would force a choice between them.
///
/// ⚠ NOTHING COMPUTES ANYTHING FROM THIS YET. This brief stores the factor and stops.
/// Whether solution values replace, feed, or reconcile against the existing top-down
/// `DOLLAR_WEIGHTS` model in `lib/assessment/scoring.ts` is Scott's decision and was
/// explicitly out of scope. Do not wire it to scoring or to the dashboard on the strength
/// of this model existing.
model PackageValueFactor {
  id                 String           @id @default(uuid()) @db.Uuid
  package_id         String           @db.Uuid
  basis              ValueFactorBasis
  /// ⚠ INTEGER, AND THE UNIT IS DECIDED BY `basis` — basis points for every proportional
  /// basis, CENTS when `basis = FLAT`. Same rule as every other money value in the app: a
  /// float here produces totals that do not reconcile. `factorUnit()` in
  /// `lib/catalog/value-factors.ts` is the single place that rule is written down; read it
  /// rather than re-deriving it at each call site.
  rate               Int
  /// The gating condition: apply only when the domain's maturity is BELOW this rung
  /// (10/23/37/50 — see `MATURITY_RUNGS`). Null = applies at any maturity. A product that
  /// only helps the manual case says so here instead of being silently over-credited.
  applies_below_rung Int?
  /// Free text for the estimator — where the number came from. Not parsed.
  note               String?
  created_at         DateTime         @default(now())
  updated_at         DateTime         @updatedAt

  package Package @relation(fields: [package_id], references: [id], onDelete: Cascade)

  @@index([package_id])
  @@index([basis])
  @@map("package_value_factors")
}

/// ── ⚠⚠ THE RELATIONSHIP MODEL (`P1-ALL-E372`) ─────────────────────────────────
///
/// SCOTT, 2026-09-03: *"how can you promote commerce without facilitating the
/// connection of people to do that trading/commerce? This section CONNECTS
/// people."*
///
/// ⚠ THE SECTION WAS NAMED FOR CONNECTING PEOPLE AND COULD NOT RECORD THAT TWO
/// PEOPLE WERE CONNECTED. Surveyed 2026-09-03: `/community`,
/// `/community/mentors`, `/community/teams` and `/messages` are all real pages —
/// and there was NO `Connection`, `Colleague`, `Mentor`, `Follow`, `Team` or
/// `Message` model anywhere in the schema. Verified by grep, not assumed.
///
/// ⚠⚠ TWO SHAPES, AND THEY MUST NOT COLLAPSE INTO ONE GENERIC "CONNECTION":
///   COLLEAGUE  MUTUAL — created `PENDING`, needs the other side to accept.
///              Scott's equivalent is a LinkedIn connection.
///   MENTOR     ONE-WAY — created `ACCEPTED` on the spot. Following requires no
///              permission, and asking for one would make it a different feature.
///
/// ⚠ `TEAM` IS DELIBERATELY NOT A KIND HERE, and the survey is why: `lib/teams.ts`
/// ALREADY WORKS, off `ProviderProfile.coordinator_person_id` and
/// `CoordinatorInvite` — the Service Coordinator model. Adding a `TEAM` kind
/// would be a second, competing implementation of a relationship that exists.
///
/// ⚠⚠ `DECLINED` IS A FIRST-CLASS STATE, NEVER A DELETED ROW. `P1-ALL-E369`'s
/// growth strategy rests on a colleague request meaning *"I vouch for this
/// person"*, and a decline is the true signal that protects it. A declined row
/// also stops the same request being re-sent forever.
model Connection {
  id           String           @id @default(uuid()) @db.Uuid
  from_user_id String           @db.Uuid
  to_user_id   String           @db.Uuid
  kind         ConnectionKind
  status       ConnectionStatus
  created_at   DateTime         @default(now())
  /// Set when the other side answered. ⚠ A `COLLEAGUE` can never be `ACCEPTED`
  /// without one — `check:community` fails the build on that.
  responded_at DateTime?

  fromUser User @relation("ConnectionsSent", fields: [from_user_id], references: [id], onDelete: Cascade)
  toUser   User @relation("ConnectionsReceived", fields: [to_user_id], references: [id], onDelete: Cascade)

  /// ⚠ ONE ROW PER (pair, kind) — so following somebody you are already
  /// colleagues with is a separate, legal row, and re-sending the same request
  /// is not.
  @@unique([from_user_id, to_user_id, kind])
  @@index([to_user_id, status])
  @@index([from_user_id, status])
  @@map("connections")
}

/// ── ⚠⚠ MESSAGES (`P1-ALL-E379`) ────────────────────────────────────────────
///
/// SCOTT, 2026-09-04, on being told there is no `Message` model: *"build one!"*
///
/// ⚠⚠ ONE TABLE. THERE IS NO `Thread` AND NO `Participant`, AND THAT IS A
/// DESIGN DECISION RATHER THAN A SHORTCUT. A conversation is DERIVED from the
/// unordered pair of user ids — 1:1 only. Group messaging needs both of those
/// models plus a name, a membership policy and a leave semantic; it is a
/// different feature and this is not it.
///
/// ⚠⚠ THE PERMISSION IS NOT IN THIS TABLE AND MUST NOT BE INFERRED FROM IT. A
/// row here does not mean the pair may still message: `lib/messages.ts`
/// re-derives permission from the `Connection` table on EVERY send. Two people
/// who exchanged messages and then declined each other keep their history and
/// lose the ability to add to it.
///
/// ⚠ NOTHING DELETES A MESSAGE — the house pattern, same as `DECLINED`
/// connections. History is not editable by either party.
model Message {
  id           String    @id @default(uuid()) @db.Uuid
  from_user_id String    @db.Uuid
  to_user_id   String    @db.Uuid
  body         String
  created_at   DateTime  @default(now())
  /// ⚠⚠ SET BY THE RECIPIENT ONLY. A sender can never mark their own message
  /// read — `markRead` scopes its update to `to_user_id = me`, and
  /// `check:messages` asserts it. A sender-settable read receipt would be a
  /// claim about somebody else's attention.
  read_at      DateTime?

  from User @relation("MessagesSent", fields: [from_user_id], references: [id], onDelete: Cascade)
  to   User @relation("MessagesReceived", fields: [to_user_id], references: [id], onDelete: Cascade)

  /// The unread badge's index — one number, read on every page load.
  @@index([to_user_id, read_at])
  /// The conversation read, oldest-first within a pair.
  @@index([from_user_id, to_user_id, created_at])
  @@map("messages")
}

enum ConnectionKind {
  COLLEAGUE
  MENTOR
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  DECLINED
}
