// Prisma schema for Panameer Digital Services
// Prisma 7 + @prisma/adapter-pg (driver adapter) — matches Medlinq.
//
// Supabase gives you two connection strings:
//   - DATABASE_URL : pooled connection (port 6543, ?pgbouncer=true) — runtime (via PrismaPg adapter)
//   - DIRECT_URL   : direct connection (port 5432) — migrations (see prisma.config.ts)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: connection URLs live in prisma.config.ts (migrations) and the
  // PrismaClient adapter (runtime). No `url`/`directUrl` here.
}

/// The lean system principal for auth. NextAuth's credentials provider
/// authenticates against this row (bcrypt password hash + account lockout).
/// Identity/profile data lives on the linked Person (1:1, optional) — this row
/// stays focused on authentication.
model User {
  id                    String    @id @default(uuid()) @db.Uuid
  /// ALWAYS stored normalized (trim + lowercase) via `normalizeEmail`. Backed
  /// by an additional UNIQUE INDEX on `lower(email)` that Prisma cannot express
  /// (functional index) — it is created by `npm run db:email-guard`, and
  /// `prisma db push` DROPS it, so re-run that script after every push.
  /// See brief_O / decisions-01.md.
  email                 String    @unique
  /// NULL for accounts created purely through OAuth (brief_Q) — they have no
  /// password and authenticate via the provider. `authorize` already refuses to
  /// compare against a null hash, so such an account cannot be password-guessed.
  password_hash         String?
  first_name            String?
  last_name             String?
  /// Profile picture URL supplied by an OAuth provider (brief_Q). Held on the
  /// User because it arrives at sign-in, before the Person backbone exists;
  /// it is copied onto `Person.photo_url` when that Person is created.
  image                 String?
  /// Which OAuth providers this account has signed in with (e.g. ["google"]).
  /// Record-keeping so support can see how an account authenticates; linking is
  /// keyed on the normalized email, not on this list.
  oauth_providers       String[] @default([])
  role                  Role      @default(MEMBER)
  is_active             Boolean   @default(true)
  is_system_admin       Boolean   @default(false)
  locked                Boolean   @default(false)
  failed_login_attempts Int       @default(0)
  /// When the user's email was verified (null = unverified). Set by the
  /// tokenized verify link during onboarding (brief_E).
  email_verified        DateTime?
  /// When the user accepted the Terms of Service (buyer signup, brief_G).
  tos_accepted_at       DateTime?
  last_login            DateTime?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  /// The person this login belongs to (nullable: a User need not have a Person
  /// yet, e.g. the system admin before onboarding). The FK lives on Person.
  person             Person?
  verificationTokens VerificationToken[]

  @@map("users")
}

enum Role {
  ADMIN
  MEMBER
}

/// A single-use, expiring verification token (email verification for now; the
/// type enum leaves room for phone/password-reset later). We store only the
/// SHA-256 hash of the token — the raw token lives only in the emailed link.
/// Minimal by design (brief_E allowed addition).
model VerificationToken {
  id         String                @id @default(uuid()) @db.Uuid
  user_id    String                @db.Uuid
  token_hash String                @unique
  type       VerificationTokenType @default(EMAIL)
  expires_at DateTime
  consumed_at DateTime?
  created_at DateTime              @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("verification_tokens")
}

enum VerificationTokenType {
  EMAIL
  /// A single-use, short-lived token that establishes a SESSION (brief_S /
  /// E022). Minted only after an email-verification token has been validated,
  /// so clicking the link in the email signs the provider in and drops them
  /// straight into onboarding instead of a login screen.
  SIGNIN
}

// ---------------------------------------------------------------------------
// Org & identity backbone (Phase 1)
//
//   PAccount → Company → Site → Address           (org hierarchy)
//                     ↘ Person → User             (people; login is optional)
//
// PAccount is the tenancy fence: private business queries filter by
// p_account_id (see src/lib/access.ts `scopedToPAccount`). Published profiles
// and posted work requests are shared marketplace surfaces and are explicitly
// NOT scoped — that boundary is drawn in access.ts, not here.
// ---------------------------------------------------------------------------

/// The tenant. A buyer org, a provider entity, or both. Subscription/billing
/// will hang off this row later.
model PAccount {
  id         String         @id @default(uuid()) @db.Uuid
  kind       PAccountKind
  name       String
  status     PAccountStatus @default(ACTIVE)
  created_at DateTime       @default(now())
  updated_at DateTime       @updatedAt

  companies    Company[]
  workRequests WorkRequest[]

  @@map("p_accounts")
}

enum PAccountKind {
  BUYER
  PROVIDER
  BOTH
}

enum PAccountStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

/// A company within a P-Account. Carries name, vertical, and branding.
model Company {
  id           String   @id @default(uuid()) @db.Uuid
  p_account_id String   @db.Uuid
  name         String
  vertical     String?
  website      String?
  logo_url     String?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  pAccount PAccount @relation(fields: [p_account_id], references: [id], onDelete: Cascade)
  sites    Site[]
  people   Person[]

  @@index([p_account_id])
  @@map("companies")
}

/// A physical/operational location of a Company.
model Site {
  id                String   @id @default(uuid()) @db.Uuid
  company_id        String   @db.Uuid
  name              String
  open_for_business Boolean  @default(true)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  company   Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)
  addresses Address[]
  people    Person[]

  @@index([company_id])
  @@map("sites")
}

/// A postal address belonging to a Site.
model Address {
  id          String   @id @default(uuid()) @db.Uuid
  site_id     String   @db.Uuid
  line1       String
  line2       String?
  city        String?
  state       String?
  postal_code String?
  country     String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  site Site @relation(fields: [site_id], references: [id], onDelete: Cascade)

  @@index([site_id])
  @@map("addresses")
}

/// A human within a Company (optionally pinned to a Site), optionally linked
/// 1:1 to a User login. The actor-role flags describe what this person DOES in
/// the marketplace (distinct from the skill role-types in Brief B).
model Person {
  id         String       @id @default(uuid()) @db.Uuid
  company_id String       @db.Uuid
  site_id    String?      @db.Uuid
  user_id    String?      @unique @db.Uuid
  first_name String
  last_name  String
  title      String?
  phone      String?
  /// When the phone number above passed SMS verification (brief_P / E019).
  /// Cleared whenever `phone` changes, so it always describes the CURRENT number.
  phone_verified_at DateTime?
  photo_url  String?
  status     PersonStatus @default(ACTIVE)

  // Actor-role flags — what this person does (a person can wear several hats).
  // "Service Buyer" is the actor who creates work requests (the ERP Requester)
  // and is deliberately NOT named `is_buyer`: "Buyer" is an operational SKILL in
  // the taxonomy (an ERP procurement role), never an actor. The is_service_*
  // prefix keeps the two from ever being conflated.
  is_service_buyer       Boolean @default(false)
  is_service_provider    Boolean @default(false)
  is_service_coordinator Boolean @default(false)
  is_support             Boolean @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  company         Company          @relation(fields: [company_id], references: [id], onDelete: Cascade)
  site            Site?            @relation(fields: [site_id], references: [id], onDelete: SetNull)
  user            User?            @relation(fields: [user_id], references: [id], onDelete: SetNull)
  // The provider profile this Person OWNS (1:1).
  providerProfile ProviderProfile? @relation("ProfileOwner")
  buyerProfile    BuyerProfile?
  // As a COORDINATOR: the provider profiles this Person represents, and the
  // invites they've sent (brief_I).
  repProviderProfiles ProviderProfile[]   @relation("CoordinatorProviders")
  coordinatorInvites  CoordinatorInvite[] @relation("CoordinatorInvitesSent")
  // As a BUYER: the work requests this Person created (brief_L).
  workRequests        WorkRequest[]
  // SMS verification challenges for this person's phone (brief_P).
  phoneVerifications  PhoneVerification[]

  @@index([company_id])
  @@index([site_id])
  @@map("people")
}

enum PersonStatus {
  ACTIVE
  INACTIVE
}

// ---------------------------------------------------------------------------
// Service-catalog taxonomy (Phase 1, brief_B)
//
//   ServiceCatalog (ERP, …future ERPs)
//     └─ Pillar (ERP/SCM/HCM/CX/EPM/NA)
//          └─ Offering
//               └─ Application (+ app_group)
//
//   RoleType (global) ─┬─ Skill (normalized Panameer skill)
//                      └─ SkillTag (incoming job-req term → normalized skill)
//
//   Region · EngagementType · NonOracleApplication  (flat lookups)
//
// This is REFERENCE / LOOKUP data — global shared marketplace vocabulary, NOT
// PAccount-scoped. Providers tag Skills, work requests target the catalog, and
// matching runs over this vocabulary (later briefs). Seeded from
// prisma/seed-data/erp-catalog.json (parsed from Scott's Work Data File).
// ---------------------------------------------------------------------------

/// A service catalog. ERP is the first; the model is built Oracle-based but
/// meant to hold future catalogs for other ERPs.
model ServiceCatalog {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  pillars         Pillar[]
  skills          Skill[]
  tags            SkillTag[]
  specializations Specialization[]

  @@map("service_catalogs")
}

/// Global classification of what a person DOES on an engagement (Functional /
/// Technical / Techno-Functional / Project / Operational). Not catalog-scoped —
/// role types are shared across every catalog.
model RoleType {
  id         String   @id @default(uuid()) @db.Uuid
  code       String   @unique
  name       String
  display    String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  /// Display order for the Role → Domain picker (brief_R). Lower sorts first,
  /// keeping the ERP-heavy Application-Specific role at the top (E013).
  sort_order Int @default(100)

  /// Projects classified with this role type (brief_project_model_v2).
  projects Project[]

  skills           Skill[]
  tags             SkillTag[]
  workRequests     WorkRequest[]
  providerProfiles ProviderProfile[]
  packages         Package[]

  @@map("role_types")
}

/// A top-level product pillar within a catalog (ERP, SCM, HCM, CX, EPM, NA).
model Pillar {
  id         String   @id @default(uuid()) @db.Uuid
  catalog_id String   @db.Uuid
  code       String
  name       String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  /// Display order for the category picker (brief_P / E013). Lower sorts first,
  /// so ERP is pinned above AI and everything else. Ties break on name.
  sort_order Int @default(100)

  catalog   ServiceCatalog @relation(fields: [catalog_id], references: [id], onDelete: Cascade)
  offerings Offering[]
  skills    Skill[]
  tags      SkillTag[]
  providerProfiles ProviderProfile[]

  @@unique([catalog_id, code])
  @@map("pillars")
}

/// An offering within a pillar (e.g. ERP → Procurement).
model Offering {
  id         String   @id @default(uuid()) @db.Uuid
  pillar_id  String   @db.Uuid
  name       String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  pillar       Pillar        @relation(fields: [pillar_id], references: [id], onDelete: Cascade)
  applications Application[]

  @@unique([pillar_id, name])
  @@index([pillar_id])
  @@map("offerings")
}

/// An application within an offering (e.g. Procurement → Requisitions). Carries
/// its App Group as a field (the source data pairs one app group per app).
model Application {
  id          String   @id @default(uuid()) @db.Uuid
  /// Null for a PROVIDER-ADDED tool (brief_project_model_v2): a custom entry
  /// belongs to no ERP offering, and leaving it out of the tree is what keeps
  /// it from polluting the Role → Domain → Skill pickers, which walk
  /// offerings. Baseline catalog rows always carry one.
  offering_id String?  @db.Uuid
  name        String
  app_group   String?
  /// Added on the fly by a provider, and therefore FLAGGED FOR ADMIN REVIEW so
  /// recurring entries can be promoted to baseline later (the same contract as
  /// `Specialization.is_custom`). Never retired by the seed.
  is_custom   Boolean  @default(false)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  offering Offering?            @relation(fields: [offering_id], references: [id], onDelete: Cascade)
  skills   Skill[]
  projects ProjectApplication[]

  @@unique([offering_id, name])
  @@index([offering_id])
  @@index([is_custom])
  @@map("applications")
}

/// A normalized Panameer skill — the matchable vocabulary providers tag and
/// work requests target. Sourced from the application hierarchy (functional
/// skills, which set pillar + application), the per-role-type skill lists, and
/// the freelancer mapping's normalized `panameerSkill` names. Deduped by
/// (catalog, name); functional (APPLICATION) sources win the role type.
model Skill {
  id             String   @id @default(uuid()) @db.Uuid
  catalog_id     String   @db.Uuid
  role_type_id   String   @db.Uuid
  pillar_id      String?  @db.Uuid
  application_id String?  @db.Uuid
  name           String
  image_url      String?
  /// Added by a provider on the fly (brief_S / E031) rather than coming from
  /// the authoritative Service Catalog. The seed's retirement pass SKIPS these
  /// — otherwise re-seeding would silently delete skills providers had entered
  /// and selected.
  is_custom      Boolean  @default(false)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  catalog        ServiceCatalog  @relation(fields: [catalog_id], references: [id], onDelete: Cascade)
  roleType       RoleType        @relation(fields: [role_type_id], references: [id])
  pillar         Pillar?         @relation(fields: [pillar_id], references: [id], onDelete: SetNull)
  application    Application?    @relation(fields: [application_id], references: [id], onDelete: SetNull)
  providerSkills    ProviderSkill[]
  workRequestSkills WorkRequestSkill[]
  packageSkills     PackageSkill[]

  /// A Skill belongs to a (Role, Domain) PAIR — brief_R, from the authoritative
  /// Service Catalog. The old `(catalog_id, name)` key was wrong for that shape:
  /// "Project Manager" legitimately exists under BOTH Project-Specific/Project
  /// Execution and Operations-Specific/Project Portfolio Management, and a
  /// name-only key silently collapsed them into one row.
  @@unique([catalog_id, role_type_id, pillar_id, name])
  @@index([role_type_id])
  @@index([pillar_id])
  @@map("skills")
}

/// An incoming job-requisition skill term ("tag"), grouped by role type, that
/// resolves to a normalized Skill. This is the loadable home for the JSON's
/// `freelancerMapping`: `panameer_skill` is the normalized target name and
/// `selling_agent` is the RAW coordinator name from the Work Data File —
/// preserved as an annotation, deliberately NOT yet linked to a Person. The
/// coordinator-coverage join is wired in the profiles brief.
model SkillTag {
  id            String   @id @default(uuid()) @db.Uuid
  catalog_id    String   @db.Uuid
  role_type_id  String   @db.Uuid
  pillar_id     String?  @db.Uuid
  name          String
  panameer_skill String?
  selling_agent String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  catalog  ServiceCatalog @relation(fields: [catalog_id], references: [id], onDelete: Cascade)
  roleType RoleType       @relation(fields: [role_type_id], references: [id])
  pillar   Pillar?        @relation(fields: [pillar_id], references: [id], onDelete: SetNull)

  @@unique([catalog_id, role_type_id, name])
  @@index([role_type_id])
  @@map("skill_tags")
}

/// A world region for provider/buyer location + coverage.
model Region {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  providerProfiles ProviderProfile[]
  workRequests     WorkRequest[]

  @@map("regions")
}

/// How an engagement is structured (Contract/Corp-to-Corp, Fulltime, Temporary).
model EngagementType {
  id         String   @id @default(uuid()) @db.Uuid
  code       String   @unique
  name       String
  detail     String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("engagement_types")
}

/// A non-Oracle application a provider may have experience with (PeopleSoft,
/// SAP, Ariba, Coupa, …). Flat lookup for now.
model NonOracleApplication {
  id         String   @id @default(uuid()) @db.Uuid
  name       String   @unique
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("non_oracle_applications")
}

// ---------------------------------------------------------------------------
// Profiles (Phase 1, brief_C)
//
//   Person (is_service_provider) ──1:1── ProviderProfile
//                                          ├─ ProviderSkill → Skill (taxonomy)
//                                          ├─ WorkExperience → ExperienceProject
//                                          ├─ Education · Language · Certification
//                                          └─ Region (optional)
//   Person (is_service_buyer)    ──1:1── BuyerProfile
//
// A ProviderProfile is a PUBLIC marketplace surface when it is visible (see
// GET /api/providers/[id]) — not PAccount-scoped. Rates are stored in integer
// cents to avoid float drift; money is never a Float.
// ---------------------------------------------------------------------------

/// A provider's marketplace profile (1:1 with a Person that is a service
/// provider). Marketplace-visible ⇔ status = ACTIVE AND completeness >= 80 AND
/// paused_at IS NULL (brief_K). Validation is a separate merit track that does
/// NOT affect base visibility.
model ProviderProfile {
  id               String   @id @default(uuid()) @db.Uuid
  person_id        String   @unique @db.Uuid
  region_id        String?  @db.Uuid
  headline         String
  overview         String?
  /// NULLABLE since brief_P: these are answered at profile steps 1 and 2
  /// (E003/E004), not at sign-up. With a non-null default there was no way to
  /// tell "chose Mid-Career" from "hasn't been asked yet", so the resume logic
  /// skipped straight past both steps for every returning user.
  experience_level ExperienceLevel?
  goal             ProviderGoal?
  work_types       WorkType[]
  onsite_rate_cents Int?
  remote_rate_cents Int?
  /// The single hourly rate the client sees (brief_P / E018). Integer cents.
  /// `onsite_/remote_rate_cents` predate this (brief_E) and stay for Settings.
  hourly_rate_cents Int?
  /// Platform service fee as BASIS POINTS (1000 = 10%). Integer so the fee and
  /// the "You'll get" figure are computed without ever touching a float.
  service_fee_bps  Int      @default(1000)
  currency         String   @default("USD")
  /// The field chosen at the catalog step: a (Role, Domain) PAIR, since the
  /// authoritative catalog is Role → Domain → Skill and the same domain name
  /// appears under more than one role (brief_R). `pillar_id` is the DOMAIN;
  /// `role_type_id` is the ROLE. Skills at the next step filter on both.
  pillar_id        String?  @db.Uuid
  role_type_id     String?  @db.Uuid
  /// How the provider sells; RECRUITER forks them to the Coordinator role
  /// (brief_P / E009).
  work_method      WorkMethod?
  /// Which profile-creation path was taken (brief_P / E012).
  profile_method   ProfileMethod?
  /// Collected on the finish page (brief_P / E019).
  date_of_birth    DateTime?
  /// When the provider pressed "Publish Profile" and finished onboarding
  /// (brief_P / E019). This is a COMPLETION marker, NOT a visibility flag —
  /// brief_K's derived completeness gate remains the only visibility rule.
  onboarding_completed_at DateTime?
  rating           Decimal? @db.Decimal(3, 2)
  id_badge         String?
  // Account lifecycle (brief_K): PENDING on sign-up → ACTIVE on email verify.
  status           ProviderStatus @default(PENDING)
  // Merit-based Validation track (brief_K) — separate from visibility. Provider
  // requests it; an admin grants on merit. Never purchasable.
  validation_status       ValidationStatus @default(NOT_REQUESTED)
  validation_requested_at DateTime?
  validated_at            DateTime?
  // Visibility is COMPLETENESS-gated, not approval-gated (brief_K, supersedes
  // brief_E/H). Marketplace-visible ⇔ status=ACTIVE AND completeness>=80 AND
  // paused_at IS NULL. No publish flag/button — visibility is derived.
  completeness     Int      @default(0)
  paused_at        DateTime?
  // Minimal preferences store (brief_H). Notification opt-ins; expand later.
  notify_email           Boolean @default(true)
  notify_product_updates Boolean @default(false)
  // The coordinator Person who represents this provider (brief_I). Nullable —
  // most providers are independent. Set only via the provider's own authenticated
  // acceptance of a coordinator invite.
  coordinator_person_id String? @db.Uuid
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  person          Person           @relation("ProfileOwner", fields: [person_id], references: [id], onDelete: Cascade)
  coordinator     Person?          @relation("CoordinatorProviders", fields: [coordinator_person_id], references: [id], onDelete: SetNull)
  region          Region?          @relation(fields: [region_id], references: [id], onDelete: SetNull)
  pillar          Pillar?          @relation(fields: [pillar_id], references: [id], onDelete: SetNull)
  roleType        RoleType?        @relation(fields: [role_type_id], references: [id], onDelete: SetNull)
  skills          ProviderSkill[]
  specializations ProviderProfileSpecialization[]
  employers       Employer[]
  projects        Project[]
  packages        Package[]
  education        Education[]
  languages        Language[]
  certifications  Certification[]
  imports          ProfileImport[]

  @@index([region_id])
  @@index([coordinator_person_id])
  @@index([pillar_id])
  @@index([role_type_id])
  @@map("provider_profiles")
}

enum ExperienceLevel {
  BEGINNER
  MID_CAREER
  EXPERT
}

enum ProviderGoal {
  SIDE_HUSTLE
  MAIN_HUSTLE
  BUILD_SKILLS
  NONE
}

enum WorkType {
  HOURLY
  PACKAGES
  AGENCY
  CONTRACT_TO_HIRE
}

/// How the provider sells — the "How Do You Work?" step (brief_P / E009).
/// RECRUITER is the user-type fork: a recruiter sells the services of OTHERS
/// and is the app's Coordinator role (see User Hierarchy deck / brief_I).
enum WorkMethod {
  HOURLY
  PACKAGES
  RECRUITER
}

/// Which of the three profile-creation paths the provider used (brief_P / E012).
enum ProfileMethod {
  LINKEDIN
  RESUME
  MANUAL
}

/// Source document for an import attempt (brief_P / E012).
enum ProfileImportSource {
  RESUME
  LINKEDIN_PDF
}

enum ProfileImportStatus {
  PENDING
  PARSED
  FAILED
}

/// Language proficiency (brief_P / E016). Stored as an enum so the four
/// canonical levels can't drift into free text.
enum LanguageProficiency {
  BASIC
  CONVERSATIONAL
  FLUENT
  NATIVE_OR_BILINGUAL
}

/// Provider account lifecycle (brief_K).
enum ProviderStatus {
  PENDING
  ACTIVE
}

/// Merit-based validation track (brief_K). Provider requests; admin grants.
enum ValidationStatus {
  NOT_REQUESTED
  REQUESTED
  VALIDATED
  REJECTED
}

/// Join: a taxonomy Skill this provider offers.
/// Cross-cutting Specialization vocabulary (brief_R) — the 23 entries from the
/// authoritative Service Catalog: products (Oracle Cloud, SAP, Coupa…),
/// methodologies (Procure-to-Pay, Order-to-Cash…) and industries (Healthcare,
/// Federal Government…).
///
/// A separate axis from Role→Domain→Skill: a provider's specializations say
/// WHICH systems/processes/sectors they know, independent of the role they play.
/// Reference data — global, not PAccount-scoped.
///
/// The Domain Model shows BUYERS carrying specializations too; brief_R scopes
/// this to providers, so only the provider join exists for now.
model Specialization {
  id         String             @id @default(uuid()) @db.Uuid
  catalog_id String             @db.Uuid
  name       String
  kind       SpecializationKind @default(PRODUCT)
  /// Display order within a kind; ties break on name.
  sort_order Int                @default(100)
  /// Added by a provider on the fly (brief_S / E031). Never retired by the seed.
  is_custom  Boolean            @default(false)
  created_at DateTime           @default(now())
  updated_at DateTime           @updatedAt

  catalog          ServiceCatalog                 @relation(fields: [catalog_id], references: [id], onDelete: Cascade)
  providerProfiles ProviderProfileSpecialization[]
  /// Projects delivered in this sector — only INDUSTRY-kind rows are ever
  /// linked (brief_project_model_v2).
  projectIndustries Project[]

  @@unique([catalog_id, name])
  @@map("specializations")
}

/// Grouping for the picker — the xlsx lists products, then methodologies, then
/// industries, and the step renders them in those groups.
enum SpecializationKind {
  PRODUCT
  METHODOLOGY
  INDUSTRY
}

/// Provider ↔ Specialization multi-select (brief_R).
model ProviderProfileSpecialization {
  id                  String   @id @default(uuid()) @db.Uuid
  provider_profile_id String   @db.Uuid
  specialization_id   String   @db.Uuid
  created_at          DateTime @default(now())

  providerProfile ProviderProfile @relation(fields: [provider_profile_id], references: [id], onDelete: Cascade)
  specialization  Specialization  @relation(fields: [specialization_id], references: [id], onDelete: Cascade)

  @@unique([provider_profile_id, specialization_id])
  @@index([specialization_id])
  @@map("provider_profile_specializations")
}

// ---------------------------------------------------------------------------
// Provider portfolio entities (brief_S / E037, per "Service Provider
// Categorization"): Projects → Solutions, Certifications, Employers.
//
// These are the provider's PROOF OF WORK, distinct from the taxonomy axes:
//   Role → Domain → Skill  = what they can do
//   Specializations        = which systems/processes/sectors they know
//   Projects/Certs/Employers = what they have actually done
// ---------------------------------------------------------------------------

/// A company the provider has worked for. First-class (rather than the free
/// text on WorkExperience) because the categorization diagram links Employers
/// to Certifications and Projects, and buyers filter on them.
model Employer {
  id                  String   @id @default(uuid()) @db.Uuid
  provider_profile_id String   @db.Uuid
  name                String
  /// Job title held there.
  role_title          String?
  location            String?
  start_date          DateTime?
  end_date            DateTime?
  /// True while this is the provider's current employer.
  is_current          Boolean  @default(false)
  description         String?
  /// Company logo (brief_U / E043). Suggested from the company name via a logo
  /// API, then ACCEPTED by the provider — never auto-applied, because name →
  /// company matching is fuzzy and a wrong logo on a profile looks worse than
  /// none. Null when unset or declined.
  logo_url            String?
  /// Ordering on the profile / capture step; lower first.
  sort_order          Int      @default(100)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  providerProfile ProviderProfile @relation(fields: [provider_profile_id], references: [id], onDelete: Cascade)
  projects        Project[]

  @@index([provider_profile_id])
  @@map("employers")
}

/// A delivered piece of work, done AT an employer.
///
/// The `Solution` child this used to carry is gone (brief_V / E045): what it
/// was reaching for is a PACKAGE — a productized offering the provider SELLS —
/// and that is a standalone catalog entity, not a sub-part of past work.
///
/// `employer_id` is retained and is how the capture step nests projects under
/// the job they belong to (brief_U). It stays nullable so a project imported
/// or entered before its employer exists isn't rejected.
/// How much of the client's identity a viewer may see (brief_project_model_v2).
///
/// Stored NOW, enforced LATER: `PLUS_ONLY` is the membership-gated tier and
/// behaves exactly like `PUBLIC` until the Plus brief ships, so nothing is
/// silently hidden by a tier that doesn't exist yet. `CONFIDENTIAL` is the one
/// that bites today — the client name is replaced by the code name and the
/// industry everywhere it renders.
enum ClientVisibility {
  PUBLIC
  PLUS_ONLY
  CONFIDENTIAL
}

/// Per-project validation state (brief_project_model_v2). "Validated", never
/// "verified" — the locked terminology (decisions-01, 2026-07-29).
///
/// Groundwork only in this brief: the field exists and always reads `NONE`.
/// The workflow that moves it to PENDING (email sent to `contact_email`) and
/// VALIDATED (contact confirmed) is the NEXT brief.
enum ProjectValidationStatus {
  NONE
  PENDING
  VALIDATED
}

/// A delivered piece of work, done AT an employer.
///
/// The `Solution` child this used to carry is gone (brief_V / E045): what it
/// was reaching for is a PACKAGE — a productized offering the provider SELLS —
/// and that is a standalone catalog entity, not a sub-part of past work.
///
/// `employer_id` is retained and is how the capture step nests projects under
/// the job they belong to (brief_U). It stays nullable so a project imported
/// or entered before its employer exists isn't rejected.
///
/// V2 (brief_project_model_v2) turns this from a name+blurb into the reporting
/// grain of the whole product. The classification fields are CATALOG-LINKED
/// rather than free text — `role_type_id` and the `ProjectApplication` join —
/// because "show me every Technical project that used Oracle Fusion" has to be
/// a query, and free text can never be charted.
model Project {
  id                  String   @id @default(uuid()) @db.Uuid
  provider_profile_id String   @db.Uuid
  employer_id         String?  @db.Uuid
  name                String
  description         String?
  /// Public link (case study, repo, published site) when there is one.
  url                 String?
  /// Cover image in the portfolio grid.
  image_url           String?
  start_date          DateTime?
  end_date            DateTime?
  /// True while the provider is still on this project; `end_date` is then null
  /// by design and the card renders "– Present". Mirrors `Employer.is_current`.
  is_current          Boolean  @default(false)

  // --- Classification (catalog-linked, for reporting) ----------------------
  /// What the provider DID here (Application-Specific / Technical / …).
  ///
  /// NULLABLE = "unclassified", deliberately. Classification is the reporting
  /// grain, so it is REQUIRED in the Add/Edit-Project modal and in the write
  /// path behind it (`projectData`). But a résumé importer cannot know the
  /// role, and defaulting it would write a value the provider never chose —
  /// silently poisoning the very charts this field exists to feed. A null is
  /// honest and queryable ("show me unclassified projects"), and the review
  /// page nudges the provider to fix it. Same reasoning as `employer_id`.
  role_type_id        String?  @db.Uuid
  /// The sector this was delivered in. Reuses the INDUSTRY slice of the
  /// Specialization vocabulary rather than a free-text column, so a
  /// confidential project can still say "Oil & Gas" in a chartable way.
  industry_specialization_id String? @db.Uuid

  // --- Client -------------------------------------------------------------
  /// REQUIRED. Held even when `client_visibility` hides it — the redaction is
  /// a RENDER decision, so the name stays available for the validation email
  /// and for Plus members once that ships.
  client_name         String
  client_visibility   ClientVisibility @default(PUBLIC)
  /// The project alias shown INSTEAD of the client when confidential.
  code_name           String?

  // --- Validation groundwork (workflow = next brief) ----------------------
  /// Who at the client can confirm this work happened.
  contact_email       String?
  validation_status   ProjectValidationStatus @default(NONE)

  // --- What you did -------------------------------------------------------
  /// The bullets, as a real list — not one blob to be split on render.
  highlights          String[]

  // --- Media --------------------------------------------------------------
  video_url           String?
  /// Supporting document in the PRIVATE `project-docs` bucket — an object
  /// path, not a URL, exactly like `Certification.attachment_path`. A statement
  /// of work carries client names and commercials; it is never public.
  document_path       String?
  document_name       String?
  /// Client/project logo, SUGGESTED from `client_name` and then accepted by the
  /// provider — never auto-applied (the E043 rule from Employer).
  logo_url            String?

  /// Ordering in the portfolio; lower first.
  sort_order          Int      @default(100)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  providerProfile ProviderProfile @relation(fields: [provider_profile_id], references: [id], onDelete: Cascade)
  employer        Employer?       @relation(fields: [employer_id], references: [id], onDelete: SetNull)
  roleType        RoleType?       @relation(fields: [role_type_id], references: [id], onDelete: SetNull)
  industry        Specialization? @relation(fields: [industry_specialization_id], references: [id], onDelete: SetNull)
  applications    ProjectApplication[]
  outcomes        ProjectOutcome[]

  @@index([provider_profile_id])
  @@index([employer_id])
  @@index([role_type_id])
  @@map("projects")
}

/// Join: a tool / application / technology used on a project.
///
/// Many-to-many against the SAME `Application` catalog the skill taxonomy uses,
/// so "which projects used this app" and "which skills touch this app" answer
/// from one vocabulary. Provider-added entries are `Application.is_custom`.
model ProjectApplication {
  id             String   @id @default(uuid()) @db.Uuid
  project_id     String   @db.Uuid
  application_id String   @db.Uuid
  created_at     DateTime @default(now())

  project     Project     @relation(fields: [project_id], references: [id], onDelete: Cascade)
  application Application @relation(fields: [application_id], references: [id], onDelete: Cascade)

  @@unique([project_id, application_id])
  @@index([application_id])
  @@map("project_applications")
}

/// A quantified result of a project — label + value, e.g. "Savings" / "$10M+".
///
/// Deliberately a CHILD ROW rather than a JSON blob or a formatted sentence:
/// the numbers are the part of a profile a buyer actually reads, and they are
/// the first thing reporting will want to aggregate.
model ProjectOutcome {
  id         String   @id @default(uuid()) @db.Uuid
  project_id String   @db.Uuid
  label      String
  value      String
  sort_order Int      @default(100)
  created_at DateTime @default(now())

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([project_id])
  @@map("project_outcomes")
}

/// A productized, a-la-carte offering the provider SELLS (brief_V / E045).
///
/// Standalone on the provider — their sellable catalog — deliberately NOT tied
/// to a past Project. A Project is proof of work already delivered; a Package
/// is something a buyer can buy today. Example: "Install DocuSign for Oracle
/// Cloud" — 5 weeks, $40,000, 50% upfront / 50% on completion.
///
/// Optional throughout: packages never gate publishing and carry no
/// completeness weight (brief_R/U invariant untouched).
model Package {
  id                  String   @id @default(uuid()) @db.Uuid
  provider_profile_id String   @db.Uuid
  title               String
  /// The scope — what the buyer is actually getting.
  summary             String?
  /// Timeline in weeks.
  duration_weeks      Int?
  /// V1 is FIXED-price only; the enum leaves room for HOURLY/TM later.
  pricing_type        PackagePricingType @default(FIXED)
  /// Integer cents, like every other money value in the app.
  price_cents         Int?
  currency            String   @default("USD")
  /// Optional categorization for the catalog and future Work Request matching.
  role_type_id        String?  @db.Uuid
  cover_image_url     String?
  status              PackageStatus @default(DRAFT)
  sort_order          Int      @default(100)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  providerProfile ProviderProfile      @relation(fields: [provider_profile_id], references: [id], onDelete: Cascade)
  roleType        RoleType?            @relation(fields: [role_type_id], references: [id], onDelete: SetNull)
  deliverables    PackageDeliverable[]
  milestones      PackageMilestone[]
  skills          PackageSkill[]

  @@index([provider_profile_id])
  @@index([role_type_id])
  @@map("packages")
}

enum PackagePricingType {
  FIXED
  /// Reserved — brief_V is fixed-price only.
  HOURLY
  TM
}

enum PackageStatus {
  DRAFT
  PUBLISHED
}

/// One line of "what you get". A child row rather than String[] so the order is
/// explicit and each line can grow (e.g. a note) without a migration.
model PackageDeliverable {
  id         String   @id @default(uuid()) @db.Uuid
  package_id String   @db.Uuid
  text       String
  sequence   Int      @default(0)
  created_at DateTime @default(now())

  pkg Package @relation(fields: [package_id], references: [id], onDelete: Cascade)

  @@index([package_id])
  @@map("package_deliverables")
}

/// A payment term: "50% Upfront", "50% On completion".
///
/// Percent OF THE TOTAL rather than an amount, so editing the price can never
/// leave the milestones summing to something other than the package price. The
/// writer validates the percents sum to exactly 100.
model PackageMilestone {
  id         String   @id @default(uuid()) @db.Uuid
  package_id String   @db.Uuid
  label      String
  percent    Int
  sequence   Int      @default(0)
  created_at DateTime @default(now())

  pkg Package @relation(fields: [package_id], references: [id], onDelete: Cascade)

  @@index([package_id])
  @@map("package_milestones")
}

/// Skill tags on a package — categorization for the catalog and future matching.
model PackageSkill {
  id         String   @id @default(uuid()) @db.Uuid
  package_id String   @db.Uuid
  skill_id   String   @db.Uuid
  created_at DateTime @default(now())

  pkg   Package @relation(fields: [package_id], references: [id], onDelete: Cascade)
  skill Skill   @relation(fields: [skill_id], references: [id], onDelete: Cascade)

  @@unique([package_id, skill_id])
  @@index([skill_id])
  @@map("package_skills")
}

model ProviderSkill {
  id                  String   @id @default(uuid()) @db.Uuid
  provider_profile_id String   @db.Uuid
  skill_id            String   @db.Uuid
  created_at          DateTime @default(now())

  providerProfile ProviderProfile @relation(fields: [provider_profile_id], references: [id], onDelete: Cascade)
  skill           Skill           @relation(fields: [skill_id], references: [id], onDelete: Cascade)

  @@unique([provider_profile_id, skill_id])
  @@index([skill_id])
  @@map("provider_skills")
}

/// A past employment on a provider's profile, with its notable projects.
/// A notable project under a WorkExperience.
/// An education entry on a provider's profile.
model Education {
  id                  String   @id @default(uuid()) @db.Uuid
  provider_profile_id String   @db.Uuid
  institution         String
  degree              String?
  field               String?
  /// Legacy single year (brief_E). Superseded by start_year/end_year
  /// (brief_P / E015, "Dates Attended"); kept so existing rows still read.
  year                Int?
  start_year          Int?
  end_year            Int?
  description         String?
  created_at          DateTime @default(now())

  providerProfile ProviderProfile @relation(fields: [provider_profile_id], references: [id], onDelete: Cascade)

  @@index([provider_profile_id])
  @@map("education")
}

/// A language a provider speaks.
model Language {
  id                  String   @id @default(uuid()) @db.Uuid
  provider_profile_id String   @db.Uuid
  name                String
  /// Free-text legacy column (brief_E). `level` is the canonical value now
  /// (brief_P / E016); this stays readable for rows written before the enum.
  proficiency         String?
  level               LanguageProficiency?
  created_at          DateTime @default(now())

  providerProfile ProviderProfile @relation(fields: [provider_profile_id], references: [id], onDelete: Cascade)

  @@index([provider_profile_id])
  @@map("languages")
}

/// A professional certification on a provider's profile.
/// A credential the provider holds. Pre-dates brief_S; E037 promotes it to a
/// displayed portfolio entity and links it to the Employer it was earned at
/// (the categorization diagram's Employer → Certification edge).
/// A credential the provider holds.
///
/// STANDALONE (brief_U / E044, correcting brief_S): a certification belongs to
/// the CERTIFYING AGENCY that issued it, not to an employer the provider
/// happened to work for when they earned it. The employer link and the
/// carry-it-forward-by-name logic that came with it are gone.
model Certification {
  id                  String   @id @default(uuid()) @db.Uuid
  provider_profile_id String   @db.Uuid
  name                String
  /// The certifying agency / issuing body (e.g. "Oracle", "PMI").
  issuer              String?
  /// Legacy year-only field; superseded by `issued_on`, kept so pre-brief_U
  /// rows still read.
  year                Int?
  issued_on           DateTime?
  /// Credential number / badge id, and a public verification link.
  credential_id       String?
  url                 String?
  expires_on          DateTime?
  /// Scanned certificate in the private `certifications` bucket — an object
  /// path, not a URL, since the bucket is private (same rule as résumés).
  attachment_path     String?
  attachment_name     String?
  notes               String?
  created_at          DateTime @default(now())

  providerProfile ProviderProfile @relation(fields: [provider_profile_id], references: [id], onDelete: Cascade)

  @@index([provider_profile_id])
  @@map("certifications")
}

/// A buyer's marketplace profile (1:1 with a Person that is a service buyer).
/// Photo/location live on Person/Address; billing is stubbed (out of scope).
/// SMS phone-verification challenge (brief_P / E019). Mirrors the
/// VerificationToken pattern from brief_E: we store only a SHA-256 HASH of the
/// 6-digit code, never the code itself. Issuing a new code invalidates prior
/// unconsumed ones for the same Person.
model PhoneVerification {
  id         String    @id @default(uuid()) @db.Uuid
  person_id  String    @db.Uuid
  /// E.164 number the code was sent to. Kept so a code can't be replayed
  /// against a different number after the user edits the field.
  phone      String
  code_hash  String
  expires_at DateTime
  consumed_at DateTime?
  /// Wrong-code submissions; the challenge dies at the cap (anti-brute-force).
  attempts   Int       @default(0)
  created_at DateTime  @default(now())

  person Person @relation(fields: [person_id], references: [id], onDelete: Cascade)

  @@index([person_id])
  @@map("phone_verifications")
}

/// One résumé / LinkedIn-PDF import attempt (brief_P / E012).
///
/// `gaps` is what the review page surfaces (E019): fields we could not decipher
/// or had to strip. Keeping the attempt (and its extracted text) means a parse
/// can be re-run or audited without asking the user to upload again.
model ProfileImport {
  id                  String              @id @default(uuid()) @db.Uuid
  provider_profile_id String              @db.Uuid
  source              ProfileImportSource
  status              ProfileImportStatus @default(PENDING)
  file_name           String?
  mime_type           String?
  size_bytes          Int?
  /// Object path in the PRIVATE `resumes` bucket (brief_Q). Not a URL — the
  /// bucket is private because a résumé carries address/phone/employment data;
  /// reads go through a short-lived signed URL. Null when the upload failed,
  /// which never blocks an import whose parse succeeded.
  storage_path        String?
  /// Plain text extracted from the document, for re-parsing / debugging.
  raw_text            String?
  /// Structured result of the parse: what landed, and what didn't.
  parsed              Json?
  /// Human-readable list of import gaps shown on the review page.
  gaps                Json?
  error               String?
  created_at          DateTime            @default(now())
  updated_at          DateTime            @updatedAt

  providerProfile ProviderProfile @relation(fields: [provider_profile_id], references: [id], onDelete: Cascade)

  @@index([provider_profile_id])
  @@map("profile_imports")
}

model BuyerProfile {
  id                String            @id @default(uuid()) @db.Uuid
  person_id         String            @unique @db.Uuid
  subscription_tier SubscriptionTier  @default(BASIC)
  /// Set when the buyer starts a Business Plus trial (brief_G). No billing yet.
  trial_started_at  DateTime?
  created_at        DateTime          @default(now())
  updated_at        DateTime          @updatedAt

  person Person @relation(fields: [person_id], references: [id], onDelete: Cascade)

  @@map("buyer_profiles")
}

enum SubscriptionTier {
  BASIC
  BUSINESS_PLUS
}

// ---------------------------------------------------------------------------
// Coordinator → provider invites (brief_I)
//
// A Service Coordinator invites a provider by email; a tokenized link (stored
// HASH-ONLY, like VerificationToken) lets the invitee accept. On acceptance the
// provider's ProviderProfile.coordinator_person_id is set to the inviter. The
// coordinator↔provider relationship is a nullable FK (one coordinator per
// provider for V1, matching the singular selling_agent in the Work Data File).
// ---------------------------------------------------------------------------

model CoordinatorInvite {
  id                 String                  @id @default(uuid()) @db.Uuid
  inviter_person_id  String                  @db.Uuid
  invitee_email      String
  invitee_first_name String?
  invitee_last_name  String?
  message            String?
  /// SHA-256 of the raw token; the raw token lives only in the emailed link.
  token_hash         String                  @unique
  status             CoordinatorInviteStatus @default(PENDING)
  expires_at         DateTime
  /// The ProviderProfile that accepted (record-keeping; not a FK relation).
  accepted_provider_id String?               @db.Uuid
  created_at         DateTime                @default(now())
  updated_at         DateTime                @updatedAt

  inviter Person @relation("CoordinatorInvitesSent", fields: [inviter_person_id], references: [id], onDelete: Cascade)

  @@index([inviter_person_id])
  @@index([invitee_email])
  @@map("coordinator_invites")
}

enum CoordinatorInviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

// ---------------------------------------------------------------------------
// Work Requests (brief_L) — a Service Buyer's titled, scoped request for a
// service, targeting the catalog taxonomy (RoleType + Skills).
//
//   Buyer (Person is_service_buyer) → WorkRequest (DRAFT → POSTED) → skills
//
// DRAFT is private, fenced by p_account_id (scopedToPAccount). POSTED is the
// finish line for this brief — a marketplace surface with NO provider-facing UI
// yet (browse/apply is a later brief). Money is stored in integer cents.
//
// Step-collected fields (role_type_id, experience_level, budget_type, worksite,
// duration, …) are NULLABLE so a DRAFT can be built save-as-you-go; `title`
// defaults to "" for the same reason. Post enforces the required subset.
// ---------------------------------------------------------------------------

model WorkRequest {
  id                  String   @id @default(uuid()) @db.Uuid
  buyer_person_id     String   @db.Uuid
  p_account_id        String   @db.Uuid
  role_type_id        String?  @db.Uuid
  region_id           String?  @db.Uuid
  title               String   @default("")
  description         String?
  experience_level    ExperienceLevel?
  budget_type         BudgetType?
  budget_amount_cents Int?
  currency            String   @default("USD")
  worksite            WorksiteType?
  location_country    String?
  duration            WorkRequestDuration?
  status              WorkRequestStatus @default(DRAFT)
  posted_at           DateTime?
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  buyer    Person    @relation(fields: [buyer_person_id], references: [id], onDelete: Cascade)
  pAccount PAccount  @relation(fields: [p_account_id], references: [id], onDelete: Cascade)
  roleType RoleType? @relation(fields: [role_type_id], references: [id], onDelete: SetNull)
  region   Region?   @relation(fields: [region_id], references: [id], onDelete: SetNull)
  skills   WorkRequestSkill[]

  @@index([p_account_id])
  @@index([buyer_person_id])
  @@index([status])
  @@map("work_requests")
}

/// Join: a taxonomy Skill targeted by a WorkRequest (mirrors ProviderSkill).
/// Skills must share the request's role_type_id (enforced on write).
model WorkRequestSkill {
  id              String   @id @default(uuid()) @db.Uuid
  work_request_id String   @db.Uuid
  skill_id        String   @db.Uuid
  created_at      DateTime @default(now())

  workRequest WorkRequest @relation(fields: [work_request_id], references: [id], onDelete: Cascade)
  skill       Skill       @relation(fields: [skill_id], references: [id], onDelete: Cascade)

  @@unique([work_request_id, skill_id])
  @@index([skill_id])
  @@map("work_request_skills")
}

enum BudgetType {
  FIXED
  HOURLY
}

enum WorksiteType {
  REMOTE
  ONSITE
  HYBRID
}

enum WorkRequestDuration {
  LT_1_MONTH
  ONE_TO_3_MONTHS
  THREE_TO_6_MONTHS
  GT_6_MONTHS
}

enum WorkRequestStatus {
  DRAFT
  POSTED
}
