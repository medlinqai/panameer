  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "noEmit": false,
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "prisma/migrate-work-history.ts",
    "prisma/normalize-emails.ts",
    "prisma/seed-taxonomy.ts",
