{
  "name": "panameer-digital-services",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "prisma generate && next build",
    "seed": "ts-node --project tsconfig.seed.json prisma/seed.ts",
    "start": "next start -p 3100",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "db:push": "prisma db push",
    "db:email-guard": "ts-node --project tsconfig.seed.json prisma/normalize-emails.ts",
    "storage:setup": "ts-node --project tsconfig.seed.json prisma/setup-storage.ts",
    "postinstall": "prisma generate",
    "db:migrate-work-history": "ts-node --project tsconfig.seed.json prisma/migrate-work-history.ts",
    "check:resume": "npx esbuild src/lib/resume/check-fixtures.ts --bundle --platform=node --format=cjs --packages=external --outfile=.harness/check-resume.cjs --log-level=error && node .harness/check-resume.cjs",
    "seed:learn": "ts-node --project tsconfig.seed.json prisma/seed-learn-run.ts",
    "seed:learn-experts": "ts-node --project tsconfig.seed.json prisma/seed-learn-experts.ts",
    "learn:export-catalog": "ts-node --project tsconfig.seed.json prisma/export-learn-catalog.ts",
    "learn:thumbnails": "ts-node --project tsconfig.seed.json prisma/apply-learn-thumbnails.ts",
    "check:sections": "npx esbuild src/lib/section-schemas.test.ts --bundle --platform=node --format=cjs --packages=external --outfile=.harness/sections.cjs --log-level=error && node .harness/sections.cjs",
    "check:ai-extract": "npx esbuild src/lib/resume/ai-extract.test.ts --bundle --platform=node --format=cjs --packages=external --outfile=.harness/ai.cjs --log-level=error && node .harness/ai.cjs",
    "check:ai-fixtures": "npx esbuild src/lib/resume/check-ai-fixtures.ts --bundle --platform=node --format=cjs --packages=external --outfile=.harness/aifix.cjs --log-level=error && node -r dotenv/config .harness/aifix.cjs dotenv_config_path=.env.local"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@supabase/storage-js": "^2.110.8",
    "@supabase/supabase-js": "^2.110.8",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "mammoth": "^1.12.0",
    "next": "16.2.11",
    "next-auth": "^4.24.15",
    "pdf-parse": "^2.4.5",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "jszip": "^3.10.1",
    "prisma": "^7.9.0",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
