# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# scratch: assets staged for deletion, never part of the app
_to_delete/

# Résumé parser fixtures — REAL PEOPLE'S CVs. Never committed; the test harness
# reads whatever is present locally and skips-with-note what isn't.
src/lib/resume/__fixtures__/
.harness/

# Source spreadsheets for the seed generators. The GENERATED json in
# prisma/seed-data/ is what's committed — same rule as Service Catalog.xlsx.
# (Video Catalog.xlsx alone is 23 MB; that does not belong in git history.)
scripts/data/*.xlsx

# Derived from the real (gitignored) résumé fixtures — same reason they are.
src/lib/resume/__fixtures__/expected-parses.json

# Playwright output. Screenshots and traces are FAILURE EVIDENCE, written only
# when `check:ui` goes red — useful for the next ten minutes, never a record.
# Committing them would turn a behaviour gate into a screenshot library, which
# WS-3 of brief_check_ui_harness explicitly rules out.
test-results/
playwright-report/
e2e/.artifacts/
e2e-shell/.artifacts/
# E715 — paired screenshot gate: the harness is tracked, its output is not.
e2e-e715/.artifacts/
e2e-tracker/.artifacts/
e2e-support/.artifacts/
e2e-e715/shots/
# E716 — the door proof: the harness is tracked; its shots and the recorded
# before-href are run artifacts. A committed before-href would let a later
# `after` run compare against a stale measurement.
e2e-e716/.artifacts/
e2e-e716/shots/
e2e-e716/before-href.json
# E717 — band census: the harness is tracked, its shots and the recorded
# before-census are run artifacts.
e2e-e717/.artifacts/
e2e-e717/shots/
e2e-e717/census-before.json
# E718 — the mobile walk: harness tracked, shots are run artifacts.
e2e-e718/.artifacts/
e2e-e718/shots/
# E719 — hire gate: harness tracked, shots are run artifacts.
e2e-e719/.artifacts/
e2e-e719/shots/

# ⚠ P1-ALL-E371 WS-A2 — captured mail. NOTHING captured goes in the repo.
.mail-capture/

# ⚠ The seeded connection graph's manifest — DB row ids, so it is per-database
# state, not source. `npm run wipe:connection-graph` rebuilds the same target set
# from `prisma/connection-graph-spec.ts` when it is absent.
prisma/seed-data/connection-graph-manifest.json
# E720 — the profile leftovers: harness tracked, shots are run artifacts.
e2e-e720/.artifacts/
e2e-e720/shots/
# E721 — colleagues search, the store-only upload and the mentor gate: harness
# tracked, shots and the recorded fingerprints are run artifacts. ⚠ The
# fingerprints are a BEFORE/AFTER measurement of one machine's model reads; a
# committed one would be read as an expected value, and the reader is not
# deterministic (E410).
e2e-e721/.artifacts/
e2e-e721/shots/
# E722 — the section counts: harness tracked, shots are run artifacts.
e2e-e722/.artifacts/
e2e-e722/shots/
# E723 — dark mode, the ink-3 token, the Search Score sketch and languages:
# harness tracked, shots are run artifacts.
e2e-e723/.artifacts/
e2e-e723/shots/

# E730 — the Usage page: the harness is tracked, its shots and artefacts are run
# output. Same rule as E715-E723 above.
e2e-e730/shots/
e2e-e730/.artifacts/

# E736 — notifications + worklist: harness tracked, shots are run artifacts.
e2e-e736/shots/
e2e-e736/.artifacts/
e2e-e738/.artifacts/
e2e-e739/.artifacts/

# Local-only playwright configs and admin run shots.
.pw-*.config.ts
e2e-admin/.artifacts/
